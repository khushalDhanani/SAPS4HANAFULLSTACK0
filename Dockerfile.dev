# ==============================================================================
# Development Dockerfile with Live Reload for SAP S/4HANA Full-Stack Platform
# ==============================================================================
FROM node:22-bookworm-slim

WORKDIR /app

# Install dumb-init and curl
RUN apt-get update \
    && apt-get install -y --no-install-recommends dumb-init curl \
    && rm -rf /var/lib/apt/lists/*

# Install root dependencies including dev tooling (@sap/cds-dk, cds-plugin-ui5)
COPY package*.json ./
RUN npm install

# Copy UI5 dependencies and install
COPY app/fiori-app/package*.json ./app/fiori-app/
RUN cd app/fiori-app && npm install

# Copy remaining source code
COPY . .

ENV NODE_ENV=development \
    PORT=4004

EXPOSE 4004

ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Run in watch mode excluding runtime data directory
CMD ["npm", "run", "watch"]
