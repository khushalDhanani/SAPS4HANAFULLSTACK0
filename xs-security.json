{
  "xsappname": "SAPS4HANAFULLSTACK",
  "tenant-mode": "dedicated",
  "description": "Security profile for SAP S/4HANA Full-Stack Fiori and CAP application",
  "scopes": [
    {
      "name": "$XSAPPNAME.Viewer",
      "description": "View Purchase Orders and Analytics"
    },
    {
      "name": "$XSAPPNAME.PurchasingManager",
      "description": "Create and Manage Purchase Orders"
    },
    {
      "name": "$XSAPPNAME.User",
      "description": "Standard User Access to Purchase Order Application"
    },
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Administrator Access to Purchase Order Application"
    }
  ],
  "attributes": [],
  "role-templates": [
    {
      "name": "Viewer",
      "description": "View Purchase Orders and Analytics",
      "scope-references": [
        "$XSAPPNAME.Viewer",
        "$XSAPPNAME.User"
      ]
    },
    {
      "name": "PurchasingManager",
      "description": "Create and Manage Purchase Orders",
      "scope-references": [
        "$XSAPPNAME.PurchasingManager",
        "$XSAPPNAME.Admin",
        "$XSAPPNAME.User"
      ]
    }
  ],
  "oauth2-configuration": {
    "credential-types": [
      "binding-secret",
      "x509"
    ]
  }
}
