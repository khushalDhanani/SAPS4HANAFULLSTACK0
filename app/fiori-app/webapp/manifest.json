{
  "_version": "2.0.0",
  "sap.app": {
    "id": "saps4hana.fiori",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/purchase-order/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "fiService": {
        "uri": "/odata/v4/journal-entry/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "salesInquiryService": {
        "uri": "/odata/v4/sales-inquiry/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "salesOrderService": {
        "uri": "/odata/v4/sales-order/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "goodsIssueService": {
        "uri": "/odata/v4/goods-issue/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "goodsReceiptService": {
        "uri": "/odata/v4/goods-receipt/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "outboundDeliveryService": {
        "uri": "/odata/v4/outbound-delivery/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "customerInvoiceService": {
        "uri": "/odata/v4/customer-invoice/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "customerReturnService": {
        "uri": "/odata/v4/customer-return/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "trToService": {
        "uri": "/odata/v4/tr-to/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "saps4hana.fiori.view.App",
      "type": "XML",
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.ui.comp": {},
        "sap.f": {},
        "sap.uxap": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "saps4hana.fiori.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "fiService": {
        "dataSource": "fiService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "salesInquiry": {
        "dataSource": "salesInquiryService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "salesOrder": {
        "dataSource": "salesOrderService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "goodsIssue": {
        "dataSource": "goodsIssueService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "goodsReceipt": {
        "dataSource": "goodsReceiptService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "outboundDelivery": {
        "dataSource": "outboundDeliveryService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "customerInvoice": {
        "dataSource": "customerInvoiceService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "customerReturn": {
        "dataSource": "customerReturnService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "trTo": {
        "dataSource": "trToService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "type": "View",
        "path": "saps4hana.fiori.view",
        "controlId": "app",
        "controlAggregation": "pages"
      },
      "routes": [
        {
          "name": "default",
          "pattern": "",
          "target": "TargetDashboard"
        },
        {
          "name": "login",
          "pattern": "login",
          "target": "TargetLogin"
        },
        {
          "name": "dashboard",
          "pattern": "dashboard",
          "target": "TargetDashboard"
        },
        {
          "name": "purchaseOrders",
          "pattern": "mm/purchase-orders",
          "target": "TargetPurchaseOrders"
        },
        {
          "name": "createPurchaseOrder",
          "pattern": "mm/purchase-orders/create",
          "target": "TargetCreatePurchaseOrder"
        },
        {
          "name": "purchaseOrderDetail",
          "pattern": "mm/purchase-orders/{PurchaseOrder}",
          "target": "TargetPurchaseOrderDetail"
        },
        {
          "name": "journalEntries",
          "pattern": "fi/journal-entries",
          "target": "TargetJournalEntries"
        },
        {
          "name": "salesInquiries",
          "pattern": "sd/sales-inquiries",
          "target": "TargetSalesInquiries"
        },
        {
          "name": "createSalesInquiry",
          "pattern": "sd/sales-inquiries/create",
          "target": "TargetCreateSalesInquiry"
        },
        {
          "name": "salesInquiryDetail",
          "pattern": "sd/sales-inquiries/{SalesInquiry}",
          "target": "TargetSalesInquiryDetail"
        },
        {
          "name": "salesOrders",
          "pattern": "sd/sales-orders",
          "target": "TargetSalesOrders"
        },
        {
          "name": "createSalesOrder",
          "pattern": "sd/sales-orders/create",
          "target": "TargetCreateSalesOrder"
        },
        {
          "name": "wmGoodsIssue201Pending",
          "pattern": "wm/goods-issue/201/open-reservations:?query:",
          "target": "TargetGoodsIssue201Pending"
        },
        {
          "name": "wmGoodsIssue201",
          "pattern": "wm/goods-issue/cost-center-201:?query:",
          "target": "TargetGoodsIssue201"
        },
        {
          "name": "wmGoodsIssue301Pending",
          "pattern": "wm/goods-issue/301/open-transfers:?query:",
          "target": "TargetGoodsIssue301Pending"
        },
        {
          "name": "wmGoodsIssue301",
          "pattern": "wm/goods-issue/plant-transfer-301:?query:",
          "target": "TargetGoodsIssue301"
        },
        {
          "name": "wmGoodsIssue311Pending",
          "pattern": "wm/goods-issue/311/open-transfers:?query:",
          "target": "TargetGoodsIssue311Pending"
        },
        {
          "name": "wmGoodsIssue311",
          "pattern": "wm/goods-issue/sloc-transfer-311:?query:",
          "target": "TargetGoodsIssue311"
        },
        {
          "name": "wmGoodsReceipt",
          "pattern": "wm/goods-receipt",
          "target": "TargetGoodsReceipt"
        },
        {
          "name": "wmGoodsReceiptDetail",
          "pattern": "wm/goods-receipt/{delivery}",
          "target": "TargetGoodsReceipt"
        },
        {
          "name": "ordersDueForDelivery",
          "pattern": "le/orders-due",
          "target": "TargetOrdersDueForDelivery"
        },
        {
          "name": "customerInvoices",
          "pattern": "sd/invoices",
          "target": "TargetCustomerInvoices"
        },
        {
          "name": "customerReturns",
          "pattern": "sd/returns",
          "target": "TargetCustomerReturns"
        },
        {
          "name": "createCustomerReturn",
          "pattern": "sd/returns/create",
          "target": "TargetCreateCustomerReturn"
        },
        {
          "name": "wmTrTo",
          "pattern": "wm/tr-to",
          "target": "TargetTrTo"
        },
        {
          "name": "wmCycle261",
          "pattern": "wm/mvt261/open/{reservation}/{item}/cycle",
          "target": "TargetCycle261"
        },
        {
          "name": "wmScan261",
          "pattern": "wm/mvt261/open/{reservation}/{item}",
          "target": "TargetScan261"
        },
        {
          "name": "wmOpen261",
          "pattern": "wm/mvt261/open",
          "target": "TargetOpen261"
        },
        {
          "name": "wmMvt261",
          "pattern": "wm/mvt261",
          "target": "TargetMvt261"
        },
        {
          "name": "wmHandlingUnitDetail",
          "pattern": "wm/handling-unit/{hu}:?query:",
          "target": "TargetHandlingUnitDetail"
        },
        {
          "name": "wmHandlingUnits",
          "pattern": "wm/handling-unit",
          "target": "TargetHandlingUnits"
        },
        {
          "name": "wmPackingInstructionDetail",
          "pattern": "wm/packing-instruction/{systemUUID}",
          "target": "TargetPackingInstructionDetail"
        },
        {
          "name": "wmPackingInstructions",
          "pattern": "wm/packing-instruction",
          "target": "TargetPackingInstructions"
        }
      ],
