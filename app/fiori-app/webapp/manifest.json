        },
        "TargetCustomerReturns": {
          "id": "customerReturns",
          "name": "CustomerReturns",
          "path": "saps4hana.fiori.modules.sd.customer-return.view"
        },
        "TargetCreateCustomerReturn": {
          "id": "createCustomerReturn",
          "name": "CreateCustomerReturn",
          "path": "saps4hana.fiori.modules.sd.customer-return.view"
        },
        "TargetTrTo": {
          "id": "trTo",
          "name": "TrTo",
          "path": "saps4hana.fiori.modules.wm.tr-to.view"
        },
        "TargetScan261": {
