{
  "_version": "2.0.0",
  "sap.app": {
    "id": "saps4hana.fiori",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": ["", "en"],
      "fallbackLocale": "en"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/purchase-order/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "salesInquiryService": {
        "uri": "/odata/v4/sales-inquiry/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "salesOrderService": {
        "uri": "/odata/v4/sales-order/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "goodsReceiptService": {
        "uri": "/odata/v4/goods-receipt/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "outboundDeliveryService": {
        "uri": "/odata/v4/outbound-delivery/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "customerInvoiceService": {
        "uri": "/odata/v4/customer-invoice/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "customerReturnService": {
        "uri": "/odata/v4/customer-return/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "saps4hana.fiori.view.App",
      "type": "XML",
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.ui.comp": {},
        "sap.f": {},
        "sap.tnt": {},
        "sap.uxap": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "saps4hana.fiori.i18n.i18n",
          "supportedLocales": ["", "en"],
          "fallbackLocale": "en"
        }
      },
      "": {
        "dataSource": "mainService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "salesInquiry": {
        "dataSource": "salesInquiryService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "salesOrder": {
        "dataSource": "salesOrderService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "goodsReceipt": {
        "dataSource": "goodsReceiptService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "outboundDelivery": {
        "dataSource": "outboundDeliveryService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "customerInvoice": {
        "dataSource": "customerInvoiceService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "customerReturn": {
        "dataSource": "customerReturnService",
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "type": "View",
        "path": "saps4hana.fiori.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "bypassed": {
          "target": "TargetDashboard"
        }
      },
      "routes": [
        {
          "name": "default",
          "pattern": "",
          "target": "TargetDashboard"
        },
        {
          "name": "login",
          "pattern": "login",
          "target": "TargetLogin"
        },
        {
          "name": "dashboard",
          "pattern": "dashboard/:section::?query:",
          "target": "TargetDashboard"
        },
        {
          "name": "purchaseOrders",
          "pattern": "mm/purchase-orders",
          "target": "TargetPurchaseOrders"
        },
        {
          "name": "createPurchaseOrder",
          "pattern": "mm/purchase-orders/create",
          "target": "TargetCreatePurchaseOrder"
        },
        {
          "name": "purchaseOrderDetail",
          "pattern": "mm/purchase-orders/{PurchaseOrder}",
          "target": "TargetPurchaseOrderDetail"
        },
        {
          "name": "salesInquiries",
          "pattern": "sd/sales-inquiries",
          "target": "TargetSalesInquiries"
        },
        {
          "name": "createSalesInquiry",
          "pattern": "sd/sales-inquiries/create",
          "target": "TargetCreateSalesInquiry"
        },
        {
          "name": "salesInquiryDetail",
          "pattern": "sd/sales-inquiries/{SalesInquiry}",
          "target": "TargetSalesInquiryDetail"
        },
        {
          "name": "salesOrders",
          "pattern": "sd/sales-orders",
          "target": "TargetSalesOrders"
        },
        {
          "name": "createSalesOrder",
          "pattern": "sd/sales-orders/create",
          "target": "TargetCreateSalesOrder"
        },

        {
          "name": "wmGoodsReceipt",
          "pattern": "wm/goods-receipt",
          "target": "TargetGoodsReceipt"
        },
        {
          "name": "wmGoodsReceiptDetail",
          "pattern": "wm/goods-receipt/{delivery}",
          "target": "TargetGoodsReceipt"
        },
        {
          "name": "ordersDueForDelivery",
          "pattern": "le/orders-due",
          "target": "TargetOrdersDueForDelivery"
        },
        {
          "name": "customerInvoices",
          "pattern": "sd/invoices",
          "target": "TargetCustomerInvoices"
        },
        {
          "name": "customerReturns",
          "pattern": "sd/returns",
          "target": "TargetCustomerReturns"
        },
        {
          "name": "createCustomerReturn",
          "pattern": "sd/returns/create",
          "target": "TargetCreateCustomerReturn"

        },
        {
          "name": "wmHandlingUnitDetail",
          "pattern": "wm/handling-unit/{hu}:?query:",
          "target": "TargetHandlingUnitDetail"
        },
        {
          "name": "wmHandlingUnits",
          "pattern": "wm/handling-unit",
          "target": "TargetHandlingUnits"
        },
        {
          "name": "wmPackingInstructionDetail",
          "pattern": "wm/packing-instruction/{systemUUID}",
          "target": "TargetPackingInstructionDetail"
        },
        {
          "name": "wmPackingInstructions",
          "pattern": "wm/packing-instruction",
          "target": "TargetPackingInstructions"
        },
        {
          "name": "wmQuarantineLabels",
          "pattern": "wm/quarantine-labels",
          "target": "TargetQuarantineLabels"
        },
        {
          "name": "wmMibLabel",
          "pattern": "wm/mib-label",
          "target": "TargetMibLabel"
        },
        {
          "name": "wmHuStockTransfer",
          "pattern": "wm/hu-stock-transfer",
          "target": "TargetHuStockTransferList"
        },
        {
          "name": "wmHuStockTransferRack",
          "pattern": "wm/hu-stock-transfer/{reservation}/{item}/rack",
          "target": "TargetHuStockTransferRack"
        },
        {
          "name": "wmHuStockTransferDetail",
          "pattern": "wm/hu-stock-transfer/{reservation}/{item}",
          "target": "TargetHuStockTransferDetail"
        }
      ],
      "targets": {
        "TargetLogin": {
          "id": "login",
          "name": "Login"
        },
        "TargetDashboard": {
          "id": "dashboard",
          "name": "Dashboard"
        },
        "TargetPurchaseOrders": {
          "id": "purchaseOrders",
          "name": "PurchaseOrders",
          "path": "saps4hana.fiori.modules.mm.purchase-order.view"
        },
        "TargetPurchaseOrderDetail": {
          "id": "purchaseOrderDetail",
          "name": "PurchaseOrderDetail",
          "path": "saps4hana.fiori.modules.mm.purchase-order.view"
        },
        "TargetCreatePurchaseOrder": {
          "id": "createPurchaseOrder",
          "name": "CreatePurchaseOrder",
          "path": "saps4hana.fiori.modules.mm.purchase-order.view"
        },
        "TargetSalesInquiries": {
          "id": "salesInquiries",
          "name": "SalesInquiries",
          "path": "saps4hana.fiori.modules.sd.sales-inquiry.view"
        },
        "TargetCreateSalesInquiry": {
          "id": "createSalesInquiry",
          "name": "CreateSalesInquiry",
          "path": "saps4hana.fiori.modules.sd.sales-inquiry.view"
        },
        "TargetSalesInquiryDetail": {
          "id": "salesInquiryDetail",
          "name": "SalesInquiryDetail",
          "path": "saps4hana.fiori.modules.sd.sales-inquiry.view"
        },
        "TargetSalesOrders": {
          "id": "salesOrders",
          "name": "SalesOrders",
          "path": "saps4hana.fiori.modules.sd.sales-order.view"
        },
        "TargetCreateSalesOrder": {
          "id": "createSalesOrder",
          "name": "CreateSalesOrder",
          "path": "saps4hana.fiori.modules.sd.sales-order.view"
        },

        "TargetGoodsReceipt": {
          "id": "goodsReceipt",
          "name": "GoodsReceipt",
          "path": "saps4hana.fiori.modules.wm.goods-receipt.view"
        },
        "TargetOrdersDueForDelivery": {
          "id": "ordersDueForDelivery",
          "name": "OrdersDueForDelivery",
          "path": "saps4hana.fiori.modules.le.outbound-delivery.view"
        },
        "TargetCustomerInvoices": {
          "id": "customerInvoices",
          "name": "CustomerInvoices",
          "path": "saps4hana.fiori.modules.sd.customer-invoice.view"
        },
        "TargetCustomerReturns": {
          "id": "customerReturns",
          "name": "CustomerReturns",
          "path": "saps4hana.fiori.modules.sd.customer-return.view"
        },
        "TargetCreateCustomerReturn": {
          "id": "createCustomerReturn",
          "name": "CreateCustomerReturn",
          "path": "saps4hana.fiori.modules.sd.customer-return.view"

        },
        "TargetHandlingUnits": {
          "id": "handlingUnits",
          "name": "HandlingUnits",
          "path": "saps4hana.fiori.modules.wm.handling-unit.view"
        },
        "TargetHandlingUnitDetail": {
          "id": "handlingUnitDetail",
          "name": "HandlingUnitDetail",
          "path": "saps4hana.fiori.modules.wm.handling-unit.view"
        },
        "TargetPackingInstructions": {
          "id": "packingInstructions",
          "name": "PackingInstructions",
          "path": "saps4hana.fiori.modules.wm.packing-instruction.view"
        },
        "TargetQuarantineLabels": {
          "id": "quarantineLabels",
          "name": "QuarantineLabels",
          "path": "saps4hana.fiori.modules.wm.quarantine-label.view"
        },
        "TargetMibLabel": {
          "id": "mibLabel",
          "name": "MibLabel",
          "path": "saps4hana.fiori.modules.wm.mib-label.view"
        },
        "TargetPackingInstructionDetail": {
          "id": "packingInstructionDetail",
          "name": "PackingInstructionDetail",
          "path": "saps4hana.fiori.modules.wm.packing-instruction.view"
        },
        "TargetHuStockTransferList": {
          "id": "huStockTransferList",
          "name": "HuStockTransferList",
          "path": "saps4hana.fiori.modules.wm.hu-stock-transfer.view"
        },
        "TargetHuStockTransferRack": {
          "id": "huStockTransferRack",
          "name": "HuStockTransferRack",
          "path": "saps4hana.fiori.modules.wm.hu-stock-transfer.view"
        },
        "TargetHuStockTransferDetail": {
          "id": "huStockTransferDetail",
          "name": "HuStockTransferDetail",
          "path": "saps4hana.fiori.modules.wm.hu-stock-transfer.view"
        }
      }
    }
  }
}
