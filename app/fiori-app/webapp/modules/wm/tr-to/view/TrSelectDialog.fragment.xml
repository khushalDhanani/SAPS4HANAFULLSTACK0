<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <SelectDialog
        id="dlgTrSelect"
        title="{i18n>trToSelectDialogTitle}"
        noDataText="{i18n>trToSelectDialogNoData}"
        search=".onSearchTRValueHelp"
        confirm=".onConfirmTRValueHelp"
        cancel=".onCancelTRValueHelp"
        items="{trToView>/openTRs}"
        contentWidth="32rem">
        <StandardListItem
            title="{trToView>DisplayText}"
            description="{trToView>Description}"
            info="{= ${trToView>Statu} === 'T' ? 'Partial' : 'Open' }"
            infoState="{= ${trToView>Statu} === 'T' ? 'Warning' : 'Success' }"
            icon="sap-icon://document-text"
            type="Active" />
    </SelectDialog>
</core:FragmentDefinition>
