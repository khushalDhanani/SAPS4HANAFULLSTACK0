<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="dlgBatchSelection"
        title="{i18n>giBatchSelectionDialogTitle}"
        icon="sap-icon://batch-payments"
        contentWidth="58rem"
        class="sapUiSizeCompact">
        <content>
            <VBox class="sapUiSmallMargin">
                <MessageStrip
                    text="{i18n>giBatchFefoInfo}"
                    type="Information"
                    showIcon="true"
                    class="sapUiTinyMarginBottom" />

                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom" wrap="Wrap">
                    <VBox class="sapUiTinyMarginEnd">
                        <Title text="{giBatchSelection>/material} - {giBatchSelection>/materialDesc}" level="H4" />
                        <HBox alignItems="Center" class="sapUiTinyMarginTop">
                            <Text text="{i18n>giColPlant}: " class="textMuted sapUiTinyMarginEnd" />
                            <Label text="{giBatchSelection>/plant}" design="Bold" class="sapUiSmallMarginEnd" />
                            <Text text="{i18n>giColStorageLocation}: " class="textMuted sapUiTinyMarginEnd" />
                            <Label text="{= ${giBatchSelection>/storageLocation} || '-' }" design="Bold" />
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Searchable Filter Bar -->
                <SearchField
                    id="searchBatches"
                    width="100%"
                    placeholder="{i18n>giSearchBatchesPlaceholder}"
                    liveChange=".onSearchBatches"
                    search=".onSearchBatches"
                    class="sapUiSmallMarginBottom" />

                <Table
                    id="tblBatches"
                    items="{giBatchSelection>/batches}"
                    busy="{giBatchSelection>/busy}"
                    busyIndicatorDelay="0"
                    noDataText="{= ${giBatchSelection>/noDataReason} || ${i18n>giNoUsableBatchesFound} }"
                    class="sapUiSizeCompact">
                    <columns>
                        <Column><Text text="{i18n>giColBatch}" /></Column>
                        <Column width="8rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColExpiryDate}" /></Column>
                        <Column width="8rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColSledStatus}" /></Column>
                        <Column width="5rem" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColPlant}" /></Column>
                        <Column width="5rem" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColStorageLocation}" /></Column>
                        <Column hAlign="End" width="7rem"><Text text="{i18n>giColAvailableStock}" /></Column>
                        <Column width="6rem" hAlign="Center"><Text text="{i18n>giColAction}" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <ObjectIdentifier title="{giBatchSelection>Batch}" />
                                <Text text="{= ${giBatchSelection>ExpiryDate} || ${i18n>giBatchNoSled} }" />
                                <ObjectStatus
                                    text="{giBatchSelection>StatusText}"
                                    state="{giBatchSelection>StatusState}" />
                                <Text text="{giBatchSelection>Plant}" />
                                <Text text="{= ${giBatchSelection>StorageLocation} || '-' }" />
                                <Text text="{= ${giBatchSelection>AvailableStock} !== null &amp;&amp; ${giBatchSelection>AvailableStock} !== undefined ? (${giBatchSelection>AvailableStock} + ' ' + ${giBatchSelection>Unit}) : '-' }" />
                                <Button
                                    text="{= ${giBatchSelection>AvailableStock} !== null &amp;&amp; ${giBatchSelection>AvailableStock} !== undefined ? (Number(${giBatchSelection>AvailableStock}) > 0 ? ${i18n>btnSelect} : ${i18n>giBatchNoStock}) : ${i18n>btnSelect} }"
                                    icon="{= ${giBatchSelection>AvailableStock} !== null &amp;&amp; ${giBatchSelection>AvailableStock} !== undefined &amp;&amp; Number(${giBatchSelection>AvailableStock}) &lt;= 0 ? 'sap-icon://decline' : 'sap-icon://accept' }"
                                    enabled="{= (${giBatchSelection>AvailableStock} === null || ${giBatchSelection>AvailableStock} === undefined || Number(${giBatchSelection>AvailableStock}) > 0) &amp;&amp; ${giBatchSelection>StatusState} !== 'Error' }"
                                    type="{= ${giBatchSelection>AvailableStock} !== null &amp;&amp; ${giBatchSelection>AvailableStock} !== undefined &amp;&amp; Number(${giBatchSelection>AvailableStock}) &lt;= 0 ? 'Transparent' : (${giBatchSelection>StatusState} === 'Error' ? 'Reject' : 'Emphasized') }"
                                    press=".onSelectBatch" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
        <endButton>
            <Button
                id="btnCloseBatchSelectionDialog"
                text="{i18n>btnClose}"
                press=".onCloseBatchSelectionDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
