<mvc:View
    controllerName="saps4hana.fiori.modules.wm.goods-issue.controller.GoodsIssue261"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">

    <Page
        id="pageGoodsIssue261"
        busy="{gi261>/busy}"
        busyIndicatorDelay="0"
        class="sapUiSizeCompact">

        <headerContent>
            <ObjectStatus
                id="statMvtBadge261"
                text="{i18n>gi261MovementTypeBadge}"
                state="Information"
                icon="sap-icon://expense-report"
                class="sapUiTinyMarginEnd" />
        </headerContent>

        <content>
            <VBox class="sapUiResponsiveMargin">

                <!-- 1. Posted Document Success Banner (with Reversal Trigger) -->
                <MessageStrip
                    id="stripPostSuccess261"
                    text="{parts: [{path: 'gi261>/postedDocument'}, {path: 'gi261>/postedYear'}], formatter: '.formatSuccessBanner'}"
                    type="Success"
                    showIcon="true"
                    showCloseButton="false"
                    visible="{gi261>/hasPosted}"
                    class="sapUiSmallMarginBottom">
                    <link>
                        <Link
                            id="lnkReverse261"
                            text="{i18n>gi261ActionReverseNow}"
                            press=".onReverseGoodsIssue"
                            enabled="{= !${gi261>/reversalBusy} }" />
                    </link>
                </MessageStrip>

                <!-- 2. Reversal Success Banner -->
                <MessageStrip
                    id="stripReversalSuccess261"
                    text="{parts: [{path: 'gi261>/reversalDocument'}, {path: 'gi261>/reversalYear'}], formatter: '.formatReversalBanner'}"
                    type="Information"
                    showIcon="true"
                    showCloseButton="true"
                    visible="{gi261>/hasReversed}"
                    class="sapUiSmallMarginBottom" />

                <!-- 3. Form Container -->
                <Panel
                    id="pnlGeneralData261"
                    headerText="{i18n>gi261SectionGeneralData}"
                    expandable="false"
                    class="sapUiSmallMarginBottom">

                    <f:SimpleForm
                        id="formGoodsIssue261"
                        editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4"
                        labelSpanL="4"
                        labelSpanM="4"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="2"
                        columnsL="2"
                        columnsM="2"
                        singleContainerFullSize="false">
                        <f:content>

                            <!-- Issue Mode Selection (Planned Reservation vs Unplanned Direct Order) -->
                            <core:Title id="titleIssueMode261" text="{i18n>gi261TitleIssueMode}" />
                            <Label id="lblIssueMode261" text="{i18n>gi261IssueMode}" visible="{= !${gi261>/fromReservation} }" />
                            <SegmentedButton
                                id="segIssueMode261"
                                selectedKey="{= ${gi261>/isUnplanned} ? 'UNPLANNED' : 'PLANNED' }"
                                selectionChange=".onIssueModeChange"
                                visible="{= !${gi261>/fromReservation} }"
                                class="sapUiTinyMarginBottom">
                                <items>
                                    <SegmentedButtonItem id="sbiPlanned261" key="PLANNED" text="{i18n>gi261ModePlanned}" />
                                    <SegmentedButtonItem id="sbiUnplanned261" key="UNPLANNED" text="{i18n>gi261ModeUnplanned}" />
                                </items>
                            </SegmentedButton>

                            <!-- Assignment (Reservation in Planned Mode / Order in Unplanned Mode) -->
                            <Label id="lblReservationNo261" text="{i18n>gi261ReservationNo}" required="true" visible="{= !${gi261>/isUnplanned} }" />
                            <Input
                                id="inReservationNo261"
                                value="{gi261>/reservationNo}"
                                placeholder="{i18n>gi261ReservationNoPlaceholder}"
                                showValueHelp="true"
                                valueHelpRequest=".onReservationValueHelp"
                                editable="false"
                                valueState="{= ${gi261>/errors/reservationNo} ? 'Error' : 'None' }"
                                valueStateText="{gi261>/errors/reservationNo}"
                                maxLength="10"
                                visible="{= !${gi261>/isUnplanned} }" />

                            <Label id="lblReservationItem261" text="{i18n>gi261ReservationItem}" required="true" visible="{= !${gi261>/isUnplanned} }" />
                            <Input
                                id="inReservationItem261"
                                value="{gi261>/reservationItem}"
                                placeholder="{i18n>gi261ReservationItemPlaceholder}"
                                editable="{= !${gi261>/fromReservation} }"
                                showValueHelp="{= !${gi261>/fromReservation} }"
                                valueHelpRequest=".onReservationValueHelp"
                                change=".onReservationItemChange"
                                valueState="{= ${gi261>/errors/reservationItem} ? 'Error' : 'None' }"
                                valueStateText="{gi261>/errors/reservationItem}"
                                maxLength="4"
                                visible="{= !${gi261>/isUnplanned} }" />

                            <Label id="lblOrderNo261" text="{i18n>gi261OrderNo}" visible="{= !${gi261>/isUnplanned} &amp;&amp; !!${gi261>/orderNo} }" />
                            <Text
                                id="txtOrderNo261"
                                text="{gi261>/orderNo}"
                                class="sapUiTinyMarginTop fontBold"
                                visible="{= !${gi261>/isUnplanned} &amp;&amp; !!${gi261>/orderNo} }" />

                            <!-- Order Assignment (Unplanned Mode) -->
                            <Label id="lblOrderNoInput261" text="{i18n>gi261OrderNo}" required="true" visible="{gi261>/isUnplanned}" />
                            <Input
                                id="inOrderNo261"
                                value="{gi261>/orderNo}"
                                placeholder="{i18n>gi261OrderNoPlaceholder}"
                                showValueHelp="true"
                                valueHelpRequest=".onOrderValueHelp"
                                liveChange=".onFieldLiveChange"
                                valueState="{= ${gi261>/errors/orderNo} ? 'Error' : 'None' }"
                                valueStateText="{gi261>/errors/orderNo}"
                                maxLength="12"
                                visible="{gi261>/isUnplanned}" />

                            <!-- Material & Location -->
                            <core:Title id="titleMaterialLocation261" text="{i18n>gi261TitleMaterialLocation}" />

                            <Label id="lblMaterial261" text="{i18n>gi261Material}" required="{gi261>/isUnplanned}" />
                            <Text id="txtMaterial261" text="{gi261>/material}" visible="{= !${gi261>/isUnplanned} }" />
                            <Input
                                id="inMaterial261"
                                value="{gi261>/material}"
                                placeholder="{i18n>gi261MaterialPlaceholder}"
                                showValueHelp="true"
                                valueHelpRequest=".onMaterialValueHelp"
                                liveChange=".onMaterialLiveChange"
                                valueState="{= ${gi261>/errors/material} ? 'Error' : 'None' }"
                                valueStateText="{gi261>/errors/material}"
                                maxLength="40"
                                visible="{gi261>/isUnplanned}" />

                            <Label id="lblMaterialDesc261" text="{i18n>gi261MaterialDesc}" visible="{= !!${gi261>/materialName} }" />
                            <Text
                                id="txtMaterialDesc261"
                                text="{gi261>/materialName}"
                                class="sapUiTinyMarginTop fontBold"
                                visible="{= !!${gi261>/materialName} }" />

                            <Label id="lblPlant261" text="{i18n>gi261Plant}" required="{gi261>/isUnplanned}" />
                            <Text id="txtPlant261" text="{gi261>/plant}" visible="{= !${gi261>/isUnplanned} }" />
                            <Input
                                id="inPlant261"
                                value="{gi261>/plant}"
                                placeholder="{i18n>gi261PlantPlaceholder}"
                                liveChange=".onFieldLiveChange"
                                valueState="{= ${gi261>/errors/plant} ? 'Error' : 'None' }"
                                valueStateText="{gi261>/errors/plant}"
                                maxLength="4"
                                visible="{gi261>/isUnplanned}" />

                            <Label id="lblStorageLocation261" text="{i18n>gi261StorageLocation}" required="{gi261>/isUnplanned}" />
                            <Text id="txtStorageLocation261" text="{gi261>/storageLocation}" visible="{= !${gi261>/isUnplanned} }" />
                            <Input
                                id="inStorageLocation261"
                                value="{gi261>/storageLocation}"
                                placeholder="{i18n>gi261StorageLocationPlaceholder}"
                                liveChange=".onFieldLiveChange"
                                valueState="{= ${gi261>/errors/storageLocation} ? 'Error' : 'None' }"
                                valueStateText="{gi261>/errors/storageLocation}"
                                maxLength="4"
                                visible="{gi261>/isUnplanned}" />

                            <!-- Quantity & Posting Dates -->
                            <core:Title id="titleQuantityDates261" text="{i18n>gi261TitleQuantityDates}" />

                            <Label id="lblQuantity261" text="{i18n>gi261Quantity}" required="true" />
                            <HBox id="boxQuantityUnit261" alignItems="Center">
                                <Input
                                    id="inQuantity261"
                                    value="{gi261>/quantity}"
                                    type="Number"
                                    editable="{= !${gi261>/fromReservation} }"
                                    liveChange=".onQuantityLiveChange"
                                    valueState="{= ${gi261>/errors/quantity} ? 'Error' : 'None' }"
                                    valueStateText="{gi261>/errors/quantity}"
                                    width="10rem"
                                    class="sapUiTinyMarginEnd" />
                                <Input
                                    id="inUnit261"
                                    value="{gi261>/unit}"
                                    editable="{= ${gi261>/isUnplanned} || ${gi261>/isUnitEditable} }"
                                    liveChange=".onFieldLiveChange"
                                    valueState="{= ${gi261>/errors/unit} ? 'Error' : 'None' }"
                                    valueStateText="{gi261>/errors/unit}"
                                    width="6rem"
                                    maxLength="3" />
                            </HBox>

                            <Label id="lblPostingDate261" text="{i18n>gi261PostingDate}" required="true" />
                            <DatePicker
                                id="dpPostingDate261"
                                value="{gi261>/postingDate}"
                                valueFormat="yyyy-MM-dd"
                                displayFormat="medium"
                                change=".onFieldLiveChange"
                                valueState="{= ${gi261>/errors/postingDate} ? 'Error' : 'None' }"
                                valueStateText="{gi261>/errors/postingDate}" />

                            <Label id="lblDocumentDate261" text="{i18n>gi261DocumentDate}" required="true" />
                            <DatePicker
                                id="dpDocumentDate261"
                                value="{gi261>/documentDate}"
                                valueFormat="yyyy-MM-dd"
                                displayFormat="medium"
                                change=".onFieldLiveChange"
                                valueState="{= ${gi261>/errors/documentDate} ? 'Error' : 'None' }"
                                valueStateText="{gi261>/errors/documentDate}" />

                            <Label id="lblHeaderText261" text="{i18n>gi261HeaderText}" />
                            <Input
                                id="inHeaderText261"
                                value="{gi261>/headerText}"
                                placeholder="{i18n>gi261HeaderTextPlaceholder}"
                                maxLength="25" />

                            <!-- Conditional: Batch Management -->
                            <core:Title
                                id="titleBatchManagement261"
                                text="{i18n>gi261TitleBatchManagement}" />

                            <Label
                                id="lblBatch261"
                                text="{i18n>gi261Batch}"
                                required="{gi261>/isBatchManaged}"
                                visible="{gi261>/isBatchManaged}" />
                            <Input
                                id="inBatch261"
                                value="{gi261>/batch}"
                                placeholder="{i18n>gi261BatchPlaceholder}"
                                liveChange=".onFieldLiveChange"
                                valueState="{= ${gi261>/errors/batch} ? 'Error' : 'None' }"
                                valueStateText="{gi261>/errors/batch}"
                                visible="{gi261>/isBatchManaged}"
                                maxLength="10" />

                        </f:content>
                    </f:SimpleForm>
                </Panel>

                <!-- SU Data Gap Warning (when no SU data exists in SAP for this material/plant/sloc) -->
                <MessageStrip
                    id="stripNoSuDataGap261"
                    text="{gi261>/noSuDataGap}"
                    type="Warning"
                    showIcon="true"
                    showCloseButton="false"
                    visible="{= !!${gi261>/noSuDataGap} }"
                    class="sapUiSmallMarginBottom" />

                <!-- 3b. Scan-to-complete: unit-managed reservations (serial or storage unit). Scanning
                     validates each unit against S/4 (right material, in stock, not already issued). -->
                <Panel
                    id="pnlScanToComplete261"
                    headerText="{i18n>gi261ScanSectionTitle}"
                    expandable="false"
                    visible="{gi261>/scanEnabled}"
                    class="sapUiSmallMarginBottom">
                    <VBox class="sapUiSmallMargin">
                        <HBox alignItems="End" class="sapUiTinyMarginBottom" wrap="Wrap">
                            <Input
                                id="inScanUnit261"
                                value="{gi261>/scanInput}"
                                placeholder="{i18n>gi261ScanPlaceholder}"
                                submit=".onScanInputSubmit"
                                width="22rem"
                                class="sapUiTinyMarginEnd" />
                            <Button
                                id="btnScanUnit261"
                                text="{i18n>gi261ScanBtn}"
                                type="Emphasized"
                                icon="sap-icon://bar-code"
                                press=".onScanUnit"
                                class="sapUiTinyMarginEnd" />
                            <ToolbarSpacer />
                            <ObjectStatus
                                id="osScanProgress261"
                                title="{i18n>gi261ScanProgress}"
                                text="{= ${gi261>/scannedQty} + ' / ' + ${gi261>/requiredScanCount} + ' ' + ${gi261>/unit} }"
                                state="{= Math.abs(${gi261>/scannedQty} - ${gi261>/requiredScanCount}) &lt; 0.001 ? 'Success' : 'Warning' }" />
                            <ObjectStatus
                                id="osSuCountProgress261"
                                title="{i18n>gi261SuCountProgress}"
                                text="{= ${gi261>/scannedUnits}.length + ' / ' + ${gi261>/suggestedUnitsCount} }"
                                state="{= ${gi261>/scannedUnits}.length === ${gi261>/suggestedUnitsCount} ? 'Success' : 'Information' }"
                                class="sapUiMediumMarginBegin" />
                        </HBox>
                        <MessageStrip
                            id="msScanFeedback261"
                            text="{gi261>/lastScanText}"
                            type="{= ${gi261>/lastScanState} === 'None' ? 'Information' : ${gi261>/lastScanState} }"
                            showIcon="true"
                            visible="{= ${gi261>/lastScanState} !== 'None' }"
                            class="sapUiTinyMarginBottom" />
                        <Table
                            id="tblScannedUnits261"
                            items="{gi261>/scannedUnits}"
                            noDataText="{i18n>gi261ScanNoData}"
                            mode="Delete"
                            delete=".onDeleteScannedUnit">
                            <columns>
                                <Column id="colScanUnit261"><Text text="{i18n>gi261ScanColUnit}" /></Column>
                                <Column id="colScanMaterial261" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>gi261ScanColMaterial}" /></Column>
                                <Column id="colScanQty261" hAlign="End"><Text text="{i18n>gi261ScanColQty}" /></Column>
                                <Column id="colScanBatch261" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>gi261ScanColBatch}" /></Column>
                                <Column id="colScanKind261" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" hAlign="End"><Text text="{i18n>gi261ScanColKind}" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{= ${gi261>serial} ? ${gi261>serial} : ${gi261>barcode} }" />
                                        <Text text="{gi261>material}" />
                                        <Text text="{= ${gi261>qty} ? ${gi261>qty} + ' ' + ${gi261>unit} : '—' }" />
                                        <Text text="{= ${gi261>batch} || '—' }" />
                                        <ObjectStatus
                                            text="{= ${gi261>isSerial} ? ${i18n>gi261ScanKindSerial} : ${i18n>gi261ScanKindSU} }"
                                            state="Information" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </Panel>

                <!-- 3c. Suggested Storage Units (FIFO/FEFO recommendation) -->
                <Panel
                    id="pnlSuggestedUnits261"
                    headerText="{i18n>gi261SuggestedSectionTitle}"
                    expandable="true"
                    expanded="true"
                    visible="{= ${gi261>/scanEnabled} &amp;&amp; ${gi261>/suggestedUnits}.length > 0 }"
                    class="sapUiSmallMarginBottom">
                    <Table
                        id="tblSuggestedUnits261"
                        items="{gi261>/suggestedUnits}"
                        noDataText="{i18n>gi261SuggestedNoData}">
                        <columns>
                            <Column id="colSuggestedUnit261"><Text text="{i18n>gi261SuggestedColUnit}" /></Column>
                            <Column id="colSuggestedBin261" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>gi261SuggestedColBin}" /></Column>
                            <Column id="colSuggestedQty261" hAlign="End"><Text text="{i18n>gi261SuggestedColQty}" /></Column>
                            <Column id="colSuggestedBatch261" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>gi261SuggestedColBatch}" /></Column>
                            <Column id="colSuggestedStatus261" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>gi261SuggestedColStatus}" /></Column>
                            <Column id="colSuggestedAction261" hAlign="End"><Text text="{i18n>gi261SuggestedColAction}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{gi261>StorageUnit}" class="fontBold" />
                                    <Text text="{= ${gi261>StorageType} ? (${gi261>StorageType} + ' / ' + ${gi261>StorageBin}) : ${gi261>StorageBin} }" />
                                    <Text text="{= ${gi261>AvailableStock} + ' ' + ${gi261>Unit} }" />
                                    <Text text="{= ${gi261>Batch} || '—' }" />
                                    <ObjectStatus
                                        text="{= ${gi261>StatusText} || ${gi261>StatusState} || 'Available' }"
                                        state="{= ${gi261>StatusState} === 'Error' ? 'Error' : (${gi261>StatusState} === 'Warning' ? 'Warning' : 'Success') }" />
                                    <Button
                                        text="{i18n>gi261BtnScanSuggested}"
                                        type="Transparent"
                                        icon="sap-icon://bar-code"
                                        press=".onScanSuggestedPress" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

                <!-- 4. Conditional: Serial Numbers Management -->
                <Panel
                    id="pnlSerialManagement261"
                    headerText="{i18n>gi261TitleSerialManagement}"
                    expandable="false"
                    visible="{gi261>/isSerialManaged}"
                    class="sapUiSmallMarginBottom">

                    <VBox class="sapUiSmallMargin">
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <Input
                                id="inSerialScan261"
                                value="{gi261>/serialInput}"
                                placeholder="{i18n>gi261SerialScanPlaceholder}"
                                submit=".onSerialInputSubmit"
                                width="18rem"
                                maxLength="18"
                                class="sapUiTinyMarginEnd" />
                            <Button
                                id="btnAddSerial261"
                                text="{i18n>gi261BtnAddSerial}"
                                icon="sap-icon://bar-code"
                                press=".onAddSerialPress"
                                class="sapUiTinyMarginEnd" />
                            <ObjectStatus
                                id="statSerialCount261"
                                text="{= ${gi261>/serialNumbers}.length + ' / ' + ${gi261>/quantity} + ' ' + ${i18n>gi261SerialsScanned} }"
                                state="{= ${gi261>/serialNumbers}.length === ${gi261>/quantity} ? 'Success' : 'Warning' }" />
                        </HBox>

                        <Text
                            id="txtSerialError261"
                            text="{gi261>/errors/serials}"
                            class="sapUiTinyMarginBottom"
                            visible="{= !!${gi261>/errors/serials} }" />

                        <Table
                            id="tblSerialNumbers261"
                            items="{gi261>/serialNumbers}"
                            noDataText="{i18n>gi261NoSerialsScanned}"
                            width="100%">
                            <columns>
                                <Column id="colSerialIndex261" width="4rem"><Text text="#" /></Column>
                                <Column id="colSerialNumber261"><Text text="{i18n>gi261ColSerialNumber}" /></Column>
                                <Column id="colSerialStatus261" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" width="10rem"><Text text="{i18n>gi261ColSerialStatus}" /></Column>
                                <Column id="colSerialAction261" width="4rem" hAlign="End"><Text text="" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{= ${path: ''} ? '' : '' }" />
                                        <Text text="{gi261>}" class="fontBold" />
                                        <ObjectStatus text="{i18n>gi261SerialPendingStockVerify}" state="Information" />
                                        <Button
                                            icon="sap-icon://delete"
                                            type="Transparent"
                                            tooltip="{i18n>gi261BtnDeleteSerial}"
                                            press=".onDeleteSerial" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </Panel>

            </VBox>
        </content>

        <!-- Footer Actions -->
        <footer>
            <Toolbar id="tbGoodsIssue261">
                <Button
                    id="btnResetForm261"
                    text="{i18n>gi261BtnReset}"
                    icon="sap-icon://refresh"
                    type="Transparent"
                    press=".onResetForm" />
                <ToolbarSpacer />
                <Button
                    id="btnPostGoodsIssue261"
                    text="{= ${gi261>/fromReservation} ? ${i18n>gi261BtnComplete} : ${i18n>gi261BtnPost} }"
                    icon="{= ${gi261>/fromReservation} ? 'sap-icon://accept' : 'sap-icon://save' }"
                    type="Emphasized"
                    enabled="{gi261>/isValid}"
                    press=".onPostGoodsIssue" />
            </Toolbar>
        </footer>

    </Page>
</mvc:View>
