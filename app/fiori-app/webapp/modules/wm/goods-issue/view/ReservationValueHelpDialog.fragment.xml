<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <SelectDialog
        id="dlgReservationValueHelp"
        title="{i18n>giReservationValueHelpTitle}"
        noDataText="{i18n>giReservationValueHelpNoData}"
        search=".onSearchReservationValueHelp"
        confirm=".onConfirmReservationValueHelp"
        cancel=".onCancelReservationValueHelp"
        items="{giView>/openReservations}"
        class="sapUiSizeCompact">
        <StandardListItem
            title="{giView>DisplayText}"
            description="{= (${giView>OrderNo} ? (${i18n>giOrderLabel} + ': ' + ${giView>OrderNo} + ' | ') : '') + ${i18n>giPlantLabel} + ': ' + ${giView>Plant} + ' | ' + ${giView>ItemCount} + ' ' + (${giView>ItemCountPartial} ? ${i18n>giItemsPartialBadge} : ${i18n>giItemsBadge}) }"
            info="{= ${giView>SampleMaterial} ? (${i18n>giColMaterial} + ': ' + ${giView>SampleMaterial}) : '' }"
            icon="sap-icon://document"
            type="Active" />
    </SelectDialog>
</core:FragmentDefinition>
