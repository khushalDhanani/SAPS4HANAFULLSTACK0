<mvc:View
    controllerName="saps4hana.fiori.modules.wm.goods-issue.controller.GoodsIssueDashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    displayBlock="true">

    <Page
        id="goodsIssueDashboardPage"
        showHeader="true"
        title="{i18n>giDashboardPageTitle}"
        showNavButton="true"
        navButtonPress=".onNavBackToOverview"
        showFooter="false"
        class="sapUiSizeCompact">

        <headerContent>
            <HBox alignItems="Center">
                <Button
                    id="btnQuickNew201"
                    text="{i18n>giActionNew201}"
                    icon="sap-icon://expense-report"
                    type="Default"
                    press=".onNavigateToCreate201"
                    class="sapUiTinyMarginEnd" />
                <Button
                    id="btnQuickNew261"
                    text="{i18n>giActionNew261}"
                    icon="sap-icon://product"
                    type="Emphasized"
                    press=".onNavigateToCreate261"
                    class="sapUiTinyMarginEnd" />
                <Button
                    id="btnQuickNew301"
                    text="{i18n>giActionNew301}"
                    icon="sap-icon://journey-arrive"
                    type="Default"
                    press=".onNavigateToCreate301"
                    class="sapUiTinyMarginEnd" />
                <Button
                    id="btnQuickNew311"
                    text="{i18n>giActionNew311}"
                    icon="sap-icon://move"
                    type="Default"
                    press=".onNavigateToCreate311"
                    class="sapUiTinyMarginEnd" />
                <Button
                    id="btnDashboardQueueTray"
                    text="{i18n>wmGIQueueTrayBtn}"
                    icon="sap-icon://inbox"
                    type="Transparent"
                    press=".onOpenQueueTray"
                    class="sapUiTinyMarginEnd" />
                <Button
                    id="btnRefreshDashboard"
                    icon="sap-icon://refresh"
                    tooltip="{i18n>btnRefresh}"
                    type="Transparent"
                    press=".onRefresh" />
            </HBox>
        </headerContent>

        <content>
            <VBox class="sapUiResponsiveMargin" busy="{dashboardView>/loading}">

                <!-- Error State Banner -->
                <MessageStrip
                    id="dashboardErrorStrip"
                    visible="{= !!${dashboardView>/error} }"
                    text="{dashboardView>/error}"
                    type="Error"
                    showIcon="true"
                    showCloseButton="true"
                    class="sapUiSmallMarginBottom">
                    <link>
                        <Link text="{i18n>giRetryConnection}" press=".onRefresh" />
                    </link>
                </MessageStrip>

                <!-- SECTION 1: TOP KPI ROW (Tiles for 201, 261, 301, 311, and Overall) - UNCHANGED
                     except the tooltip fix in fix #3 below (see each GenericTile's tooltip attribute) -->
                <Panel
                    id="panelKpis"
                    headerText="{i18n>giKpiSectionTitle}"
                    class="sapUiSmallMarginBottom"
                    expandable="false">
                    <HBox
                        id="kpiContainer"
                        wrap="Wrap"
                        class="wmKpiTileContainer dashboardTileContainer">

                        <!-- Tile 0: Movement 201 Goods Issue to Cost Center -->
                        <GenericTile
                            id="kpiTile201"
                            header="{i18n>giKpi201Title}"
                            subheader="{= ${i18n>giKpiTodayPostings} + ': ' + (${dashboardView>/kpis/mvt201/todayPostingsCount} !== undefined ? ${dashboardView>/kpis/mvt201/todayPostingsCount} : '0') }"
                            tooltip="{i18n>giKpi201Subtitle}"
                            press=".onSelectKpi201"
                            state="{= ${dashboardView>/loading} ? 'Loading' : (${dashboardView>/error} ? 'Failed' : 'Loaded') }"
                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <TileContent
                                unit="{i18n>giKpiTotalPostings}"
                                footer="{i18n>giKpiViewPostings}">
                                <NumericContent
                                    id="kpiTile201Val"
                                    value="{dashboardView>/kpis/mvt201/totalCount}"
                                    truncateValueTo="10"
                                    icon="sap-icon://expense-report"
                                    valueColor="Neutral" />
                            </TileContent>
                        </GenericTile>

                        <!-- Tile 1: Movement 261 Goods Issue to Order -->
                        <GenericTile
                            id="kpiTile261"
                            header="{i18n>giKpi261Title}"
                            subheader="{= ${i18n>giKpiTodayPostings} + ': ' + (${dashboardView>/kpis/mvt261/todayPostingsCount} !== undefined ? ${dashboardView>/kpis/mvt261/todayPostingsCount} : '0') }"
                            tooltip="{i18n>giKpi261Subtitle}"
                            press=".onSelectKpi261"
                            state="{= ${dashboardView>/loading} ? 'Loading' : (${dashboardView>/error} ? 'Failed' : 'Loaded') }"
                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <TileContent
                                unit="{i18n>giKpiTotalPostings}"
                                footer="{i18n>giKpiViewPostings}">
                                <NumericContent
                                    id="kpiTile261Val"
                                    value="{dashboardView>/kpis/mvt261/totalCount}"
                                    truncateValueTo="10"
                                    icon="sap-icon://product"
                                    valueColor="Neutral" />
                            </TileContent>
                        </GenericTile>

                        <!-- Tile 2: Movement 301 Plant-to-Plant Transfer -->
                        <GenericTile
                            id="kpiTile301"
                            header="{i18n>giKpi301Title}"
                            subheader="{= ${i18n>giKpiTodayPostings} + ': ' + (${dashboardView>/kpis/mvt301/todayPostingsCount} !== undefined ? ${dashboardView>/kpis/mvt301/todayPostingsCount} : '0') }"
                            tooltip="{i18n>giKpi301Subtitle}"
                            press=".onSelectKpi301"
                            state="{= ${dashboardView>/loading} ? 'Loading' : (${dashboardView>/error} ? 'Failed' : 'Loaded') }"
                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <TileContent
                                unit="{i18n>giKpiTotalPostings}"
                                footer="{i18n>giKpiViewPostings}">
                                <NumericContent
                                    id="kpiTile301Val"
                                    value="{dashboardView>/kpis/mvt301/totalCount}"
                                    truncateValueTo="10"
                                    icon="sap-icon://journey-arrive"
                                    valueColor="Neutral" />
                            </TileContent>
                        </GenericTile>

                        <!-- Tile 3: Movement 311 Storage Location Transfer -->
                        <GenericTile
                            id="kpiTile311"
                            header="{i18n>giKpi311Title}"
                            subheader="{= ${i18n>giKpiTodayPostings} + ': ' + (${dashboardView>/kpis/mvt311/todayPostingsCount} !== undefined ? ${dashboardView>/kpis/mvt311/todayPostingsCount} : '0') }"
                            tooltip="{i18n>giKpi311Subtitle}"
                            press=".onSelectKpi311"
                            state="{= ${dashboardView>/loading} ? 'Loading' : (${dashboardView>/error} ? 'Failed' : 'Loaded') }"
                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <TileContent
                                unit="{i18n>giKpiTotalPostings}"
                                footer="{i18n>giKpiViewPostings}">
                                <NumericContent
                                    id="kpiTile311Val"
                                    value="{dashboardView>/kpis/mvt311/totalCount}"
                                    truncateValueTo="10"
                                    icon="sap-icon://move"
                                    valueColor="Neutral" />
                            </TileContent>
                        </GenericTile>

                        <!-- Tile 4: Overall Consolidated Total -->
                        <GenericTile
                            id="kpiTileOverall"
                            header="{i18n>giKpiOverallTitle}"
                            subheader="{= ${i18n>giKpiTodayPostings} + ': ' + (${dashboardView>/kpis/overall/todayPostingsCount} !== undefined ? ${dashboardView>/kpis/overall/todayPostingsCount} : '0') }"
                            tooltip="{i18n>giKpiOverallSubtitle}"
                            press=".onSelectKpiOverall"
                            state="{= ${dashboardView>/loading} ? 'Loading' : (${dashboardView>/error} ? 'Failed' : 'Loaded') }"
                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                            <TileContent
                                unit="{i18n>giKpiTotalPostings}"
                                footer="{i18n>giKpiViewPostings}">
                                <NumericContent
                                    id="kpiTileOverallVal"
                                    value="{dashboardView>/kpis/overall/totalCount}"
                                    truncateValueTo="10"
                                    icon="sap-icon://sum"
                                    valueColor="Neutral" />
                            </TileContent>
                        </GenericTile>

                    </HBox>
                </Panel>

                <!-- SECTION 2: MOVEMENT TYPE DISTRIBUTION - 4 independent single-type mini-donuts,
                     one per movement type, each its own widget with its own count/percentage.
                     All 4 numbers come from the same server-computed Distribution array (grouped by
                     BWART in one RFC read - see GoodsIssueDashboardClient), so there is one shared
                     loading/error state (the combined /loading, /error above) exactly like the KPI
                     tiles already share one - this is not a client-side filter of a shared list. -->
                <Panel
                    id="panelDistribution"
                    headerText="{i18n>giChartDistributionTitle}"
                    class="sapUiSmallMarginBottom"
                    expandable="false">
                    <VBox class="sapUiSmallMargin">
                        <Text text="{i18n>giChartDistributionSubtitle}" class="textMuted sapUiTinyMarginBottom" />
                        <HBox id="miniDistributionContainer" wrap="Wrap" justifyContent="SpaceAround" class="dashboardTileContainer">
                            <VBox class="sapUiTinyMargin" alignItems="Center">
                                <core:HTML id="htmlMiniDist201" content="{dashboardView>/miniDistribution/201/svg}" preferDOM="true" />
                                <Text text="{i18n>giMode201} (201)" class="sapUiTinyMarginTop" />
                            </VBox>
                            <VBox class="sapUiTinyMargin" alignItems="Center">
                                <core:HTML id="htmlMiniDist261" content="{dashboardView>/miniDistribution/261/svg}" preferDOM="true" />
                                <Text text="{i18n>giMode261} (261)" class="sapUiTinyMarginTop" />
                            </VBox>
                            <VBox class="sapUiTinyMargin" alignItems="Center">
                                <core:HTML id="htmlMiniDist301" content="{dashboardView>/miniDistribution/301/svg}" preferDOM="true" />
                                <Text text="{i18n>giMode301} (301)" class="sapUiTinyMarginTop" />
                            </VBox>
                            <VBox class="sapUiTinyMargin" alignItems="Center">
                                <core:HTML id="htmlMiniDist311" content="{dashboardView>/miniDistribution/311/svg}" preferDOM="true" />
                                <Text text="{i18n>giMode311} (311)" class="sapUiTinyMarginTop" />
                            </VBox>
                        </HBox>
                    </VBox>
                </Panel>

                <!-- SECTION 3: MOVEMENT TREND ANALYSIS - 4 independent single-series mini-sparklines,
                     one per movement type. Same data-sharing note as Distribution above: the per-day
                     Count201/Count261/Count301/Count311 columns are already aggregated server-side per
                     type in one RFC read, this only splits the VISUAL rendering into 4 widgets. -->
                <Panel
                    id="panelTrend"
                    headerText="{i18n>giChartTrendTitle}"
                    class="sapUiSmallMarginBottom"
                    expandable="false">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="{i18n>giChartTrendTitle}" level="H4" />
                            <ToolbarSpacer />
                            <SegmentedButton
                                id="segTrendPeriod"
                                selectedKey="{dashboardView>/trendPeriod}"
                                selectionChange=".onTrendPeriodChange">
                                <items>
                                    <SegmentedButtonItem key="7" text="{i18n>giTrend7Days}" />
                                    <SegmentedButtonItem key="30" text="{i18n>giTrend30Days}" />
                                </items>
                            </SegmentedButton>
                        </OverflowToolbar>
                    </headerToolbar>
                    <VBox class="sapUiSmallMargin">
                        <Text text="{i18n>giChartTrendSubtitle}" class="textMuted sapUiTinyMarginBottom" />
                        <layout:Grid id="miniTrendGrid" defaultSpan="XL3 L3 M6 S12" class="sapUiTinyMarginBottom">
                            <VBox class="sapUiTinyMargin">
                                <Text text="{i18n>giMode201} (201)" class="sapUiTinyMarginBottom fontBold" />
                                <core:HTML id="htmlMiniTrend201" content="{dashboardView>/miniTrend/201/svg}" preferDOM="true" />
                            </VBox>
                            <VBox class="sapUiTinyMargin">
                                <Text text="{i18n>giMode261} (261)" class="sapUiTinyMarginBottom fontBold" />
                                <core:HTML id="htmlMiniTrend261" content="{dashboardView>/miniTrend/261/svg}" preferDOM="true" />
                            </VBox>
                            <VBox class="sapUiTinyMargin">
                                <Text text="{i18n>giMode301} (301)" class="sapUiTinyMarginBottom fontBold" />
                                <core:HTML id="htmlMiniTrend301" content="{dashboardView>/miniTrend/301/svg}" preferDOM="true" />
                            </VBox>
                            <VBox class="sapUiTinyMargin">
                                <Text text="{i18n>giMode311} (311)" class="sapUiTinyMarginBottom fontBold" />
                                <core:HTML id="htmlMiniTrend311" content="{dashboardView>/miniTrend/311/svg}" preferDOM="true" />
                            </VBox>
                        </layout:Grid>
                    </VBox>
                </Panel>

                <!-- SECTION 4: RECENT POSTINGS - 4 fully separate tables, one per movement type, each
                     with its own heading, its own type-relevant columns, its own independent growing/
                     paging state, and its own independent loading/empty/error state (backed by its own
                     server-side MovementType-filtered getDashboardData call - see the controller). The
                     old combined table's All/201/261/301/311 toggle filter has been removed entirely. -->

                <!-- 4a. Recent 201 Postings - Cost Center Issues -->
                <Panel
                    id="panelRecent201"
                    expandable="false"
                    class="sapUiSmallMarginBottom">
                    <MessageStrip
                        visible="{= !!${dashboardView>/recent/201/error} }"
                        text="{dashboardView>/recent/201/error}"
                        type="Error"
                        showIcon="true"
                        class="sapUiSmallMarginBottom">
                        <link>
                            <Link text="{i18n>giRetryConnection}" press=".onRefresh" />
                        </link>
                    </MessageStrip>
                    <Table
                        id="tblRecent201"
                        busy="{dashboardView>/recent/201/loading}"
                        busyIndicatorDelay="0"
                        items="{dashboardView>/recent/201/items}"
                        noDataText="{i18n>giNoRecentPostingsFound}"
                        growing="true"
                        growingThreshold="25"
                        growingScrollToLoad="false"
                        class="sapUiSizeCompact">
                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="{= ${i18n>giRecent201SectionTitle} + ' (' + ${dashboardView>/recent/201/total} + ')' }" level="H4" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column width="8rem"><Text text="{i18n>giColMatDoc}" /></Column>
                            <Column width="7.5rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColPostingDate}" /></Column>
                            <Column><Text text="{i18n>giColMaterial}" /></Column>
                            <Column width="7rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColCostCenter}" /></Column>
                            <Column width="5rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giPlantLabel}" /></Column>
                            <Column width="5.5rem" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giSLocLabel}" /></Column>
                            <Column width="6.5rem" hAlign="End"><Text text="{i18n>giColQty}" /></Column>
                            <Column width="4rem" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColUnit}" /></Column>
                            <Column width="7rem" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColUser}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem type="Navigation" press=".onDocumentPress">
                                <cells>
                                    <ObjectIdentifier
                                        title="{dashboardView>MaterialDocument}"
                                        text="{= ${dashboardView>MaterialDocYear} ? 'FY ' + ${dashboardView>MaterialDocYear} : '' }" />
                                    <Text text="{dashboardView>PostingDate}" />
                                    <ObjectIdentifier title="{dashboardView>Material}" text="{dashboardView>MaterialDesc}" />
                                    <Text text="{dashboardView>CostCenter}" />
                                    <Text text="{dashboardView>Plant}" />
                                    <Text text="{dashboardView>StorageLocation}" />
                                    <ObjectNumber number="{dashboardView>Quantity}" unit="{dashboardView>Unit}" />
                                    <Text text="{dashboardView>Unit}" />
                                    <Text text="{dashboardView>User}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

                <!-- 4b. Recent 261 Postings - Goods Issue to Order -->
                <Panel
                    id="panelRecent261"
                    expandable="false"
                    class="sapUiSmallMarginBottom">
                    <MessageStrip
                        visible="{= !!${dashboardView>/recent/261/error} }"
                        text="{dashboardView>/recent/261/error}"
                        type="Error"
                        showIcon="true"
                        class="sapUiSmallMarginBottom">
                        <link>
                            <Link text="{i18n>giRetryConnection}" press=".onRefresh" />
                        </link>
                    </MessageStrip>
                    <Table
                        id="tblRecent261"
                        busy="{dashboardView>/recent/261/loading}"
                        busyIndicatorDelay="0"
                        items="{dashboardView>/recent/261/items}"
                        noDataText="{i18n>giNoRecentPostingsFound}"
                        growing="true"
                        growingThreshold="25"
                        growingScrollToLoad="false"
                        class="sapUiSizeCompact">
                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="{= ${i18n>giRecent261SectionTitle} + ' (' + ${dashboardView>/recent/261/total} + ')' }" level="H4" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column width="8rem"><Text text="{i18n>giColMatDoc}" /></Column>
                            <Column width="7.5rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColPostingDate}" /></Column>
                            <Column><Text text="{i18n>giColMaterial}" /></Column>
                            <Column width="7rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColOrder}" /></Column>
                            <Column width="5rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giPlantLabel}" /></Column>
                            <Column width="5.5rem" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giSLocLabel}" /></Column>
                            <Column width="6.5rem" hAlign="End"><Text text="{i18n>giColQty}" /></Column>
                            <Column width="4rem" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColUnit}" /></Column>
                            <Column width="7rem" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColUser}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem type="Navigation" press=".onDocumentPress">
                                <cells>
                                    <ObjectIdentifier
                                        title="{dashboardView>MaterialDocument}"
                                        text="{= ${dashboardView>MaterialDocYear} ? 'FY ' + ${dashboardView>MaterialDocYear} : '' }" />
                                    <Text text="{dashboardView>PostingDate}" />
                                    <ObjectIdentifier title="{dashboardView>Material}" text="{dashboardView>MaterialDesc}" />
                                    <Text text="{dashboardView>OrderNo}" />
                                    <Text text="{dashboardView>Plant}" />
                                    <Text text="{dashboardView>StorageLocation}" />
                                    <ObjectNumber number="{dashboardView>Quantity}" unit="{dashboardView>Unit}" />
                                    <Text text="{dashboardView>Unit}" />
                                    <Text text="{dashboardView>User}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

                <!-- 4c. Recent 301 Postings - Plant-to-Plant Transfer -->
                <Panel
                    id="panelRecent301"
                    expandable="false"
                    class="sapUiSmallMarginBottom">
                    <MessageStrip
                        visible="{= !!${dashboardView>/recent/301/error} }"
                        text="{dashboardView>/recent/301/error}"
                        type="Error"
                        showIcon="true"
                        class="sapUiSmallMarginBottom">
                        <link>
                            <Link text="{i18n>giRetryConnection}" press=".onRefresh" />
                        </link>
                    </MessageStrip>
                    <Table
                        id="tblRecent301"
                        busy="{dashboardView>/recent/301/loading}"
                        busyIndicatorDelay="0"
                        items="{dashboardView>/recent/301/items}"
                        noDataText="{i18n>giNoRecentPostingsFound}"
                        growing="true"
                        growingThreshold="25"
                        growingScrollToLoad="false"
                        class="sapUiSizeCompact">
                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="{= ${i18n>giRecent301SectionTitle} + ' (' + ${dashboardView>/recent/301/total} + ')' }" level="H4" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column width="8rem"><Text text="{i18n>giColMatDoc}" /></Column>
                            <Column width="7.5rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColPostingDate}" /></Column>
                            <Column><Text text="{i18n>giColMaterial}" /></Column>
                            <Column width="5rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giPlantLabel}" /></Column>
                            <Column width="5.5rem" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giSLocLabel}" /></Column>
                            <Column width="6.5rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColReceivingPlant}" /></Column>
                            <Column width="6.5rem" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColReceivingStorageLocation}" /></Column>
                            <Column width="6.5rem" hAlign="End"><Text text="{i18n>giColQty}" /></Column>
                            <Column width="4rem" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColUnit}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem type="Navigation" press=".onDocumentPress">
                                <cells>
                                    <ObjectIdentifier
                                        title="{dashboardView>MaterialDocument}"
                                        text="{= ${dashboardView>MaterialDocYear} ? 'FY ' + ${dashboardView>MaterialDocYear} : '' }" />
                                    <Text text="{dashboardView>PostingDate}" />
                                    <ObjectIdentifier title="{dashboardView>Material}" text="{dashboardView>MaterialDesc}" />
                                    <Text text="{dashboardView>Plant}" />
                                    <Text text="{dashboardView>StorageLocation}" />
                                    <Text text="{dashboardView>ReceivingPlant}" />
                                    <Text text="{dashboardView>ReceivingStorageLocation}" />
                                    <ObjectNumber number="{dashboardView>Quantity}" unit="{dashboardView>Unit}" />
                                    <Text text="{dashboardView>Unit}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

                <!-- 4d. Recent 311 Postings - Storage Location Transfer -->
                <Panel
                    id="panelRecent311"
                    expandable="false"
                    class="sapUiSmallMarginBottom">
                    <MessageStrip
                        visible="{= !!${dashboardView>/recent/311/error} }"
                        text="{dashboardView>/recent/311/error}"
                        type="Error"
                        showIcon="true"
                        class="sapUiSmallMarginBottom">
                        <link>
                            <Link text="{i18n>giRetryConnection}" press=".onRefresh" />
                        </link>
                    </MessageStrip>
                    <Table
                        id="tblRecent311"
                        busy="{dashboardView>/recent/311/loading}"
                        busyIndicatorDelay="0"
                        items="{dashboardView>/recent/311/items}"
                        noDataText="{i18n>giNoRecentPostingsFound}"
                        growing="true"
                        growingThreshold="25"
                        growingScrollToLoad="false"
                        class="sapUiSizeCompact">
                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="{= ${i18n>giRecent311SectionTitle} + ' (' + ${dashboardView>/recent/311/total} + ')' }" level="H4" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column width="8rem"><Text text="{i18n>giColMatDoc}" /></Column>
                            <Column width="7.5rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColPostingDate}" /></Column>
                            <Column><Text text="{i18n>giColMaterial}" /></Column>
                            <Column width="5rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giPlantLabel}" /></Column>
                            <Column width="5.5rem" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giSLocLabel}" /></Column>
                            <Column width="6.5rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColReceivingPlant}" /></Column>
                            <Column width="6.5rem" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColReceivingStorageLocation}" /></Column>
                            <Column width="6.5rem" hAlign="End"><Text text="{i18n>giColQty}" /></Column>
                            <Column width="4rem" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline"><Text text="{i18n>giColUnit}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem type="Navigation" press=".onDocumentPress">
                                <cells>
                                    <ObjectIdentifier
                                        title="{dashboardView>MaterialDocument}"
                                        text="{= ${dashboardView>MaterialDocYear} ? 'FY ' + ${dashboardView>MaterialDocYear} : '' }" />
                                    <Text text="{dashboardView>PostingDate}" />
                                    <ObjectIdentifier title="{dashboardView>Material}" text="{dashboardView>MaterialDesc}" />
                                    <Text text="{dashboardView>Plant}" />
                                    <Text text="{dashboardView>StorageLocation}" />
                                    <Text text="{dashboardView>ReceivingPlant}" />
                                    <Text text="{dashboardView>ReceivingStorageLocation}" />
                                    <ObjectNumber number="{dashboardView>Quantity}" unit="{dashboardView>Unit}" />
                                    <Text text="{dashboardView>Unit}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

            </VBox>
        </content>
    </Page>
</mvc:View>
