<mvc:View
    controllerName="saps4hana.fiori.modules.wm.goods-issue.controller.GoodsIssue311"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">

    <Page
        id="pageGoodsIssue311"
        busy="{gi311>/busy}"
        busyIndicatorDelay="0"
        class="sapUiSizeCompact">

        <headerContent>
            <ObjectStatus
                id="statMvtBadge311"
                text="{i18n>gi311MovementTypeBadge}"
                state="Information"
                icon="sap-icon://expense-report"
                class="sapUiTinyMarginEnd" />
        </headerContent>

        <content>
            <VBox class="sapUiResponsiveMargin">

                <!-- 1. Posted Document Success Banner (with Reversal Trigger) -->
                <MessageStrip
                    id="stripPostSuccess311"
                    text="{parts: [{path: 'gi311>/postedDocument'}, {path: 'gi311>/postedYear'}], formatter: '.formatSuccessBanner'}"
                    type="Success"
                    showIcon="true"
                    showCloseButton="false"
                    visible="{gi311>/hasPosted}"
                    class="sapUiSmallMarginBottom">
                    <link>
                        <Link
                            id="lnkReverse311"
                            text="{i18n>gi311ActionReverseNow}"
                            press=".onReverseGoodsIssue"
                            enabled="{= !${gi311>/reversalBusy} }" />
                    </link>
                </MessageStrip>

                <!-- 2. Reversal Success Banner -->
                <MessageStrip
                    id="stripReversalSuccess311"
                    text="{parts: [{path: 'gi311>/reversalDocument'}, {path: 'gi311>/reversalYear'}], formatter: '.formatReversalBanner'}"
                    type="Information"
                    showIcon="true"
                    showCloseButton="true"
                    visible="{gi311>/hasReversed}"
                    class="sapUiSmallMarginBottom" />

                <!-- 3. Form Container -->
                <Panel
                    id="pnlGeneralData311"
                    headerText="{i18n>gi311SectionGeneralData}"
                    expandable="false"
                    class="sapUiSmallMarginBottom">

                    <f:SimpleForm
                        id="formGoodsIssue311"
                        editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4"
                        labelSpanL="4"
                        labelSpanM="4"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="2"
                        columnsL="2"
                        columnsM="2"
                        singleContainerFullSize="false">
                        <f:content>

                            <!-- Reservation Assignment (Mandatory - no unplanned posting path exists) -->
                            <core:Title id="titleReservationAssignment311" text="{i18n>gi311TitleReservationAssignment}" />

                            <Label id="lblReservationNo311" text="{i18n>gi311ReservationNo}" required="true" />
                            <Input
                                id="inReservationNo311"
                                value="{gi311>/reservationNo}"
                                placeholder="{i18n>gi311ReservationNoPlaceholder}"
                                showValueHelp="{= !${gi311>/fromReservation} }"
                                valueHelpRequest=".onReservationValueHelp"
                                editable="false"
                                valueState="{= ${gi311>/errors/reservationNo} ? 'Error' : 'None' }"
                                valueStateText="{gi311>/errors/reservationNo}"
                                maxLength="10" />

                            <Label id="lblReservationItem311" text="{i18n>gi311ReservationItem}" required="true" />
                            <Input
                                id="inReservationItem311"
                                value="{gi311>/reservationItem}"
                                placeholder="{i18n>gi311ReservationItemPlaceholder}"
                                showValueHelp="{= !${gi311>/fromReservation} }"
                                valueHelpRequest=".onReservationValueHelp"
                                change=".onReservationItemChange"
                                editable="{= !${gi311>/fromReservation} }"
                                valueState="{= ${gi311>/errors/reservationItem} ? 'Error' : 'None' }"
                                valueStateText="{gi311>/errors/reservationItem}"
                                maxLength="4" />

                            <Label id="lblOrderNo311" text="{i18n>gi311OrderNo}" visible="{= !!${gi311>/orderNo} }" />
                            <Text
                                id="txtOrderNo311"
                                text="{gi311>/orderNo}"
                                class="sapUiTinyMarginTop fontBold"
                                visible="{= !!${gi311>/orderNo} }" />

                            <!-- Material & Location - read-only, derived from the resolved reservation item -->
                            <core:Title id="titleMaterialLocation311" text="{i18n>gi311TitleMaterialLocation}" />

                            <Label id="lblMaterial311" text="{i18n>gi311Material}" />
                            <Text id="txtMaterial311" text="{gi311>/material}" />

                            <Label id="lblMaterialDesc311" text="{i18n>gi311MaterialDesc}" visible="{= !!${gi311>/materialName} }" />
                            <Text
                                id="txtMaterialDesc311"
                                text="{gi311>/materialName}"
                                class="sapUiTinyMarginTop fontBold"
                                visible="{= !!${gi311>/materialName} }" />

                            <Label id="lblPlant311" text="{i18n>gi311Plant}" />
                            <Text id="txtPlant311" text="{gi311>/plant}" />

                            <Label id="lblStorageLocation311" text="{i18n>gi311StorageLocation}" required="{gi311>/isStorageLocationEditable}" />
                            <Text id="txtStorageLocation311" text="{gi311>/storageLocation}" visible="{= !${gi311>/isStorageLocationEditable} }" />
                            <Input
                                id="inStorageLocation311"
                                value="{gi311>/storageLocation}"
                                showValueHelp="true"
                                valueHelpRequest=".onStorageLocationValueHelp"
                                liveChange=".onFieldLiveChange"
                                valueState="{= ${gi311>/errors/storageLocation} ? 'Error' : 'None' }"
                                valueStateText="{gi311>/errors/storageLocation}"
                                maxLength="4"
                                visible="{gi311>/isStorageLocationEditable}" />

                            <!-- Receiving Plant / Storage Location (OPTIONAL - Transfer Posting) -->
                            <core:Title id="titleReceivingLocation311" text="{i18n>gi311TitleReceivingLocation}" />

                            <Label id="lblReceivingPlant311" text="{i18n>gi311ReceivingPlant}" />
                            <Input
                                id="inReceivingPlant311"
                                value="{gi311>/receivingPlant}"
                                editable="{= !${gi311>/prefilled/receivingPlant} }"
                                showValueHelp="{= !${gi311>/prefilled/receivingPlant} }"
                                valueHelpRequest=".onReceivingPlantValueHelp"
                                liveChange=".onFieldLiveChange"
                                valueState="{= ${gi311>/errors/receivingPlant} ? 'Error' : 'None' }"
                                valueStateText="{gi311>/errors/receivingPlant}"
                                maxLength="4" />

                            <Label id="lblReceivingStorageLocation311" text="{i18n>gi311ReceivingStorageLocation}" />
                            <Input
                                id="inReceivingStorageLocation311"
                                value="{gi311>/receivingStorageLocation}"
                                editable="{= !${gi311>/prefilled/receivingStorageLocation} }"
                                showValueHelp="{= !${gi311>/prefilled/receivingStorageLocation} }"
                                valueHelpRequest=".onReceivingStorageLocationValueHelp"
                                liveChange=".onFieldLiveChange"
                                valueState="{= ${gi311>/errors/receivingStorageLocation} ? 'Error' : 'None' }"
                                valueStateText="{gi311>/errors/receivingStorageLocation}"
                                maxLength="4" />

                            <!-- Quantity & Posting Dates -->
                            <core:Title id="titleQuantityDates311" text="{i18n>gi311TitleQuantityDates}" />

                            <Label id="lblQuantity311" text="{i18n>gi311Quantity}" required="true" />
                            <HBox id="boxQuantityUnit311" alignItems="Center">
                                <Input
                                    id="inQuantity311"
                                    value="{gi311>/quantity}"
                                    type="Number"
                                    liveChange=".onQuantityLiveChange"
                                    valueState="{= ${gi311>/errors/quantity} ? 'Error' : 'None' }"
                                    valueStateText="{gi311>/errors/quantity}"
                                    width="10rem"
                                    class="sapUiTinyMarginEnd" />
                                <Input
                                    id="inUnit311"
                                    value="{gi311>/unit}"
                                    editable="{gi311>/isUnitEditable}"
                                    liveChange=".onFieldLiveChange"
                                    valueState="{= ${gi311>/errors/unit} ? 'Error' : 'None' }"
                                    valueStateText="{gi311>/errors/unit}"
                                    width="6rem"
                                    maxLength="3" />
                            </HBox>

                            <Label id="lblPostingDate311" text="{i18n>gi311PostingDate}" required="true" />
                            <DatePicker
                                id="dpPostingDate311"
                                value="{gi311>/postingDate}"
                                valueFormat="yyyy-MM-dd"
                                displayFormat="medium"
                                change=".onFieldLiveChange"
                                valueState="{= ${gi311>/errors/postingDate} ? 'Error' : 'None' }"
                                valueStateText="{gi311>/errors/postingDate}" />

                            <Label id="lblDocumentDate311" text="{i18n>gi311DocumentDate}" required="true" />
                            <DatePicker
                                id="dpDocumentDate311"
                                value="{gi311>/documentDate}"
                                valueFormat="yyyy-MM-dd"
                                displayFormat="medium"
                                change=".onFieldLiveChange"
                                valueState="{= ${gi311>/errors/documentDate} ? 'Error' : 'None' }"
                                valueStateText="{gi311>/errors/documentDate}" />

                            <Label id="lblHeaderText311" text="{i18n>gi311HeaderText}" />
                            <Input
                                id="inHeaderText311"
                                value="{gi311>/headerText}"
                                placeholder="{i18n>gi311HeaderTextPlaceholder}"
                                maxLength="25" />

                            <!-- Conditional: Batch Management -->
                            <core:Title
                                id="titleBatchManagement311"
                                text="{i18n>gi311TitleBatchManagement}" />

                            <Label
                                id="lblBatch311"
                                text="{i18n>gi311Batch}"
                                required="{gi311>/isBatchManaged}"
                                visible="{gi311>/isBatchManaged}" />
                            <Input
                                id="inBatch311"
                                value="{gi311>/batch}"
                                editable="{= !${gi311>/prefilled/batch} }"
                                placeholder="{i18n>gi311BatchPlaceholder}"
                                liveChange=".onFieldLiveChange"
                                valueState="{= ${gi311>/errors/batch} ? 'Error' : 'None' }"
                                valueStateText="{gi311>/errors/batch}"
                                visible="{gi311>/isBatchManaged}"
                                maxLength="10" />

                        </f:content>
                    </f:SimpleForm>
                </Panel>

                <!-- 4. Storage Unit (SU) Management & Suggested Scan -->
                <Panel
                    id="pnlStorageUnit311"
                    headerText="{i18n>gi311TitleSuggestedSU}"
                    expandable="false"
                    visible="{= ${gi311>/hasSuggestedSU} || (${gi311>/storageUnits} &amp;&amp; ${gi311>/storageUnits}.length > 0) || !!${gi311>/selectedStorageUnit} }"
                    class="sapUiSmallMarginBottom">

                    <VBox class="sapUiSmallMargin">
                        <!-- Suggested SU Highlight Box -->
                        <HBox
                            id="boxSuggestedSUHighlight311"
                            alignItems="Center"
                            justifyContent="SpaceBetween"
                            visible="{gi311>/hasSuggestedSU}"
                            class="sapUiSmallMarginBottom sapUiTinyMarginTop"
                            wrap="Wrap">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://palette" size="1.8rem" color="#0854a0" class="sapUiSmallMarginEnd" />
                                <VBox>
                                    <Label text="{i18n>gi311SuggestedSUDesc}" design="Bold" />
                                    <HBox alignItems="Center">
                                        <Title id="txtSuggestedSUNumber311" text="{gi311>/suggestedStorageUnit}" level="H3" class="sapUiTinyMarginEnd" />
                                        <ObjectStatus text="{i18n>gi311BadgeSuggested}" state="Success" icon="sap-icon://accept" />
                                    </HBox>
                                </VBox>
                            </HBox>
                            <Button
                                id="btnUseSuggestedSU311"
                                text="{i18n>gi311BtnUseSuggestedSU}"
                                icon="sap-icon://accept"
                                type="Emphasized"
                                press=".onUseSuggestedSU" />
                        </HBox>

                        <!-- Scan / Input Section -->
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom" wrap="Wrap">
                            <Input
                                id="inSuScan311"
                                value="{gi311>/suScanInput}"
                                placeholder="{i18n>gi311SuScanPlaceholder}"
                                submit=".onScanStorageUnitSubmit"
                                liveChange=".onScanStorageUnit"
                                width="18rem"
                                maxLength="20"
                                class="sapUiTinyMarginEnd" />
                            <Button
                                id="btnScanSU311"
                                text="{i18n>gi311BtnScanSU}"
                                icon="sap-icon://bar-code"
                                press=".onScanStorageUnit"
                                class="sapUiTinyMarginEnd" />
                            <Button
                                id="btnClearSU311"
                                text="{i18n>gi311BtnClearSU}"
                                icon="sap-icon://clear-filter"
                                type="Transparent"
                                press=".onClearSelectedSU"
                                visible="{= !!${gi311>/selectedStorageUnit} }"
                                class="sapUiTinyMarginEnd" />
                            <ObjectStatus
                                id="statSelectedSU311"
                                text="{= ${gi311>/selectedStorageUnit} ? (${i18n>gi311SelectedSU} + ': ' + ${gi311>/selectedStorageUnit}) : ${i18n>gi311NoSUSelected} }"
                                state="{= ${gi311>/selectedStorageUnit} ? 'Success' : 'None' }" />
                        </HBox>

                        <!-- Scan Feedback Message Strip -->
                        <MessageStrip
                            id="stripSuScan311"
                            text="{gi311>/suScanText}"
                            type="{gi311>/suScanState}"
                            showIcon="true"
                            visible="{= !!${gi311>/suScanText} }"
                            class="sapUiTinyMarginBottom" />

                        <!-- Available Candidate Storage Units Table -->
                        <Table
                            id="tblStorageUnits311"
                            items="{gi311>/storageUnits}"
                            noDataText="{i18n>gi311NoStockUnitsAvailable}"
                            growing="true"
                            growingThreshold="20"
                            width="100%">
                            <headerToolbar>
                                <OverflowToolbar>
                                    <Title text="{i18n>gi311AvailableSUsTitle}" level="H4" />
                                    <ToolbarSpacer />
                                </OverflowToolbar>
                            </headerToolbar>
                            <columns>
                                <Column id="colSU311">
                                    <Text text="{i18n>gi311ColSU}" />
                                </Column>
                                <Column id="colStorageTypeBin311">
                                    <Text text="{i18n>gi311ColStorageTypeBin}" />
                                </Column>
                                <Column id="colAvailableStock311" hAlign="End">
                                    <Text text="{i18n>gi311ColAvailableStock}" />
                                </Column>
                                <Column id="colGrDate311">
                                    <Text text="{i18n>gi311ColGrDate}" />
                                </Column>
                                <Column id="colSUStatus311">
                                    <Text text="{i18n>gi311ColStatus}" />
                                </Column>
                                <Column id="colSUAction311" width="6rem" hAlign="End">
                                    <Text text="{i18n>gi311ColAction}" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem highlight="{= ${gi311>StorageUnit} === ${gi311>/selectedStorageUnit} ? 'Success' : (${gi311>Suggested} ? 'Information' : 'None') }">
                                    <cells>
                                        <Text text="{gi311>StorageUnit}" class="fontBold" />
                                        <Text text="{parts: [{path: 'gi311>StorageType'}, {path: 'gi311>StorageBin'}], formatter: '.formatStorageTypeBin'}" />
                                        <Text text="{gi311>AvailableStock} {gi311>Unit}" />
                                        <Text text="{gi311>GrDate}" />
                                        <ObjectStatus
                                            text="{= ${gi311>Suggested} ? ${i18n>gi311BadgeSuggested} : '' }"
                                            state="Success"
                                            icon="{= ${gi311>Suggested} ? 'sap-icon://accept' : '' }" />
                                        <Button
                                            text="{i18n>gi311BtnSelectSU}"
                                            type="{= ${gi311>StorageUnit} === ${gi311>/selectedStorageUnit} ? 'Emphasized' : 'Transparent' }"
                                            press=".onSelectStorageUnitRow" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </Panel>

                <!-- 5. Conditional: Serial Numbers Management -->
                <Panel
                    id="pnlSerialManagement311"
                    headerText="{i18n>gi311TitleSerialManagement}"
                    expandable="false"
                    visible="{gi311>/isSerialManaged}"
                    class="sapUiSmallMarginBottom">

                    <VBox class="sapUiSmallMargin">
                        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                            <Input
                                id="inSerialScan311"
                                editable="{= !${gi311>/serialVerifying} }"
                                value="{gi311>/serialInput}"
                                placeholder="{i18n>gi311SerialScanPlaceholder}"
                                submit=".onSerialInputSubmit"
                                showValueHelp="true"
                                valueHelpRequest=".onSerialValueHelp"
                                width="18rem"
                                maxLength="18"
                                class="sapUiTinyMarginEnd" />
                            <Button
                                id="btnAddSerial311"
                                busy="{gi311>/serialVerifying}"
                                busyIndicatorDelay="0"
                                text="{i18n>gi311BtnAddSerial}"
                                icon="sap-icon://bar-code"
                                press=".onAddSerialPress"
                                class="sapUiTinyMarginEnd" />
                            <Button
                                id="btnSerialHelp311"
                                icon="sap-icon://value-help"
                                tooltip="{i18n>gi311BtnAvailableSerials}"
                                press=".onSerialValueHelp"
                                class="sapUiTinyMarginEnd" />
                            <ObjectStatus
                                id="statSerialCount311"
                                text="{= ${gi311>/serialNumbers}.length + ' / ' + ${gi311>/quantity} + ' ' + ${i18n>gi311SerialsScanned} }"
                                state="{= ${gi311>/serialNumbers}.length === ${gi311>/quantity} ? 'Success' : 'Warning' }" />
                        </HBox>

                        <MessageStrip
                            id="stripSerialScan311"
                            text="{gi311>/serialScanText}"
                            type="{gi311>/serialScanState}"
                            showIcon="true"
                            visible="{= !!${gi311>/serialScanText} }"
                            class="sapUiTinyMarginBottom" />

                        <Text
                            id="txtSerialError311"
                            text="{gi311>/errors/serials}"
                            class="sapUiTinyMarginBottom"
                            visible="{= !!${gi311>/errors/serials} }" />

                        <Table
                            id="tblSerialNumbers311"
                            items="{gi311>/serialNumbers}"
                            noDataText="{i18n>gi311NoSerialsScanned}"
                            width="100%">
                            <columns>
                                <Column id="colSerialIndex311" width="4rem"><Text text="#" /></Column>
                                <Column id="colSerialNumber311"><Text text="{i18n>gi311ColSerialNumber}" /></Column>
                                <Column id="colSerialStatus311" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" width="10rem"><Text text="{i18n>gi311ColSerialStatus}" /></Column>
                                <Column id="colSerialAction311" width="4rem" hAlign="End"><Text text="" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{= ${path: ''} ? '' : '' }" />
                                        <Text text="{gi311>}" class="fontBold" />
                                        <ObjectStatus
                                            text="{parts: [{path: 'gi311>'}, {path: 'gi311>/serialStatus'}], formatter: '.formatSerialStatusText'}"
                                            state="{parts: [{path: 'gi311>'}, {path: 'gi311>/serialStatus'}], formatter: '.formatSerialStatusState'}" />
                                        <Button
                                            icon="sap-icon://delete"
                                            type="Transparent"
                                            tooltip="{i18n>gi311BtnDeleteSerial}"
                                            press=".onDeleteSerial" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </Panel>

            </VBox>
        </content>

        <!-- Footer Actions -->
        <footer>
            <Toolbar id="tbGoodsIssue311">
                <Button
                    id="btnResetForm311"
                    text="{i18n>gi311BtnReset}"
                    icon="sap-icon://refresh"
                    type="Transparent"
                    press=".onResetForm" />
                <ToolbarSpacer />
                <Button
                    id="btnPostGoodsIssue311"
                    text="{= ${gi311>/fromReservation} ? ${i18n>gi311BtnComplete} : ${i18n>gi311BtnPost} }"
                    icon="{= ${gi311>/fromReservation} ? 'sap-icon://accept' : 'sap-icon://save' }"
                    type="Emphasized"
                    enabled="{gi311>/isValid}"
                    press=".onPostGoodsIssue" />
            </Toolbar>
        </footer>

    </Page>
</mvc:View>
