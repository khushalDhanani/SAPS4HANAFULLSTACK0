<mvc:View
    controllerName="saps4hana.fiori.modules.wm.goods-issue.controller.GoodsIssue261Pending"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page
        id="pageGi261Pending"
        title="{i18n>gi261OpenResvTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack">
        <content>
            <MessageStrip
                id="msPending261Result"
                text="{gi261p>/resultText}"
                type="{= ${gi261p>/resultState} === 'None' ? 'Information' : ${gi261p>/resultState} }"
                showIcon="true"
                showCloseButton="true"
                close=".onCloseResult"
                class="sapUiSmallMargin"
                visible="{= !!${gi261p>/resultText} }" />

            <MessageStrip
                id="msPending261Error"
                text="{gi261p>/error}"
                type="Error"
                showIcon="true"
                showCloseButton="true"
                class="sapUiSmallMargin"
                visible="{= !!${gi261p>/error} }" />

            <Table
                id="tblPending261"
                items="{gi261p>/items}"
                busy="{gi261p>/busy}"
                growing="true"
                growingThreshold="50"
                noDataText="{i18n>gi261OpenResvNoData}"
                itemPress=".onOpenReservation"
                class="sapUiResponsiveMargin"
                width="auto">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title id="ttlPending261" text="{= ${i18n>gi261OpenResvListTitle} + ' (' + (${gi261p>/items}.length || 0) + ')' }" level="H2" />
                        <ToolbarSpacer />
                        <Button id="btnPending261Refresh" icon="sap-icon://refresh" tooltip="{i18n>gi261OpenResvRefresh}" press=".onRefresh" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column id="colPendingResv"><Text text="{i18n>gi261OpenResvColReservation}" /></Column>
                    <Column id="colPendingOrder"><Text text="{i18n>gi261OpenResvColOrder}" /></Column>
                    <Column id="colPendingMaterial"><Text text="{i18n>gi261OpenResvColMaterial}" /></Column>
                    <Column id="colPendingPlant" hAlign="Begin"><Text text="{i18n>gi261OpenResvColPlant}" /></Column>
                    <Column id="colPendingItems" hAlign="End"><Text text="{i18n>gi261OpenResvColItems}" /></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onOpenReservation">
                        <cells>
                            <ObjectIdentifier title="{gi261p>ReservationNo}" text="{gi261p>MovementTypeName}" />
                            <Text text="{= ${gi261p>OrderNo} ? ${gi261p>OrderNo} : '-' }" />
                            <VBox>
                                <Text text="{gi261p>SampleMaterial}" />
                                <Text text="{gi261p>SampleMaterialDesc}" class="sapUiTinyMarginTop" />
                            </VBox>
                            <Text text="{gi261p>Plant}" />
                            <ObjectNumber number="{gi261p>ItemCount}" unit="{i18n>gi261OpenResvItemsUnit}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
