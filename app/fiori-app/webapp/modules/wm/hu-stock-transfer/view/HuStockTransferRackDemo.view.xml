<mvc:View
    controllerName="saps4hana.fiori.modules.wm.hu-stock-transfer.controller.HuStockTransferRackDemo"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <Page id="huStockTransferRackDemoPage" title="DEMO — Synthetic Rack Layout Preview" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <VBox class="sapUiResponsiveContentPadding">
                <MessageStrip
                    id="demoNoticeStrip"
                    text="DEMO MODE — Synthetic Rack Layout Preview: Single row of positions (floor 1, rack L0001, positions 01-05; no bays or levels). All handling unit numbers (DEMO-HU-*) are synthetic demo data."
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom" />

                <OverflowToolbar class="rackPositionToolbar">
                    <Title text="Rack L0001 (Floor 1)" level="H2" />
                    <ToolbarSpacer />
                    <Label text="Warehouse" />
                    <Select width="6rem" selectedKey="{demoRack>/warehouse}" enabled="false">
                        <core:Item key="W01" text="W01" />
                    </Select>
                    <Text text="›" class="rackBreadcrumbSeparator" />
                    <Label text="Floor" />
                    <Select width="6rem" selectedKey="{demoRack>/floor}" enabled="false">
                        <core:Item key="1" text="Floor 1" />
                    </Select>
                    <Text text="›" class="rackBreadcrumbSeparator" />
                    <Label text="Rack" />
                    <Select width="8rem" selectedKey="{demoRack>/rack}" enabled="false">
                        <core:Item key="L0001" text="Rack L0001" />
                    </Select>
                    <ToolbarSpacer />
                    <Button
                        text="{= ${demoRack>/mode} === 'rack' ? 'Table Mode' : 'Position Grid' }"
                        icon="{= ${demoRack>/mode} === 'rack' ? 'sap-icon://table-view' : 'sap-icon://grid' }"
                        press=".onToggleMode" />
                </OverflowToolbar>

                <!-- Single horizontal row of positions (Floor / Rack / Position; no bays, no levels) -->
                <ScrollContainer
                    horizontal="true"
                    vertical="false"
                    visible="{= ${demoRack>/mode} === 'rack' }"
                    class="rackPositionGroups sapUiSmallMarginTopBottom">
                    <HBox items="{demoRack>/positions}" wrap="NoWrap" class="rackPositionGrid">
                        <items>
                            <VBox class="rackPositionCard" width="13rem">
                                <Title text="{= 'Position ' + ${demoRack>position} }" level="H3" class="rackPositionTitle" />
                                <Text text="{demoRack>storageBin}" class="rackPositionBin" />
                                <ObjectStatus
                                    text="{= ${demoRack>occupied} ? 'Occupied' : 'Empty' }"
                                    state="{= ${demoRack>occupied} ? 'Success' : 'None' }"
                                    class="sapUiTinyMarginTopBottom" />
                                <Text text="{demoRack>sectionDisplay}" class="rackPositionSection" />

                                <VBox visible="{demoRack>occupied}" class="sapUiTinyMarginTop">
                                    <Button
                                        text="{demoRack>unitNumber}"
                                        type="Emphasized"
                                        press=".onSelectUnit"
                                        tooltip="Click to inspect synthetic demo HU" />
                                    <Text text="{demoRack>materialDesc}" class="sapUiTinyMarginTop" />
                                    <Text text="{= 'Stock: ' + ${demoRack>availableStock} + ' ' + ${demoRack>baseUnit} }" />
                                </VBox>
                                <VBox visible="{= !${demoRack>occupied} }" class="sapUiTinyMarginTop">
                                    <Text text="No Handling Unit" class="sapUiAnnotationText" />
                                </VBox>
                            </VBox>
                        </items>
                    </HBox>
                </ScrollContainer>

                <!-- Non-rack storage bins (DEMO) -->
                <Panel headerText="Non-Rack Staging Bins (DEMO)" expandable="true" expanded="true" visible="{= ${demoRack>/mode} === 'rack' }">
                    <Table items="{demoRack>/nonRackBins}" noDataText="No non-rack bins">
                        <columns>
                            <Column><Text text="Bin" /></Column>
                            <Column><Text text="Storage Type" /></Column>
                            <Column><Text text="Demo Handling Unit" /></Column>
                            <Column><Text text="Material" /></Column>
                            <Column hAlign="End"><Text text="Stock" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{demoRack>storageBin}" />
                                    <Text text="{= ${demoRack>storageType} + ' ' + ${demoRack>storageTypeDesc} }" />
                                    <Button text="{demoRack>unitNumber}" type="Transparent" press=".onSelectUnit" />
                                    <Text text="{demoRack>material}" />
                                    <ObjectNumber number="{demoRack>availableStock}" unit="{demoRack>baseUnit}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

                <!-- Table Mode -->
                <Table
                    id="demoRackTable"
                    visible="{= ${demoRack>/mode} === 'table' }"
                    items="{demoRack>/positions}"
                    noDataText="No positions">
                    <columns>
                        <Column width="6rem"><Text text="Position" /></Column>
                        <Column width="9rem"><Text text="Bin" /></Column>
                        <Column width="6rem"><Text text="Status" /></Column>
                        <Column><Text text="Section" /></Column>
                        <Column><Text text="Demo HU" /></Column>
                        <Column><Text text="Material" /></Column>
                        <Column hAlign="End"><Text text="Stock" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{demoRack>position}" />
                                <Text text="{demoRack>storageBin}" />
                                <ObjectStatus
                                    text="{= ${demoRack>occupied} ? 'Occupied' : 'Empty' }"
                                    state="{= ${demoRack>occupied} ? 'Success' : 'None' }" />
                                <Text text="{demoRack>sectionDisplay}" />
                                <Text text="{demoRack>unitNumber}" />
                                <Text text="{demoRack>materialDesc}" />
                                <ObjectNumber number="{demoRack>availableStock}" unit="{demoRack>baseUnit}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>
