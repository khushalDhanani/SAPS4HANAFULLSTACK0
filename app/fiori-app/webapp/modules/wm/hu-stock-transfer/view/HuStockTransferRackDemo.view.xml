<mvc:View
    controllerName="saps4hana.fiori.modules.wm.hu-stock-transfer.controller.HuStockTransferRackDemo"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <Page id="huStockTransferRackDemoPage">
        <content>
            <VBox class="sapUiResponsiveContentPadding">
                <MessageStrip
                    id="demoNoticeStrip"
                    text="{i18n>demoRackNotice}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom" />

                <OverflowToolbar class="rackPositionToolbar">
                    <Title text="{i18n>demoRackRackTitle}" level="H2" />
                    <ToolbarSpacer />
                    <Label text="{i18n>demoRackWarehouse}" />
                    <Select width="6rem" selectedKey="{demoRack>/warehouse}" enabled="false">
                        <core:Item key="W01" text="{demoRack>/warehouse}" />
                    </Select>
                    <Text text="›" class="rackBreadcrumbSeparator" />
                    <Label text="{i18n>demoRackFloor}" />
                    <Select width="6rem" selectedKey="{demoRack>/floor}" enabled="false">
                        <core:Item key="1" text="{i18n>demoRackFloor1}" />
                    </Select>
                    <Text text="›" class="rackBreadcrumbSeparator" />
                    <Label text="{i18n>demoRackRack}" />
                    <Select width="8rem" selectedKey="{demoRack>/rack}" enabled="false">
                        <core:Item key="L0001" text="{i18n>demoRackRackL0001}" />
                    </Select>
                    <ToolbarSpacer />
                    <Button
                        text="{= ${demoRack>/mode} === 'rack' ? ${i18n>demoRackTableMode} : ${i18n>demoRackPositionGrid} }"
                        icon="{= ${demoRack>/mode} === 'rack' ? 'sap-icon://table-view' : 'sap-icon://grid' }"
                        press=".onToggleMode" />
                </OverflowToolbar>

                <!-- Single horizontal row of positions (Floor / Rack / Position; no bays, no levels) -->
                <ScrollContainer
                    horizontal="true"
                    vertical="false"
                    visible="{= ${demoRack>/mode} === 'rack' }"
                    class="rackPositionGroups sapUiSmallMarginTopBottom">
                    <HBox items="{demoRack>/positions}" wrap="NoWrap" class="rackPositionGrid">
                        <items>
                            <VBox class="rackPositionCard" width="13rem">
                                <Title text="{= 'Position ' + ${demoRack>position} }" level="H3" class="rackPositionTitle" />
                                <Text text="{demoRack>storageBin}" class="rackPositionBin" />
                                <ObjectStatus
                                    text="{= ${demoRack>occupied} ? ${i18n>demoRackOccupied} : ${i18n>demoRackEmpty} }"
                                    state="{= ${demoRack>occupied} ? 'Success' : 'None' }"
                                    class="sapUiTinyMarginTopBottom" />
                                <Text text="{demoRack>sectionDisplay}" class="rackPositionSection" />

                                <VBox visible="{demoRack>occupied}" class="sapUiTinyMarginTop">
                                    <Button
                                        text="{demoRack>unitNumber}"
                                        type="Emphasized"
                                        press=".onSelectUnit"
                                        tooltip="{i18n>demoRackUnitTooltip}" />
                                    <Text text="{demoRack>materialDesc}" class="sapUiTinyMarginTop" />
                                    <Text text="{= 'Stock: ' + ${demoRack>availableStock} + ' ' + ${demoRack>baseUnit} }" />
                                </VBox>
                                <VBox visible="{= !${demoRack>occupied} }" class="sapUiTinyMarginTop">
                                    <Text text="{i18n>demoRackNoHandlingUnit}" class="sapUiAnnotationText" />
                                </VBox>
                            </VBox>
                        </items>
                    </HBox>
                </ScrollContainer>

                <!-- Non-rack storage bins (DEMO) -->
                <Panel headerText="{i18n>demoRackNonRackPanel}" expandable="true" expanded="true" visible="{= ${demoRack>/mode} === 'rack' }">
                    <Table items="{demoRack>/nonRackBins}" noDataText="{i18n>demoRackNoNonRackBins}">
                        <columns>
                            <Column><Text text="{i18n>demoRackColBin}" /></Column>
                            <Column><Text text="{i18n>demoRackColStorageType}" /></Column>
                            <Column><Text text="{i18n>demoRackColDemoHU}" /></Column>
                            <Column><Text text="{i18n>demoRackColMaterial}" /></Column>
                            <Column hAlign="End"><Text text="{i18n>demoRackColStock}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{demoRack>storageBin}" />
                                    <Text text="{= ${demoRack>storageType} + ' ' + ${demoRack>storageTypeDesc} }" />
                                    <Button text="{demoRack>unitNumber}" type="Transparent" press=".onSelectUnit" />
                                    <Text text="{demoRack>material}" />
                                    <ObjectNumber number="{demoRack>availableStock}" unit="{demoRack>baseUnit}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

                <!-- Table Mode -->
                <Table
                    id="demoRackTable"
                    visible="{= ${demoRack>/mode} === 'table' }"
                    items="{demoRack>/positions}"
                    noDataText="{i18n>demoRackNoPositions}">
                    <columns>
                        <Column width="6rem"><Text text="{i18n>demoRackColPosition}" /></Column>
                        <Column width="9rem"><Text text="{i18n>demoRackColBin}" /></Column>
                        <Column width="6rem"><Text text="{i18n>demoRackColStatus}" /></Column>
                        <Column><Text text="{i18n>demoRackColSection}" /></Column>
                        <Column><Text text="{i18n>demoRackColDemoHU}" /></Column>
                        <Column><Text text="{i18n>demoRackColMaterial}" /></Column>
                        <Column hAlign="End"><Text text="{i18n>demoRackColStock}" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{demoRack>position}" />
                                <Text text="{demoRack>storageBin}" />
                                <ObjectStatus
                                    text="{= ${demoRack>occupied} ? ${i18n>demoRackOccupied} : ${i18n>demoRackEmpty} }"
                                    state="{= ${demoRack>occupied} ? 'Success' : 'None' }" />
                                <Text text="{demoRack>sectionDisplay}" />
                                <Text text="{demoRack>unitNumber}" />
                                <Text text="{demoRack>materialDesc}" />
                                <ObjectNumber number="{demoRack>availableStock}" unit="{demoRack>baseUnit}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>
