<mvc:View
    controllerName="saps4hana.fiori.modules.wm.hu-stock-transfer.controller.HuStockTransferRackDemo"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true">
    <Page id="huStockTransferRackReservationPage" busy="{rackReservation>/busy}" busyIndicatorDelay="0">
        <content>
            <VBox class="sapUiResponsiveContentPadding">
                <Title text="{i18n>rackReservationPageTitle}" level="H1" class="sapUiSmallMarginBottom" />
                <MessageStrip text="{i18n>rackReservationPageIntro}" type="Information" showIcon="true" class="sapUiSmallMarginBottom" />
                <MessageStrip
                    text="{rackReservation>/error}"
                    type="Error"
                    showIcon="true"
                    visible="{= !!${rackReservation>/error} }"
                    class="sapUiSmallMarginBottom" />
                <Button
                    text="{i18n>rackReservationRetry}"
                    icon="sap-icon://refresh"
                    press=".onRetry"
                    visible="{= !!${rackReservation>/error} }"
                    class="sapUiSmallMarginBottom" />
                <Table
                    id="rackReservationTable"
                    items="{path: 'rackReservation>/filteredReservations'}"
                    mode="SingleSelectMaster"
                    itemPress=".onReservationPress"
                    selectionChange=".onReservationSelectionChange"
                    noDataText="{i18n>rackReservationNoData}"
                    growing="true"
                    growingThreshold="20"
                    ariaLabelledBy="rackReservationTitle">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title id="rackReservationTitle" text="{i18n>rackReservationTableTitle}" level="H2" />
                            <ToolbarSpacer />
                            <SearchField
                                width="18rem"
                                placeholder="{i18n>rackReservationSearchPlaceholder}"
                                liveChange=".onSearchReservations"
                                search=".onSearchReservations" />
                            <Button
                                text="{i18n>rackReservationOpenRack}"
                                icon="sap-icon://product"
                                type="Emphasized"
                                press=".onOpenSelectedRack"
                                enabled="{= !!${rackReservation>/selectedReservation} }" />
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column width="8rem"><Text text="{i18n>huTransferColReservation}" /></Column>
                        <Column width="4rem" hAlign="Center"><Text text="{i18n>huTransferColItem}" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>huTransferColMaterial}" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>huTransferColSlocRoute}" /></Column>
                        <Column hAlign="End"><Text text="{i18n>huTransferColOpenQty}" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>huTransferColRequester}" /></Column>
                        <Column><Text text="{i18n>huTransferColStatus}" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Navigation">
                            <cells>
                                <ObjectIdentifier title="{rackReservation>ReservationNo}" />
                                <Text text="{rackReservation>ReservationItem}" />
                                <ObjectIdentifier title="{rackReservation>Material}" text="{rackReservation>MaterialDesc}" />
                                <Text text="{rackReservation>StorageLocation} → {rackReservation>ReceivingStorageLocation}" />
                                <ObjectNumber number="{rackReservation>OpenQty}" unit="{rackReservation>BaseUnit}" />
                                <Text text="{rackReservation>RequesterName}" />
                                <ObjectStatus text="{rackReservation>StatusText}" state="{rackReservation>StatusState}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>
