<mvc:View
    controllerName="saps4hana.fiori.modules.wm.hu-stock-transfer.controller.HuStockTransferRack"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page
        id="huStockBinsPage"
        busy="{rackView>/busy}"
        busyIndicatorDelay="0">
        <content>
            <VBox class="sapUiResponsiveContentPadding">
                <ObjectHeader
                    title="{= ${rackView>/reservationNo} + ' / ' + ${rackView>/reservationItem} }"
                    intro="{i18n>huTransferSelectUnitIntro}"
                    responsive="true" />

                <MessageStrip
                    text="{rackView>/error}"
                    type="Error"
                    showIcon="true"
                    visible="{= !!${rackView>/error} }"
                    class="sapUiSmallMarginBottom" />

                <Button
                    text="{i18n>rackRetryButton}"
                    icon="sap-icon://refresh"
                    visible="{= !!${rackView>/error} }"
                    press=".onRetryLoad"
                    class="sapUiSmallMarginBottom" />

                <Table
                    id="huStockBinsTable"
                    items="{path: 'rackView>/filteredBins'}"
                    noDataText="{i18n>storageBinsNoData}"
                    growing="true"
                    growingScrollToLoad="true">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="{i18n>storageBinsTableTitle}" level="H2" />
                            <ToolbarSpacer />
                            <SearchField
                                width="18rem"
                                placeholder="{i18n>rackTableGridSearchPlaceholder}"
                                liveChange=".onSearchBins"
                                search=".onSearchBins" />
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column><Text text="{i18n>storageBinsColUnit}" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>storageBinsColBin}" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>storageBinsColType}" /></Column>
                        <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>storageBinsColSut}" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>storageBinsColBatch}" /></Column>
                        <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>rackColSerial}" /></Column>
                        <Column hAlign="End"><Text text="{i18n>storageBinsColStock}" /></Column>
                        <Column hAlign="End"><Text text="{i18n>rackColAction}" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <ObjectIdentifier title="{= ${rackView>UnitCategory} === 'BIN' ? '' : ${rackView>UnitNumber} }" text="{rackView>UnitCategory}" />
                                <Text text="{rackView>StorageBin}" />
                                <Text text="{= ${rackView>StorageType} + (${rackView>StorageTypeDesc} ? ' · ' + ${rackView>StorageTypeDesc} : '') }" />
                                <Text text="{= ${rackView>SutCode} + (${rackView>SutDescription} ? ' · ' + ${rackView>SutDescription} : '') }" />
                                <Text text="{rackView>Batch}" />
                                <Text text="{rackView>SerialNumber}" />
                                <ObjectNumber number="{rackView>AvailableStock}" unit="{rackView>BaseUnit}" />
                                <Button
                                    text="{i18n>rackSelectUnitButton}"
                                    type="Emphasized"
                                    press=".onSelectBinUnit"
                                    enabled="{= !!${rackView>UnitNumber} &amp;&amp; (${rackView>UnitCategory} === 'HU' || ${rackView>UnitCategory} === 'SU' || ${rackView>UnitCategory} === 'BIN') }" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>
