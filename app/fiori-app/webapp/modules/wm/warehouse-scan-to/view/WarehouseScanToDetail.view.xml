<mvc:View
    controllerName="saps4hana.fiori.modules.wm.warehouse-scan-to.controller.WarehouseScanToDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true">

    <Page
        id="warehouseScanToDetailPage"
        class="sapUiSizeCompact">

        <headerContent>
            <HBox alignItems="Center" class="sapUiTinyMarginEnd">
                <Label text="{i18n>scanToAutoConfirmLabel}" class="sapUiTinyMarginEnd" design="Bold" />
                <Switch
                    id="switchAutoConfirm"
                    state="{scanView>/autoConfirm}"
                    customTextOn="{i18n>commonYes}"
                    customTextOff="{i18n>commonNo}"
                    change=".onAutoConfirmChange"
                    class="sapUiSmallMarginEnd" />
                <Label text="{i18n>scanToAutoMigoLabel}" class="sapUiTinyMarginEnd" design="Bold" />
                <Switch
                    id="switchAutoMigo"
                    state="{scanView>/autoPostMigo}"
                    customTextOn="{i18n>commonYes}"
                    customTextOff="{i18n>commonNo}"
                    change=".onAutoMigoChange"
                    class="sapUiSmallMarginEnd" />
                <CheckBox
                    id="chkCompleteReservation"
                    text="{i18n>scanToCompleteReservationLabel}"
                    selected="{scanView>/completeReservation}"
                    class="sapUiSmallMarginEnd" />
                <Button
                    id="btnToggleAudio"
                    icon="{= ${scanView>/audioEnabled} ? 'sap-icon://sound' : 'sap-icon://sound-off' }"
                    tooltip="{i18n>scanToTooltipToggleAudio}"
                    type="Transparent"
                    press=".onToggleAudio" />
            </HBox>
        </headerContent>

        <content>
            <VBox class="sapUiResponsiveMargin" width="auto">

                <!-- STATUS MESSAGE BANNER -->
                <MessageStrip
                    id="detailMessageStrip"
                    visible="{scanView>/hasMessage}"
                    text="{scanView>/messageText}"
                    type="{scanView>/messageType}"
                    showIcon="true"
                    showCloseButton="true"
                    close=".onCloseMessage"
                    class="sapUiSmallMarginBottom" />

                <!-- SECTION 2: SUCCESS OUTCOME BANNER (IF TO POSTED) -->
                <Panel
                    id="panelResult"
                    headerText="{i18n>scanToPanelResultTitle}"
                    visible="{scanView>/hasResult}"
                    expandable="false"
                    class="sapUiSmallMarginBottom">
                    <VBox class="sapUiSmallMargin">
                        <MessageStrip
                            type="{= ${scanView>/result/Status} === '90' ? 'Warning' : (${scanView>/result/Status} === '13' ? 'Error' : 'Success') }"
                            text="{scanView>/resultMessage}"
                            showIcon="true"
                            class="sapUiSmallMarginBottom" />

                        <form:SimpleForm
                            editable="false"
                            layout="ResponsiveGridLayout"
                            labelSpanXL="4"
                            labelSpanL="4"
                            labelSpanM="4"
                            labelSpanS="12"
                            adjustLabelSpan="false"
                            emptySpanXL="0"
                            emptySpanL="0"
                            emptySpanM="0"
                            emptySpanS="0"
                            columnsXL="2"
                            columnsL="2"
                            columnsM="2">
                            <form:content>
                                <core:Title text="{i18n>scanToResultSectionTO}" />
                                <Label text="{i18n>scanToLabelTO}" design="Bold" />
                                <Text text="{scanView>/result/TransferOrder}" />

                                <Label text="{i18n>scanToResultLabelTrRes}" design="Bold" />
                                <Text text="{scanView>/result/TransferRequirement}{= (${scanView>/result/ReservationNo} &amp;&amp; ${scanView>/result/ReservationNo} !== '0') ? ' / Res: ' + ${scanView>/result/ReservationNo} : '' }" />

                                <Label text="{i18n>scanToLabelStatus}" design="Bold" />
                                <ObjectStatus
                                    text="{= ${scanView>/result/StatusText} || (${scanView>/result/Status} === '05' ? 'Goods Issue Posted' : (${scanView>/result/Status} === '04' ? 'TO Confirmed' : (${scanView>/result/Status} === '90' ? 'Goods Issue Error' : (${scanView>/result/Status} === '13' ? 'TO Confirmation Error' : 'TO Created')))) }"
                                    state="{= (${scanView>/result/Confirmed} || ${scanView>/result/IsConfirmed} || ${scanView>/result/Status} === '04' || ${scanView>/result/Status} === '05') ? 'Success' : (${scanView>/result/Status} === '90' ? 'Warning' : 'Information') }" />

                                <Label text="{i18n>scanToLabelConfirmedBy}" design="Bold" visible="{= !!(${scanView>/result/Confirmed} || ${scanView>/result/IsConfirmed}) }" />
                                <Text text="{scanView>/result/ConfirmedBy}" visible="{= !!(${scanView>/result/Confirmed} || ${scanView>/result/IsConfirmed}) }" />

                                <core:Title text="{i18n>scanToResultSectionMaterial}" />
                                <Label text="{i18n>scanToLabelMaterial}" design="Bold" visible="{= !!${scanView>/result/Material} }" />
                                <ObjectIdentifier
                                    title="{scanView>/result/Material}"
                                    text="{scanView>/result/MaterialName}"
                                    visible="{= !!${scanView>/result/Material} }" />

                                <Label text="{i18n>scanToLabelPickQty}" design="Bold" visible="{= !!${scanView>/result/Quantity} }" />
                                <Text text="{scanView>/result/Quantity} {scanView>/result/Unit}{= ${scanView>/result/MovementType} ? ' (Mvt ' + ${scanView>/result/MovementType} + ')' : '' }" visible="{= !!${scanView>/result/Quantity} }" />

                                <Label text="{i18n>scanToLabelBatch}" design="Bold" visible="{= !!${scanView>/result/Batch} }" />
                                <ObjectStatus
                                    text="{scanView>/result/Batch}"
                                    state="Information"
                                    visible="{= !!${scanView>/result/Batch} }" />

                                <Label text="{i18n>scanToLabelMaterialDoc}" design="Bold" visible="{= !!${scanView>/result/MaterialDocument} }" />
                                <ObjectIdentifier
                                    id="txtResultMaterialDoc"
                                    title="{scanView>/result/MaterialDocument}"
                                    text="{scanView>/result/MaterialDocYear}"
                                    visible="{= !!${scanView>/result/MaterialDocument} }" />

                                <Label text="{i18n>scanToLabelStockEffect}" design="Bold" visible="{= !!${scanView>/result/StockEffect} }" />
                                <ObjectStatus
                                    id="txtResultStockEffect"
                                    text="{scanView>/result/StockEffect}"
                                    state="Success"
                                    visible="{= !!${scanView>/result/StockEffect} }" />

                                <Label text="{i18n>scanToResultLabelError}" design="Bold" visible="{= ${scanView>/result/Status} === '90' || !!${scanView>/result/ErrorMessage} }" />
                                <ObjectStatus
                                    text="{scanView>/result/ErrorMessage}"
                                    state="Error"
                                    visible="{= ${scanView>/result/Status} === '90' || !!${scanView>/result/ErrorMessage} }" />

                                <Label text="{i18n>scanToLabelReceivingPlant}" design="Bold" required="true" visible="{= ${scanView>/canRetryMigo} &amp;&amp; ${scanView>/result/MovementType} === '301' }" />
                                <Input
                                    id="inputResultReceivingPlant"
                                    value="{scanView>/result/ReceivingPlant}"
                                    valueLiveUpdate="true"
                                    placeholder="{i18n>scanToPlaceholderReceivingPlant}"
                                    maxLength="4"
                                    width="12rem"
                                    visible="{= ${scanView>/canRetryMigo} &amp;&amp; ${scanView>/result/MovementType} === '301' }" />

                                <Label text="{i18n>scanToLabelReceivingSLoc}" design="Bold" visible="{= ${scanView>/canRetryMigo} &amp;&amp; (${scanView>/result/MovementType} === '301' || ${scanView>/result/MovementType} === '311') }" />
                                <Input
                                    id="inputResultReceivingSLoc"
                                    value="{scanView>/result/ReceivingStorageLocation}"
                                    valueLiveUpdate="true"
                                    placeholder="{i18n>scanToPlaceholderReceivingSLoc}"
                                    maxLength="4"
                                    width="12rem"
                                    visible="{= ${scanView>/canRetryMigo} &amp;&amp; (${scanView>/result/MovementType} === '301' || ${scanView>/result/MovementType} === '311') }" />

                                <Label text="{i18n>scanToLabelCostCenter}" design="Bold" required="true" visible="{= ${scanView>/canRetryMigo} &amp;&amp; ${scanView>/result/MovementType} === '201' }" />
                                <Input
                                    id="inputResultCostCenter"
                                    value="{scanView>/result/CostCenter}"
                                    valueLiveUpdate="true"
                                    placeholder="{i18n>scanToPlaceholderCostCenter}"
                                    maxLength="10"
                                    width="12rem"
                                    visible="{= ${scanView>/canRetryMigo} &amp;&amp; ${scanView>/result/MovementType} === '201' }" />

                                <Label text="{i18n>scanToLabelAssetNo}" design="Bold" required="true" visible="{= ${scanView>/canRetryMigo} &amp;&amp; ${scanView>/result/MovementType} === '241' }" />
                                <Input
                                    id="inputResultAssetNo"
                                    value="{scanView>/result/AssetNo}"
                                    valueLiveUpdate="true"
                                    placeholder="{i18n>scanToPlaceholderAssetNo}"
                                    maxLength="12"
                                    width="12rem"
                                    visible="{= ${scanView>/canRetryMigo} &amp;&amp; ${scanView>/result/MovementType} === '241' }" />
                            </form:content>
                        </form:SimpleForm>

                        <HBox justifyContent="End" class="sapUiSmallMarginTop">
                            <Button
                                id="btnRetryMigo"
                                text="{i18n>scanToBtnRetryMigo}"
                                icon="sap-icon://refresh"
                                type="Attention"
                                press=".onRetryMigo"
                                visible="{scanView>/canRetryMigo}"
                                class="sapUiTinyMarginEnd" />
                            <Button
                                id="btnScanNextTR"
                                text="{i18n>scanToBtnNextTR}"
                                icon="sap-icon://next"
                                type="Emphasized"
                                press=".onScanNextTR" />
                        </HBox>
                    </VBox>
                </Panel>

                <!-- SECTION 3: TR DETAILS SUMMARY CARD -->
                <Panel
                    id="panelTRDetails"
                    headerText="{i18n>scanToPanelTRDetails}"
                    visible="{scanView>/hasTR}"
                    expandable="false"
                    expanded="true"
                    class="sapUiSmallMarginBottom">
                    <form:SimpleForm
                        editable="false"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4"
                        labelSpanL="4"
                        labelSpanM="4"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="2"
                        columnsL="2"
                        columnsM="2">
                        <form:content>
                            <core:Title text="{i18n>scanToGroupMaterialInfo}" />
                            <Label text="{= ${scanView>/docType} === 'RES' ? 'Reservation' : 'Transfer Requirement' }" design="Bold" />
                            <Text text="{scanView>/tr/TRNumber}{= ${scanView>/tr/TRItem} ? ' / Item ' + ${scanView>/tr/TRItem} : ''}" />

                            <Label text="{i18n>scanToLabelTRItem}" design="Bold" required="true" visible="{= ${scanView>/trItems}.length > 1 }" />
                            <Select
                                id="selTRItem"
                                selectedKey="{scanView>/selectedTbpos}"
                                forceSelection="false"
                                items="{scanView>/trItems}"
                                change=".onTRItemChange"
                                visible="{= ${scanView>/trItems}.length > 1 }"
                                width="100%">
                                <core:Item key="{scanView>Tbpos}" text="{scanView>Tbpos} - {scanView>Material} {scanView>MaterialDesc} ({scanView>OpenQty} {scanView>Unit} open)" />
                            </Select>
                            <Label text="{i18n>scanToLabelMaterial}" design="Bold" />
                            <ObjectIdentifier
                                title="{scanView>/tr/Material}"
                                text="{scanView>/tr/MaterialDescription}" />

                            <Label text="{i18n>scanToLabelMovementType}" design="Bold" />
                            <ObjectStatus
                                text="{scanView>/tr/MovementType}"
                                state="Information" />

                            <Label text="{i18n>scanToLabelReservation}" design="Bold" />
                            <Text text="{= (${scanView>/tr/ReservationNo} &amp;&amp; ${scanView>/tr/ReservationNo} !== '0') ? (${scanView>/tr/ReservationNo} + (${scanView>/tr/ReservationItem} ? ' / ' + ${scanView>/tr/ReservationItem} : '')) : '-' }" />

                            <core:Title text="{i18n>scanToGroupQuantitiesAndLocations}" />
                            <Label text="{i18n>scanToLabelOpenQty}" design="Bold" />
                            <ObjectStatus
                                text="{scanView>/tr/OpenQty} {scanView>/tr/Unit}"
                                state="Success"
                                inverted="true" />

                            <Label text="{i18n>scanToLabelTargetQty}" design="Bold" />
                            <Text text="{scanView>/tr/TargetQty} {scanView>/tr/Unit}" />

                            <Label text="{i18n>scanToLabelLocation}" design="Bold" />
                            <Text text="{scanView>/tr/Plant} / {scanView>/tr/StorageLocation} (WH: {scanView>/tr/WarehouseNumber})" />

                            <Label text="{i18n>scanToLabelSourceBin}" design="Bold" visible="{= !!${scanView>/sourceStorageBin} || !!${scanView>/tr/SourceStorageBin} }" />
                            <Text text="{= (${scanView>/sourceStorageType} || ${scanView>/tr/SourceStorageType}) + ' / ' + (${scanView>/sourceStorageBin} || ${scanView>/tr/SourceStorageBin}) }" visible="{= !!${scanView>/sourceStorageBin} || !!${scanView>/tr/SourceStorageBin} }" />

                            <Label text="{i18n>scanToLabelDestinationBin}" design="Bold" />
                            <Text text="{scanView>/tr/DestinationType} / {scanView>/tr/DestinationBin}" />
                        </form:content>
                    </form:SimpleForm>
                </Panel>

                <!-- SECTION 4: QUANTITY INPUT & VALIDATION -->
                <Panel
                    id="panelQuantityCheck"
                    headerText="{i18n>scanToPanelQuantityTitle}"
                    visible="{scanView>/hasTR}"
                    expandable="false"
                    expanded="true"
                    class="sapUiSmallMarginBottom">
                    <VBox class="sapUiSmallMargin">
                        <Label
                            text="{i18n>scanToLabelPickQty}"
                            design="Bold"
                            required="true"
                            class="sapUiTinyMarginBottom" />
                        <HBox alignItems="Center">
                            <Input
                                id="inputPickQty"
                                value="{scanView>/pickQty}"
                                type="Number"
                                width="12rem"
                                liveChange=".onPickQtyChange"
                                valueState="{scanView>/qtyValueState}"
                                valueStateText="{scanView>/qtyValueStateText}"
                                class="sapUiSmallMarginEnd" />
                            <Text text="{scanView>/tr/Unit}" class="sapUiSmallMarginEnd" />
                            <Button
                                id="btnSetMaxQty"
                                text="{i18n>scanToBtnMaxQty}"
                                tooltip="{i18n>scanToTooltipMaxQty}"
                                type="Transparent"
                                press=".onSetMaxQty" />
                        </HBox>
                    </VBox>
                </Panel>

                <!-- SECTION: TRANSFER DESTINATION / ACCOUNT ASSIGNMENT -->
                <Panel
                    id="panelDestination"
                    headerText="{= ${scanView>/tr/MovementType} === '301' ? ${i18n>scanToPanelDestination301} : (${scanView>/tr/MovementType} === '311' ? ${i18n>scanToPanelDestination311} : (${scanView>/tr/MovementType} === '201' ? ${i18n>scanToPanelAccount201} : (${scanView>/tr/MovementType} === '241' ? ${i18n>scanToPanelAccount241} : ${i18n>scanToPanelDestinationTitle}))) }"
                    visible="{= ${scanView>/hasTR} &amp;&amp; (${scanView>/tr/MovementType} === '301' || ${scanView>/tr/MovementType} === '311' || ${scanView>/tr/MovementType} === '201' || ${scanView>/tr/MovementType} === '241') }"
                    expandable="false"
                    expanded="true"
                    class="sapUiSmallMarginBottom">
                    <VBox class="sapUiSmallMargin">
                        <!-- MOVEMENT 301: PLANT TO PLANT -->
                        <VBox visible="{= ${scanView>/tr/MovementType} === '301' }" class="sapUiTinyMarginBottom">
                            <Label
                                text="{i18n>scanToLabelReceivingPlant}"
                                design="Bold"
                                required="true"
                                class="sapUiTinyMarginBottom" />
                            <Input
                                id="inputReceivingPlant"
                                value="{scanView>/receivingPlant}"
                                valueLiveUpdate="true"
                                placeholder="{i18n>scanToPlaceholderReceivingPlant}"
                                width="12rem"
                                maxLength="4"
                                liveChange=".onReceivingPlantLiveChange"
                                valueState="{scanView>/recPlantValueState}"
                                valueStateText="{scanView>/recPlantValueStateText}"
                                class="sapUiSmallMarginBottom" />

                            <Label
                                text="{i18n>scanToLabelReceivingSLoc}"
                                design="Bold"
                                class="sapUiTinyMarginBottom" />
                            <Input
                                id="inputReceivingSLoc"
                                value="{scanView>/receivingStorageLocation}"
                                valueLiveUpdate="true"
                                placeholder="{i18n>scanToPlaceholderReceivingSLoc}"
                                width="12rem"
                                maxLength="4"
                                liveChange=".onReceivingSLocLiveChange" />
                        </VBox>

                        <!-- MOVEMENT 311: INTRA-PLANT -->
                        <VBox visible="{= ${scanView>/tr/MovementType} === '311' }" class="sapUiTinyMarginBottom">
                            <Label
                                text="{i18n>scanToLabelReceivingSLoc}"
                                design="Bold"
                                required="true"
                                class="sapUiTinyMarginBottom" />
                            <Input
                                id="inputReceivingSLoc311"
                                value="{scanView>/receivingStorageLocation}"
                                valueLiveUpdate="true"
                                placeholder="{i18n>scanToPlaceholderReceivingSLoc}"
                                width="12rem"
                                maxLength="4"
                                liveChange=".onReceivingSLocLiveChange"
                                valueState="{scanView>/recSLocValueState}"
                                valueStateText="{scanView>/recSLocValueStateText}" />
                        </VBox>

                        <!-- MOVEMENT 201: COST CENTER -->
                        <VBox visible="{= ${scanView>/tr/MovementType} === '201' }" class="sapUiTinyMarginBottom">
                            <Label
                                text="{i18n>scanToLabelCostCenter}"
                                design="Bold"
                                required="true"
                                class="sapUiTinyMarginBottom" />
                            <Input
                                id="inputCostCenter"
                                value="{scanView>/costCenter}"
                                valueLiveUpdate="true"
                                placeholder="{i18n>scanToPlaceholderCostCenter}"
                                width="12rem"
                                maxLength="10"
                                liveChange=".onCostCenterLiveChange"
                                valueState="{scanView>/costCenterValueState}"
                                valueStateText="{scanView>/costCenterValueStateText}" />
                        </VBox>

                        <!-- MOVEMENT 241: ASSET -->
                        <VBox visible="{= ${scanView>/tr/MovementType} === '241' }" class="sapUiTinyMarginBottom">
                            <Label
                                text="{i18n>scanToLabelAssetNo}"
                                design="Bold"
                                required="true"
                                class="sapUiTinyMarginBottom" />
                            <Input
                                id="inputAssetNo"
                                value="{scanView>/assetNo}"
                                valueLiveUpdate="true"
                                placeholder="{i18n>scanToPlaceholderAssetNo}"
                                width="12rem"
                                maxLength="12"
                                liveChange=".onAssetNoLiveChange"
                                valueState="{scanView>/assetValueState}"
                                valueStateText="{scanView>/assetValueStateText}"
                                class="sapUiTinyMarginBottom" />
                            <Label
                                text="{i18n>scanToLabelSubNumber}"
                                design="Bold"
                                class="sapUiTinyMarginBottom" />
                            <Input
                                id="inputSubNumber"
                                value="{scanView>/subNumber}"
                                placeholder="{i18n>scanToPlaceholderSubNumber}"
                                width="8rem"
                                maxLength="4" />
                        </VBox>
                    </VBox>
                </Panel>

                <!-- SECTION 5: DYNAMIC BATCH CAPTURE (IF MATERIAL IS BATCH-MANAGED) -->
                <Panel
                    id="panelBatch"
                    headerText="{i18n>scanToPanelBatchTitle}"
                    visible="{= ${scanView>/hasTR} &amp;&amp; ${scanView>/tr/IsBatchManaged} }"
                    expandable="false"
                    expanded="true"
                    class="sapUiSmallMarginBottom">
                    <VBox class="sapUiSmallMargin">
                        <!-- FIFO Recommendation Banner -->
                        <HBox
                            alignItems="Center"
                            justifyContent="SpaceBetween"
                            visible="{= !!${scanView>/fifoBatch} }"
                            class="sapUiTinyMarginBottom">
                            <HBox alignItems="Center">
                                <core:Icon
                                    src="sap-icon://activate"
                                    color="#107e3e"
                                    class="sapUiTinyMarginEnd" />
                                <VBox>
                                    <HBox alignItems="Center">
                                        <Text
                                            text="{i18n>scanToFifoBadge}"
                                            class="sapUiTinyMarginEnd" />
                                        <ObjectStatus
                                            text="{scanView>/fifoBatch}"
                                            state="Success"
                                            inverted="true" />
                                    </HBox>
                                    <Text
                                        text="{scanView>/fifoBatchRecommendation}"
                                        class="sapUiExtraTinyMarginTop" />
                                </VBox>
                            </HBox>
                            <Button
                                id="btnApplyFifoBatch"
                                text="{i18n>scanToFifoApplyBtn}"
                                icon="sap-icon://accept"
                                type="Emphasized"
                                press=".onApplyFifoBatch" />
                        </HBox>

                        <Label
                            text="{i18n>scanToLabelBatch}"
                            design="Bold"
                            required="true"
                            class="sapUiTinyMarginBottom" />
                        <HBox width="100%" alignItems="Center">
                            <Input
                                id="inputBatch"
                                value="{scanView>/batch}"
                                placeholder="{i18n>scanToPlaceholderBatch}"
                                liveChange=".onBatchLiveChange"
                                showSuggestion="true"
                                suggestionItemSelected=".onSuggestionBatchSelected"
                                suggestionItems="{scanView>/suggestedBatches}"
                                valueState="{scanView>/batchValueState}"
                                valueStateText="{scanView>/batchValueStateText}"
                                width="100%"
                                class="sapUiTinyMarginEnd">
                                <suggestionItems>
                                    <core:Item key="{scanView>Batch}" text="{scanView>Batch}" />
                                </suggestionItems>
                                <layoutData>
                                    <FlexItemData growFactor="1" />
                                </layoutData>
                            </Input>
                            <Button
                                id="btnCameraScanBatch"
                                icon="sap-icon://bar-code"
                                tooltip="{i18n>scanToBtnCameraBatch}"
                                press=".onCameraScanBatch" />
                        </HBox>

                        <!-- SUGGESTED FIFO BATCHES TABLE -->
                        <VBox visible="{= !!${scanView>/suggestedBatches} &amp;&amp; ${scanView>/suggestedBatches}.length > 0 }" class="sapUiSmallMarginTop">
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                                <Label text="{i18n>scanToBatchesSuggestedTitle}" design="Bold" />
                                <Text text="{= ${scanView>/suggestedBatches}.length + ' batches found in warehouse' }" class="sapUiExtraTinyMarginTop" />
                            </HBox>
                            <Table
                                id="tableSuggestedBatches"
                                items="{scanView>/suggestedBatches}"
                                noDataText="{i18n>scanToNoBatchesFound}"
                                class="sapUiSizeCompact">
                                <columns>
                                    <Column width="5rem">
                                        <Text text="{i18n>scanToColFifoRank}" />
                                    </Column>
                                    <Column>
                                        <Text text="{i18n>scanToColBatch}" />
                                    </Column>
                                    <Column hAlign="End">
                                        <Text text="{i18n>scanToColAvailStock}" />
                                    </Column>
                                    <Column>
                                        <Text text="{i18n>scanToColGRDate}" />
                                    </Column>
                                    <Column>
                                        <Text text="{i18n>scanToColStorageBin}" />
                                    </Column>
                                    <Column hAlign="End" width="6rem">
                                        <Text text="{i18n>scanToColAction}" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem highlight="{= ${scanView>IsRecommended} ? 'Success' : 'None' }">
                                        <cells>
                                            <ObjectStatus
                                                text="{= '#' + ${scanView>FifoRank} }"
                                                state="{= ${scanView>IsRecommended} ? 'Success' : 'None' }" />
                                            <HBox alignItems="Center">
                                                <Text text="{scanView>Batch}" class="sapUiTinyMarginEnd" />
                                                <core:Icon
                                                    src="sap-icon://favorite"
                                                    color="#107e3e"
                                                    size="0.75rem"
                                                    visible="{scanView>IsRecommended}"
                                                    tooltip="{i18n>scanToFifoBadge}" />
                                            </HBox>
                                            <ObjectNumber
                                                number="{scanView>AvailableStock}"
                                                unit="{scanView>Unit}" />
                                            <Text text="{= ${scanView>GoodsReceiptDate} || '-' }" />
                                            <Text text="{= ${scanView>StorageType} ? (${scanView>StorageType} + '/' + ${scanView>StorageBin}) : '-' }" />
                                            <Button
                                                text="{i18n>scanToBtnSelectBatch}"
                                                type="{= ${scanView>Batch} === ${scanView>/batch} ? 'Emphasized' : 'Transparent' }"
                                                icon="{= ${scanView>Batch} === ${scanView>/batch} ? 'sap-icon://accept' : '' }"
                                                press=".onSelectBatchSuggestion" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </VBox>
                </Panel>

                <!-- SECTION 6: DYNAMIC SERIAL NUMBER CAPTURE (IF MATERIAL IS SERIAL-MANAGED) -->
                <Panel
                    id="panelSerials"
                    headerText="{i18n>scanToPanelSerialsTitle}"
                    visible="{= ${scanView>/hasTR} &amp;&amp; ${scanView>/tr/IsSerialManaged} }"
                    expandable="false"
                    expanded="true"
                    class="sapUiSmallMarginBottom">
                    <VBox class="sapUiSmallMargin">
                        <!-- SERIAL SERIES AUTO-FILL STRIP -->
                        <HBox
                            alignItems="Center"
                            justifyContent="SpaceBetween"
                            visible="{= !!${scanView>/suggestedSerials} &amp;&amp; ${scanView>/suggestedSerials}.length > 0 }"
                            class="sapUiTinyMarginBottom">
                            <HBox alignItems="Center">
                                <core:Icon
                                    src="sap-icon://dimension"
                                    color="#0a6ed1"
                                    class="sapUiTinyMarginEnd" />
                                <Text
                                    text="{= 'Available Serial Series: ' + ${scanView>/suggestedSerials}.length + ' serial numbers found in stock.' }" />
                            </HBox>
                            <Button
                                id="btnAutoFillSerials"
                                text="{= 'Auto-Fill Series (' + ${scanView>/pickQty} + ')' }"
                                icon="sap-icon://multi-select"
                                type="Emphasized"
                                press=".onAutoFillSerials" />
                        </HBox>

                        <!-- QUICK-SELECT SERIAL CHIPS -->
                        <VBox visible="{= !!${scanView>/suggestedSerials} &amp;&amp; ${scanView>/suggestedSerials}.length > 0 }" class="sapUiTinyMarginBottom">
                            <Label text="{i18n>scanToSuggestedSerialsLabel}" class="sapUiTinyMarginBottom" />
                            <HBox wrap="Wrap" items="{scanView>/suggestedSerials}">
                                <Button
                                    text="{scanView>}"
                                    type="Transparent"
                                    press=".onAddSuggestedSerial"
                                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />
                            </HBox>
                        </VBox>

                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                            <Label text="{i18n>scanToLabelSerialInput}" design="Bold" required="true" />
                            <ObjectStatus
                                id="statusSerialsCount"
                                text="{scanView>/serialsStatusText}"
                                state="{scanView>/serialsStatusState}" />
                        </HBox>

                        <HBox width="100%" alignItems="Center" class="sapUiSmallMarginBottom">
                            <Input
                                id="inputSerialScan"
                                value="{scanView>/serialInput}"
                                placeholder="{i18n>scanToPlaceholderSerial}"
                                submit=".onAddSerial"
                                width="100%"
                                class="sapUiTinyMarginEnd">
                                <layoutData>
                                    <FlexItemData growFactor="1" />
                                </layoutData>
                            </Input>
                            <Button
                                id="btnCameraScanSerial"
                                icon="sap-icon://bar-code"
                                tooltip="{i18n>scanToBtnCameraSerial}"
                                press=".onCameraScanSerial"
                                class="sapUiTinyMarginEnd" />
                            <Button
                                id="btnAddSerial"
                                text="{i18n>scanToAddSerial}"
                                icon="sap-icon://add"
                                press=".onAddSerial" />
                        </HBox>

                        <!-- LIST OF SCANNED SERIALS -->
                        <Table
                            id="tableSerials"
                            items="{scanView>/serials}"
                            noDataText="{i18n>scanToNoSerialsScanned}"
                            class="sapUiSizeCompact">
                            <columns>
                                <Column>
                                    <Text text="{i18n>scanToColIndex}" />
                                </Column>
                                <Column>
                                    <Text text="{i18n>scanToColSerialNo}" />
                                </Column>
                                <Column hAlign="End" width="4rem">
                                    <Text text="{i18n>scanToColAction}" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{scanView>index}" />
                                        <Text text="{scanView>serial}" />
                                        <Button
                                            icon="sap-icon://delete"
                                            type="Transparent"
                                            tooltip="{i18n>scanToTooltipRemoveSerial}"
                                            press=".onRemoveSerial" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </Panel>

            </VBox>
        </content>

        <!-- FOOTER ACTIONS -->
        <footer>
            <OverflowToolbar id="scanFooterToolbar">
                <Button
                    id="btnReset"
                    text="{i18n>commonCancel}"
                    icon="sap-icon://reset"
                    press=".onReset" />
                <ToolbarSpacer />
                <Button
                    id="btnProcessTO"
                    text="{= ${scanView>/autoConfirm} ? ${i18n>scanToBtnCreateAndConfirm} : ${i18n>scanToBtnCreateTO} }"
                    type="Emphasized"
                    icon="sap-icon://accept"
                    press=".onProcessTO"
                    enabled="{scanView>/canSubmit}" />
            </OverflowToolbar>
        </footer>

    </Page>
</mvc:View>
