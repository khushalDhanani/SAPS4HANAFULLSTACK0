<mvc:View
    controllerName="saps4hana.fiori.modules.wm.warehouse-scan-to.controller.WarehouseScanTo"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page
        id="warehouseScanToPage"
        class="sapUiSizeCompact">

        <headerContent>
            <HBox alignItems="Center" class="sapUiTinyMarginEnd">
                <Button
                    id="btnToggleAudio"
                    icon="{= ${scanView>/audioEnabled} ? 'sap-icon://sound' : 'sap-icon://sound-off' }"
                    tooltip="{i18n>scanToTooltipToggleAudio}"
                    type="Transparent"
                    press=".onToggleAudio" />
            </HBox>
        </headerContent>

        <content>
            <VBox class="sapUiResponsiveMargin" width="auto">

                <!-- STATUS MESSAGE BANNER -->
                <MessageStrip
                    id="scanMessageStrip"
                    visible="{scanView>/hasMessage}"
                    text="{scanView>/messageText}"
                    type="{scanView>/messageType}"
                    showIcon="true"
                    showCloseButton="true"
                    close=".onCloseMessage"
                    class="sapUiSmallMarginBottom" />

                <!-- SECTION 1: TR BARCODE / CAMERA SCAN -->
                <Panel
                    id="panelScanTR"
                    headerText="{i18n>scanToPanelScanTitle}"
                    expandable="false"
                    expanded="true"
                    class="sapUiSmallMarginBottom">
                    <VBox class="sapUiSmallMargin">
                        <Label
                            text="{i18n>scanToLabelScanTR}"
                            design="Bold"
                            required="true"
                            class="sapUiTinyMarginBottom" />
                        <SegmentedButton
                            id="segDocType"
                            selectedKey="{scanView>/docType}"
                            selectionChange=".onDocTypeChange"
                            class="sapUiTinyMarginBottom">
                            <items>
                                <SegmentedButtonItem key="TR" text="{i18n>scanToDocTypeTR}" />
                                <SegmentedButtonItem key="RES" text="{i18n>scanToDocTypeRES}" />
                            </items>
                        </SegmentedButton>
                        <HBox width="100%" alignItems="Center">
                            <Input
                                id="inputBarcodeTR"
                                value="{scanView>/scannedTR}"
                                placeholder="{i18n>scanToPlaceholderTR}"
                                submit=".onLookupTR"
                                liveChange=".onTRLiveChange"
                                width="100%"
                                class="sapUiTinyMarginEnd">
                                <layoutData>
                                    <FlexItemData growFactor="1" />
                                </layoutData>
                            </Input>
                            <Button
                                id="btnCameraScanTR"
                                icon="sap-icon://bar-code"
                                tooltip="{i18n>scanToBtnCameraTR}"
                                press=".onCameraScanTR"
                                class="sapUiTinyMarginEnd" />
                            <Button
                                id="btnValueHelpTR"
                                icon="sap-icon://value-help"
                                tooltip="{i18n>scanToBtnValueHelp}"
                                press=".onValueHelpTR"
                                class="sapUiTinyMarginEnd" />
                            <Button
                                id="btnLookupTR"
                                text="{i18n>scanToBtnLookup}"
                                icon="sap-icon://search"
                                type="Emphasized"
                                press=".onLookupTR" />
                        </HBox>
                    </VBox>
                </Panel>

                <!-- SECTION 1b: OPEN TR LIST (DIRECT SELECTION -> DETAIL PAGE) -->
                <Panel
                    id="panelOpenTRs"
                    headerText="{i18n>scanToSelectDialogTitle}"
                    expandable="false"
                    expanded="true"
                    class="sapUiSmallMarginBottom">
                    <List
                        id="listOpenTRs"
                        items="{scanView>/openTRs}"
                        busy="{scanView>/isLoadingTRs}"
                        noDataText="{i18n>scanToSelectDialogNoData}"
                        class="sapUiSizeCompact">
                        <StandardListItem
                            title="{scanView>Tbnum}"
                            description="{scanView>DisplayText}"
                            info="{= ${scanView>Statu} === 'T' ? 'Partial' : 'Open' }"
                            infoState="{= ${scanView>Statu} === 'T' ? 'Warning' : 'Success' }"
                            icon="sap-icon://document-text"
                            type="Active"
                            press=".onOpenTRPress" />
                    </List>
                </Panel>

            </VBox>
        </content>

    </Page>
</mvc:View>
