<mvc:View
    controllerName="saps4hana.fiori.modules.wm.quarantine-label.controller.QuarantineLabels"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true">

    <Page id="qlPage" class="sapUiSizeCompact">
        <content>
            <VBox class="sapUiResponsiveMargin" width="auto" busy="{qlView>/busy}" busyIndicatorDelay="0">

                <form:SimpleForm id="qlForm" editable="true" layout="ResponsiveGridLayout" columnsM="2" columnsL="2" columnsXL="2">
                    <form:content>
                        <core:Title text="{i18n>qlFormTitle}" />
                        <Label text="{i18n>qlMaterialDocument}" labelFor="qlDoc" required="true" />
                        <Input id="qlDoc" value="{qlView>/materialDocument}" maxLength="10" placeholder="4900050304"
                            valueState="{qlView>/docState}" valueStateText="{qlView>/docStateText}"
                            liveChange=".onInputChange" submit=".onPreview" />
                        <Label text="{i18n>qlYear}" labelFor="qlYear" required="true" />
                        <Input id="qlYear" value="{qlView>/year}" maxLength="4" width="8rem"
                            valueState="{qlView>/yearState}" valueStateText="{qlView>/yearStateText}"
                            liveChange=".onInputChange" submit=".onPreview" />
                        <Label text="{i18n>qlText}" labelFor="qlText" />
                        <Input id="qlText" value="{qlView>/text}" maxLength="50" placeholder="{i18n>qlTextPlaceholder}"
                            valueState="{qlView>/textState}" valueStateText="{qlView>/textStateText}"
                            liveChange=".onInputChange" submit=".onPreview" />
                        <Label />
                        <HBox id="qlButtons" wrap="Wrap">
                            <Button id="qlPreview" text="{i18n>qlPreview}" type="Emphasized" icon="sap-icon://pdf-attachment"
                                press=".onPreview" enabled="{= !${qlView>/busy} }" class="sapUiTinyMarginEnd" />
                            <!-- App-drawn 4 x 6 label from SAP label data; the SAP PDF action above is unchanged -->
                            <Button id="ql4x6" text="{i18n>ql4x6Labels}" icon="sap-icon://bar-code"
                                press=".on4x6Labels" enabled="{= !${qlView>/busy} }" />
                        </HBox>
                    </form:content>
                </form:SimpleForm>

                <MessageStrip id="qlMessage" visible="{= !!${qlView>/message} }" text="{qlView>/message}"
                    type="{qlView>/messageType}" showIcon="true" class="sapUiSmallMarginTop" />

                <!-- Goods receipts (movement type 101) of a plant: read only; labels per row or for the ticked rows -->
                <Panel id="qlListPanel" headerText="{i18n>qlListTitle}" class="sapUiSmallMarginTop">
                    <form:SimpleForm id="qlListForm" editable="true" layout="ResponsiveGridLayout" columnsM="2" columnsL="3" columnsXL="3">
                        <form:content>
                            <Label text="{i18n>qlListPlant}" labelFor="qlListPlant" required="true" />
                            <Input id="qlListPlant" value="{qlList>/plant}" maxLength="4" width="8rem" submit=".onListGo" />
                            <Label text="{i18n>qlListPostingDate}" labelFor="qlListDates" />
                            <DateRangeSelection id="qlListDates" dateValue="{qlList>/dateFrom}" secondDateValue="{qlList>/dateTo}"
                                displayFormat="dd-MM-yyyy" enabled="{= !${qlList>/materialDocument} }" />
                            <Label text="{i18n>qlListDocSearch}" labelFor="qlListDoc" />
                            <HBox id="qlListDocBox">
                                <Input id="qlListDoc" value="{qlList>/materialDocument}" maxLength="10" width="11rem" submit=".onListGo"
                                    class="sapUiTinyMarginEnd" />
                                <Input id="qlListYear" value="{qlList>/year}" maxLength="4" width="6rem" submit=".onListGo"
                                    placeholder="{i18n>qlColYear}" tooltip="{i18n>qlColYear}" />
                            </HBox>
                            <Label />
                            <HBox id="qlListButtons">
                                <Button id="qlListGo" text="{i18n>qlListGo}" type="Emphasized" icon="sap-icon://search" press=".onListGo"
                                    enabled="{= !${qlView>/busy} }" />
                            </HBox>
                        </form:content>
                    </form:SimpleForm>

                    <Table id="qlDocTable" items="{qlList>/documents}" mode="MultiSelect" selectionChange=".onListSelectionChange"
                        growing="true" growingThreshold="50"
                        noDataText="{= ${qlList>/listed} ? ${i18n>qlListNoData} : ${i18n>qlListStart} }">
                        <headerToolbar>
                            <OverflowToolbar id="qlDocToolbar">
                                <Title id="qlDocCount" text="{ parts: ['i18n>qlListCount', 'qlList>/documents'], formatter: '.formatCount' }" level="H3" />
                                <ToolbarSpacer />
                                <Button id="qlDownloadSelected" icon="sap-icon://download"
                                    text="{ parts: ['i18n>qlDownloadSelected', 'qlList>/selectedCount'], formatter: '.formatSelected' }"
                                    press=".onDownloadSelected" enabled="{= ${qlList>/selectedCount} > 0 &amp;&amp; !${qlView>/busy} }" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column><Text id="qlColDocLabel" text="{i18n>qlColDocument}" /></Column>
                            <Column width="5rem"><Text id="qlColYearLabel" text="{i18n>qlColYear}" /></Column>
                            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>qlColPostingDate}" /></Column>
                            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>qlColMaterial}" /></Column>
                            <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>qlColBatch}" /></Column>
                            <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>qlColSupplier}" /></Column>
                            <Column hAlign="End" width="9rem"><Text text="{i18n>qlColActions}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{qlList>MaterialDocument}" />
                                    <Text text="{qlList>MaterialDocumentYear}" />
                                    <Text text="{= ${qlList>PostingDate} || '-' }" />
                                    <ObjectIdentifier title="{= ${qlList>MaterialDescription} || '-' }" text="{= ${qlList>Material} || '-' }" />
                                    <Text text="{= ${qlList>Batch} || '-' }" />
                                    <Text text="{= ${qlList>SupplierName} || '-' }" />
                                    <HBox justifyContent="End">
                                        <Button icon="sap-icon://bar-code" tooltip="{i18n>qlRowLabels}" type="Transparent" press=".onRowLabels"
                                            enabled="{= !${qlView>/busy} }" />
                                        <Button icon="sap-icon://download" tooltip="{i18n>qlRowDownload}" type="Transparent" press=".onRowDownload"
                                            enabled="{= !${qlView>/busy} }" />
                                        <Button icon="sap-icon://print" tooltip="{i18n>qlRowPrint}" type="Transparent" press=".onRowPrint"
                                            enabled="{= !${qlView>/busy} }" />
                                    </HBox>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

                <OverflowToolbar id="qlActions" visible="{= !!${qlView>/pdfUrl} }" class="sapUiSmallMarginTop">
                    <Title id="qlResultTitle" text="{i18n>qlResultTitle}" level="H3" />
                    <ToolbarSpacer />
                    <Button id="qlPrint" text="{i18n>qlPrint}" icon="sap-icon://print" press=".onPrint" />
                    <Button id="qlDownload" text="{i18n>qlDownload}" icon="sap-icon://download" press=".onDownload" />
                </OverflowToolbar>

                <!-- isTrustedSource: the PDF is rendered by SAP and served by this app's own backend -->
                <PDFViewer id="qlPdfViewer" source="{qlView>/pdfUrl}" isTrustedSource="true" showDownloadButton="false"
                    title="{qlView>/fileName}" height="70vh" visible="{= !!${qlView>/pdfUrl} }" />
            </VBox>
        </content>
    </Page>
</mvc:View>
