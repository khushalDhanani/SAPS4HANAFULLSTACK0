<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Dialog
        id="createQuoteFromInquiryDialog"
        title="{i18n>quoteDialogTitle}"
        contentWidth="620px"
        class="sapUiSizeCompact"
        resizable="true"
        draggable="true">
        <content>
            <VBox class="sapUiSmallMargin">
                <!-- Incompletion Alert Banner & Navigation -->
                <VBox
                    id="boxInquiryIncomplete"
                    visible="{= ${quoteDialog>/isIncomplete} === true }"
                    class="sapUiSmallMarginBottom">
                    <MessageStrip
                        id="stripInquiryIncomplete"
                        text="{quoteDialog>/incompletionMessage}"
                        type="Error"
                        showIcon="true"
                        class="sapUiTinyMarginBottom" />
                    <HBox justifyContent="End" alignItems="Center">
                        <Button
                            id="btnCopyInquiryNumber"
                            text="{i18n>quoteDialogBtnCopyInquiry}"
                            icon="sap-icon://copy"
                            press=".onCopyInquiryNumber"
                            class="sapUiTinyMarginEnd" />
                        <Button
                            id="btnRecheckInquiry"
                            text="{i18n>quoteDialogBtnRecheck}"
                            icon="sap-icon://refresh"
                            type="Emphasized"
                            enabled="{= !${quoteDialog>/isRechecking} }"
                            press=".onRecheckInquiryStatus" />
                    </HBox>
                </VBox>

                <!-- Source Inquiry Reference Summary -->
                <Panel
                    headerText="{i18n>quoteDialogSourcePanelHeaderPrefix}{quoteDialog>/SalesInquiry})"
                    expandable="true"
                    expanded="true"
                    class="sapUiNoContentPadding sapUiSmallMarginBottom">
                    <form:SimpleForm
                        editable="false"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4"
                        labelSpanL="4"
                        labelSpanM="4"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="1"
                        columnsL="1"
                        columnsM="1"
                        singleContainerFullSize="false">
                        <form:content>
                            <Label text="{i18n>quoteDialogRefDocLabel}" design="Bold" />
                            <Text text="{i18n>quoteDialogRefDocPrefix}{quoteDialog>/SalesInquiry} {i18n>quoteDialogRefDocSuffix}" />

                            <Label text="{i18n>quoteDialogCustomerLabel}" design="Bold" />
                            <Text text="{= ${quoteDialog>/OrganizationBPName1} ? (${quoteDialog>/OrganizationBPName1} + ' (' + ${quoteDialog>/SoldToParty} + ')') : ${quoteDialog>/SoldToParty} }" />

                            <Label text="{i18n>quoteDialogShipToLabel}" design="Bold" />
                            <Text text="{= ${quoteDialog>/ShipToPartyName} ? (${quoteDialog>/ShipToPartyName} + ' (' + ${quoteDialog>/ShipToParty} + ')') : (${quoteDialog>/ShipToParty} || 'Same as Sold-To') }" />

                            <Label text="{i18n>quoteDialogSalesAreaLabel}" design="Bold" />
                            <Text text="{= (${quoteDialog>/SalesOrganization} || '') + ' / ' + (${quoteDialog>/DistributionChannel} || '') + ' / ' + (${quoteDialog>/OrganizationDivision} || '') }" />

                            <Label text="{i18n>quoteDialogCustomerGroup2Label}" design="Bold" />
                            <Text text="{= ${quoteDialog>/CustomerGroup2} ? ${quoteDialog>/CustomerGroup2} : ${i18n>quoteDialogFieldNotMaintained} }" />

                            <Label text="{i18n>quoteDialogPortOfLoadingLabel}" design="Bold" />
                            <Text text="{= ${quoteDialog>/PortOfLoading} ? ${quoteDialog>/PortOfLoading} : ${i18n>quoteDialogFieldNotMaintained} }" />

                            <Label text="{i18n>quoteDialogPortOfDischargeLabel}" design="Bold" />
                            <Text text="{= ${quoteDialog>/PortOfDischarge} ? ${quoteDialog>/PortOfDischarge} : ${i18n>quoteDialogFieldNotMaintained} }" />

                            <Label text="{i18n>quoteDialogContactPersonLabel}" design="Bold" />
                            <Text text="{= ${quoteDialog>/ContactPerson} ? (${quoteDialog>/ContactPersonName} ? (${quoteDialog>/ContactPersonName} + ' (' + ${quoteDialog>/ContactPerson} + ')') : ${quoteDialog>/ContactPerson}) : ${i18n>quoteDialogFieldNotMaintained} }" />

                            <Label text="{i18n>quoteDialogNetAmountLabel}" design="Bold" />
                            <ObjectNumber
                                number="{quoteDialog>/TotalNetAmount}"
                                unit="{quoteDialog>/TransactionCurrency}"
                                state="Success" />
                        </form:content>
                    </form:SimpleForm>
                </Panel>

                <!-- Prompt Parameters Required for Quotation Creation -->
                <Panel
                    headerText="{i18n>quoteDialogParamsPanelHeader}"
                    expandable="false"
                    class="sapUiNoContentPadding sapUiSmallMarginBottom">
                    <form:SimpleForm
                        editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="4"
                        labelSpanL="4"
                        labelSpanM="4"
                        labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="0"
                        emptySpanL="0"
                        emptySpanM="0"
                        emptySpanS="0"
                        columnsXL="1"
                        columnsL="1"
                        columnsM="1"
                        singleContainerFullSize="false">
                        <form:content>
                            <Label text="{i18n>quoteDialogTypeLabel}" required="true" design="Bold" />
                            <Select
                                id="selQuotationType"
                                selectedKey="{quoteDialog>/SalesQuotationType}"
                                width="100%">
                                <core:Item key="ZQT" text="{i18n>quoteDialogTypeStandard}" />
                                <core:Item key="ZBQT" text="{i18n>quoteDialogTypeBudgetary}" />
                            </Select>

                            <Label text="{i18n>quoteDialogDateLabel}" required="true" design="Bold" />
                            <DatePicker
                                id="dpQuotationDate"
                                value="{quoteDialog>/SalesQuotationDate}"
                                valueFormat="yyyy-MM-dd"
                                displayFormat="yyyy-MM-dd"
                                width="100%" />

                            <Label text="{i18n>quoteDialogValidToLabel}" required="true" design="Bold" />
                            <DatePicker
                                id="dpValidToDate"
                                value="{quoteDialog>/BindingPeriodValidityEndDate}"
                                valueFormat="yyyy-MM-dd"
                                displayFormat="yyyy-MM-dd"
                                width="100%" />

                            <Label text="{i18n>quoteDialogCustRefLabel}" design="Bold" />
                            <Input
                                id="inCustomerReference"
                                value="{quoteDialog>/PurchaseOrderByCustomer}"
                                placeholder="{i18n>quoteDialogCustRefPlaceholder}"
                                width="100%" />

                            <Label text="{i18n>quoteDialogCustRefDateLabel}" design="Bold" />
                            <DatePicker
                                id="dpCustomerRefDate"
                                value="{quoteDialog>/CustomerPurchaseOrderDate}"
                                valueFormat="yyyy-MM-dd"
                                displayFormat="yyyy-MM-dd"
                                width="100%" />

                            <Label text="{i18n>quoteDialogContactPersonLabel}" design="Bold" />
                            <Input
                                id="inQuoteContactPerson"
                                value="{quoteDialog>/ContactPerson}"
                                placeholder="{i18n>salesInquiryPlaceholderContactPerson}"
                                maxLength="10"
                                liveChange=".onQuoteFieldChange"
                                width="100%" />

                            <Label text="{i18n>quoteDialogCustomerGroup2Label}" design="Bold" />
                            <Input
                                id="inQuoteCustomerGroup2"
                                value="{quoteDialog>/CustomerGroup2}"
                                placeholder="{i18n>salesInquiryPlaceholderCustomerGroup2}"
                                maxLength="3"
                                change=".onQuoteFieldChange"
                                width="100%" />

                            <Label text="{i18n>quoteDialogPortOfLoadingLabel}" design="Bold" />
                            <Input
                                id="inQuotePortOfLoading"
                                value="{quoteDialog>/PortOfLoading}"
                                placeholder="{i18n>salesInquiryPlaceholderPortLoading}"
                                maxLength="50"
                                change=".onQuoteFieldChange"
                                width="100%" />

                            <Label text="{i18n>quoteDialogPortOfDischargeLabel}" design="Bold" />
                            <Input
                                id="inQuotePortOfDischarge"
                                value="{quoteDialog>/PortOfDischarge}"
                                placeholder="{i18n>salesInquiryPlaceholderPortDischarge}"
                                maxLength="50"
                                change=".onQuoteFieldChange"
                                width="100%" />
                        </form:content>
                    </form:SimpleForm>
                </Panel>

                <!-- Copied Line Items Preview -->
                <Panel
                    headerText="{i18n>quoteDialogItemsPanelHeader} ({= ${quoteDialog>/items} ? ${quoteDialog>/items}.length : 0 })"
                    expandable="true"
                    expanded="false"
                    class="sapUiNoContentPadding">
                    <Table
                        id="tblQuoteReferencedItems"
                        items="{quoteDialog>/items}"
                        inset="false"
                        noDataText="{i18n>quoteDialogNoItemsText}">
                        <columns>
                            <Column width="4rem"><Text text="{i18n>quoteDialogColItem}" /></Column>
                            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>quoteDialogColMaterial}" /></Column>
                            <Column hAlign="End" width="6rem"><Text text="{i18n>quoteDialogColQuantity}" /></Column>
                            <Column width="4rem"><Text text="{i18n>quoteDialogColUnit}" /></Column>
                            <Column hAlign="End" width="7rem"><Text text="{i18n>quoteDialogColNetAmount}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{quoteDialog>SalesInquiryItem}" />
                                    <ObjectIdentifier
                                        title="{quoteDialog>Material}"
                                        text="{= ${quoteDialog>SalesInquiryItemText} || ${quoteDialog>MaterialName} || '' }" />
                                    <Text text="{quoteDialog>OrderQuantity}" />
                                    <Text text="{quoteDialog>OrderQuantityUnit}" />
                                    <ObjectNumber
                                        number="{quoteDialog>NetAmount}"
                                        unit="{quoteDialog>/TransactionCurrency}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>
            </VBox>
        </content>
        <beginButton>
            <Button
                id="btnConfirmCreateQuote"
                text="{i18n>quoteDialogBtnCreate}"
                type="Emphasized"
                icon="sap-icon://accept"
                enabled="{= !${quoteDialog>/isIncomplete} }"
                press=".onConfirmCreateSalesQuote" />
        </beginButton>
        <endButton>
            <Button
                id="btnCancelCreateQuote"
                text="{i18n>btnCancel}"
                press=".onCancelCreateSalesQuote" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
