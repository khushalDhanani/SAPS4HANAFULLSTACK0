<mvc:View
    controllerName="saps4hana.fiori.modules.sd.sales-inquiry.controller.SalesInquiries"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core">

    <Page
        id="salesInquiriesPage"
        showHeader="false"
        backgroundDesign="Solid"
        class="sapUiSizeCompact">
        <content>
            <VBox class="sapUiResponsiveMargin">
                <!-- Header Toolbar & Title -->
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom" wrap="Wrap">
                    <VBox class="sapUiTinyMarginBottom">
                        <Title text="{i18n>salesInquiriesTitle}" level="H2" titleStyle="H3" />
                        <Text text="{i18n>salesInquiriesSubtitle}" class="textMuted" />
                    </VBox>
                    <HBox alignItems="Center">
                        <Button
                            id="btnCreateInquiry"
                            text="{i18n>salesInquiryBtnCreate}"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press=".onNavigateToCreateInquiry"
                            class="sapUiTinyMarginEnd" />
                        <Button
                            id="btnRefreshInquiries"
                            icon="sap-icon://refresh"
                            text="{i18n>btnRefresh}"
                            type="Transparent"
                            press=".onRefresh" />
                    </HBox>
                </HBox>

                <!-- KPI Tiles Section -->
                <HBox class="sapUiSmallMarginBottom" wrap="Wrap">
                    <GenericTile
                        id="kpiTotalInquiries"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        header="{i18n>salesInquiriesKpiTotal}"
                        subheader="{i18n>salesInquiriesKpiTotalSub}">
                        <TileContent>
                            <NumericContent
                                id="kpiTotalInquiriesVal"
                                value="{salesInquiriesView>/totalCount}"
                                icon="sap-icon://sales-order"
                                valueColor="Neutral" />
                        </TileContent>
                    </GenericTile>

                    <GenericTile
                        id="kpiOpenInquiries"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        header="{i18n>salesInquiriesKpiOpen}"
                        subheader="{i18n>salesInquiriesKpiOpenSub}">
                        <TileContent>
                            <NumericContent
                                id="kpiOpenInquiriesVal"
                                value="{salesInquiriesView>/openCount}"
                                icon="sap-icon://document"
                                valueColor="Critical" />
                        </TileContent>
                    </GenericTile>

                    <GenericTile
                        id="kpiActiveCustomers"
                        class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                        header="{i18n>salesInquiriesKpiActiveCustomers}"
                        subheader="{i18n>salesInquiriesKpiActiveCustomersSub}">
                        <TileContent>
                            <NumericContent
                                id="kpiActiveCustomersVal"
                                value="{salesInquiriesView>/customerCount}"
                                icon="sap-icon://customer"
                                valueColor="Good" />
                        </TileContent>
                    </GenericTile>
                </HBox>

                <!-- Inquiries Table -->
                <Table
                    id="salesInquiriesTable"
                    items="{
                        path: 'salesInquiry>/SalesInquiries',
                        parameters: {
                            $count: true
                        },
                        sorter: [
                            { path: 'CreationDate', descending: true },
                            { path: 'SalesInquiry', descending: true }
                        ]
                    }"
                    growing="true"
                    growingThreshold="25"
                    growingScrollToLoad="true"
                    noDataText="{i18n>salesInquiriesNoDataText}"
                    updateFinished=".onUpdateFinished"
                    itemPress=".onInquiryPress"
                    sticky="ColumnHeaders,HeaderToolbar">
                    <headerToolbar>
                        <OverflowToolbar id="tableToolbar">
                            <Title
                                id="tableTitle"
                                text="{= 'Sales Inquiries (' + (${salesInquiriesView>/totalCount} || '0') + ')' }"
                                level="H4" />
                            <ToolbarSpacer />
                            <SearchField
                                id="searchInquiries"
                                width="18rem"
                                search=".onSearch"
                                liveChange=".onSearch"
                                placeholder="{i18n>salesInquiriesSearchPlaceholder}">
                                <layoutData>
                                    <OverflowToolbarLayoutData priority="High" shrinkable="true" minWidth="8rem" />
                                </layoutData>
                            </SearchField>
                            <Button
                                id="btnRefreshInquiriesTable"
                                icon="sap-icon://refresh"
                                tooltip="{i18n>btnRefresh}"
                                press=".onRefresh" />
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column width="8rem"><Text text="{i18n>salesInquiriesColInquiryNumber}" /></Column>
                        <Column width="5rem"><Text text="{i18n>salesInquiriesColType}" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>salesInquiriesColDescription}" /></Column>
                        <Column width="13rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>salesInquiriesColCustomer}" /></Column>
                        <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>salesInquiriesColSalesArea}" /></Column>
                        <Column width="8rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>salesInquiriesColDocDate}" /></Column>
                        <Column width="8rem" hAlign="End"><Text text="{i18n>salesInquiriesColNetAmount}" /></Column>
                        <Column width="6rem" hAlign="Center"><Text text="{i18n>salesInquiriesColStatus}" /></Column>
                        <Column width="11rem" minScreenWidth="Tablet" demandPopin="true" hAlign="Center"><Text text="{i18n>salesInquiriesColActions}" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem type="Navigation">
                            <cells>
                                <ObjectIdentifier title="{salesInquiry>SalesInquiry}" />
                                <Text text="{salesInquiry>SalesInquiryType}" />
                                <Text text="{salesInquiry>PurchaseOrderByCustomer}" />
                                <ObjectIdentifier
                                    title="{= ${salesInquiry>OrganizationBPName1} || ${salesInquiry>SoldToParty} || '' }"
                                    text="{= ${salesInquiry>OrganizationBPName1} ? ${salesInquiry>SoldToParty} : '' }" />
                                <Text text="{= (${salesInquiry>SalesOrganization} || '') + ' / ' + (${salesInquiry>DistributionChannel} || '') + ' / ' + (${salesInquiry>OrganizationDivision} || '') }" />
                                <Text text="{salesInquiry>SalesInquiryDate}" />
                                <ObjectNumber number="{salesInquiry>TotalNetAmount}" unit="{salesInquiry>TransactionCurrency}" state="Success" />
                                <ObjectStatus
                                    text="{path: 'salesInquiry>OverallSDProcessStatus', formatter: '.formatter.statusText'}"
                                    state="{path: 'salesInquiry>OverallSDProcessStatus', formatter: '.formatter.statusState'}" />
                                <Button
                                    id="btnCreateSalesQuote"
                                    text="{i18n>salesInquiriesBtnCreateQuote}"
                                    icon="sap-icon://request"
                                    type="Emphasized"
                                    enabled="true"
                                    press=".onCreateSalesQuote"
                                    tooltip="{i18n>salesInquiriesTooltipCreateQuote}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>
