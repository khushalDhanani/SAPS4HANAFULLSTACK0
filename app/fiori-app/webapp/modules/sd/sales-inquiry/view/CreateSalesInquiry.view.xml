<mvc:View
    controllerName="saps4hana.fiori.modules.sd.sales-inquiry.controller.CreateSalesInquiry"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">

    <Page
        id="createInquiryPage"
        showHeader="false"
        backgroundDesign="Solid"
        class="sapUiSizeCompact">
        <content>
            <VBox class="sapUiResponsiveMargin">
                <!-- Global Incompletion / Error Strip -->
                <MessageStrip
                    id="createInquiryMessageStrip"
                    text="{newInquiry>/errorMessage}"
                    type="Error"
                    showIcon="true"
                    showCloseButton="true"
                    visible="{newInquiry>/hasError}"
                    close=".onDismissError"
                    class="sapUiSmallMarginBottom">
                    <link>
                        <Link text="{i18n>viewIssues}" press=".onMessageButtonPress" />
                    </link>
                </MessageStrip>

                <!-- Quotation readiness: SAP-required fields this application cannot send yet -->
                <MessageStrip
                    id="createInquiryReadinessStrip"
                    text="{newInquiry>/readinessNotice}"
                    type="Warning"
                    showIcon="true"
                    showCloseButton="false"
                    visible="{newInquiry>/showReadinessNotice}"
                    class="sapUiSmallMarginBottom" />

                <!-- Header Sections Grid (6/6 Layout) -->
                <layout:Grid
                    id="gridInquiryHeaderSections"
                    defaultSpan="XL6 L6 M6 S12"
                    hSpacing="1"
                    vSpacing="0"
                    class="sapUiNoMarginTop sapUiSmallMarginBottom">

                    <!-- Section 1: Organizational Data -->
                    <Panel id="panelOrgData">
                        <layoutData>
                            <layout:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                        <headerToolbar>
                            <Toolbar>
                                <Title text="{i18n>salesInquiryPanelOrgData}" level="H3" />
                                <ToolbarSpacer />
                                <ObjectStatus
                                    id="headerInquiryStatus"
                                    text="{newInquiry>/header/StatusText}"
                                    state="{newInquiry>/header/StatusState}"
                                    icon="{newInquiry>/header/StatusIcon}" />
                            </Toolbar>
                        </headerToolbar>
                        <f:SimpleForm
                            id="inquiryOrgForm"
                            editable="true"
                            layout="ResponsiveGridLayout"
                            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                            adjustLabelSpan="false"
                            emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0"
                            columnsXL="1" columnsL="1" columnsM="1"
                            singleContainerFullSize="false">
                            <f:content>
                                <Label text="{i18n>salesInquiryLabelInquiryType}" required="true" />
                                <Input id="inInquiryType" value="{newInquiry>/header/SalesInquiryType}" placeholder="{i18n>salesInquiryPlaceholderInquiryType}" maxLength="4"
                                    valueState="{newInquiry>/errors/SalesInquiryType/state}"
                                    valueStateText="{newInquiry>/errors/SalesInquiryType/text}"
                                    change=".onInquiryTypeChange" liveChange=".onInquiryTypeChange" suggestionItemSelected=".onInquiryTypeSelect"
                                    showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: 'salesInquiry>/SalesInquiryTypeVH', templateShareable: false}">
                                    <suggestionItems>
                                        <core:ListItem key="{salesInquiry>SalesDocumentType}" text="{salesInquiry>SalesDocumentType}" additionalText="{salesInquiry>SalesDocumentTypeName}" />
                                    </suggestionItems>
                                </Input>

                                <Label text="{i18n>salesInquiryLabelSalesOrg}" required="true" />
                                <Input id="inSalesOrg" value="{newInquiry>/header/SalesOrganization}" placeholder="{i18n>salesInquiryPlaceholderSalesOrg}" maxLength="4"
                                    valueState="{newInquiry>/errors/SalesOrganization/state}"
                                    valueStateText="{newInquiry>/errors/SalesOrganization/text}"
                                    change=".onSalesOrgChange" liveChange=".onSalesOrgChange" suggestionItemSelected=".onSalesOrgSelect"
                                    showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: 'salesInquiry>/SalesOrganizationVH', templateShareable: false}">
                                    <suggestionItems>
                                        <core:ListItem key="{salesInquiry>SalesOrganization}" text="{salesInquiry>SalesOrganization}" additionalText="{salesInquiry>SalesOrganization_Text}" />
                                    </suggestionItems>
                                </Input>

                                <Label text="{i18n>salesInquiryLabelDistChannel}" required="true" />
                                <Input id="inDistChannel" value="{newInquiry>/header/DistributionChannel}" placeholder="{i18n>salesInquiryPlaceholderDistChannel}" maxLength="2"
                                    valueState="{newInquiry>/errors/DistributionChannel/state}"
                                    valueStateText="{newInquiry>/errors/DistributionChannel/text}"
                                    change=".onDistChannelChange" liveChange=".onDistChannelChange" suggestionItemSelected=".onDistChannelSelect"
                                    showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: 'salesInquiry>/DistributionChannelVH', templateShareable: false}">
                                    <suggestionItems>
                                        <core:ListItem key="{salesInquiry>DistributionChannel}" text="{salesInquiry>DistributionChannel}" additionalText="{salesInquiry>DistributionChannelName}" />
                                    </suggestionItems>
                                </Input>

                                <Label text="{i18n>salesInquiryLabelDivision}" required="true" />
                                <Input id="inDivision" value="{newInquiry>/header/OrganizationDivision}" placeholder="{i18n>salesInquiryPlaceholderDivision}" maxLength="2"
                                    valueState="{newInquiry>/errors/OrganizationDivision/state}"
                                    valueStateText="{newInquiry>/errors/OrganizationDivision/text}"
                                    change=".onDivisionChange" liveChange=".onDivisionChange" suggestionItemSelected=".onDivisionSelect"
                                    showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: 'salesInquiry>/DivisionVH', templateShareable: false}">
                                    <suggestionItems>
                                        <core:ListItem key="{salesInquiry>Division}" text="{salesInquiry>Division}" additionalText="{salesInquiry>DivisionName}" />
                                    </suggestionItems>
                                </Input>
                            </f:content>
                        </f:SimpleForm>
                    </Panel>

                    <!-- Section 2: Customer & Partner Terms -->
                    <Panel id="panelCustomerTerms">
                        <layoutData>
                            <layout:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                        <headerToolbar>
                            <Toolbar>
                                <Title text="{i18n>salesInquiryPanelCustomerTerms}" level="H3" />
                            </Toolbar>
                        </headerToolbar>
                        <f:SimpleForm
                            id="inquiryCustomerForm"
                            editable="true"
                            layout="ResponsiveGridLayout"
                            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                            adjustLabelSpan="false"
                            emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0"
                            columnsXL="1" columnsL="1" columnsM="1"
                            singleContainerFullSize="false">
                            <f:content>
                                <Label text="{i18n>salesInquiryLabelSoldToParty}" required="true" />
                                <Input id="inSoldToParty" value="{newInquiry>/header/SoldToParty}" placeholder="{i18n>salesInquiryPlaceholderCustomer}" maxLength="10"
                                    valueState="{newInquiry>/errors/SoldToParty/state}"
                                    valueStateText="{newInquiry>/errors/SoldToParty/text}"
                                    change=".onSoldToPartyChange" liveChange=".onSoldToPartyLiveChange" suggestionItemSelected=".onSoldToPartySelect"
                                    showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: 'salesInquiry>/SoldToPartyVH', templateShareable: false}">
                                    <suggestionItems>
                                        <core:ListItem key="{salesInquiry>Customer}" text="{salesInquiry>Customer}" additionalText="{salesInquiry>CustomerName}" />
                                    </suggestionItems>
                                </Input>

                                <Label text="{i18n>salesInquiryPanelCustomerDetails}" />
                                <Text id="txtCustomerName" text="{= ${newInquiry>/header/CustomerName} ? (${newInquiry>/header/CustomerName} + (${newInquiry>/header/CustomerCity} ? ' (' + ${newInquiry>/header/CustomerCity} + (${newInquiry>/header/CustomerCountry} ? ', ' + ${newInquiry>/header/CustomerCountry} : '') + ')' : (${newInquiry>/header/CustomerCountry} ? ' (' + ${newInquiry>/header/CustomerCountry} + ')' : ''))) : 'No customer selected'}" class="textMuted" />

                                <Label text="{i18n>salesInquiryLabelShipToParty}" />
                                <Input id="inShipToParty" value="{newInquiry>/header/ShipToParty}" placeholder="{i18n>salesInquiryPlaceholderCustomer}" maxLength="10"
                                    showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItemSelected=".onShipToPartySelect" suggestionItems="{path: 'salesInquiry>/CustomerVH', templateShareable: false}">
                                    <suggestionItems>
                                        <core:ListItem key="{salesInquiry>Customer}" text="{salesInquiry>Customer}" additionalText="{salesInquiry>CustomerName}" />
                                    </suggestionItems>
                                </Input>

                                <Label text="{i18n>salesInquiryCustomerGroup2}" required="{newInquiry>/capabilities/CustomerGroup2}" />
                                <Input id="inCustomerGroup2" value="{newInquiry>/header/CustomerGroup2}" placeholder="{i18n>salesInquiryPlaceholderCustomerGroup2}" maxLength="3"
                                    enabled="{newInquiry>/capabilities/CustomerGroup2}"
                                    tooltip="{i18n>salesInquiryTooltipCustomerGroup2}"
                                    valueState="{newInquiry>/errors/CustomerGroup2/state}" valueStateText="{newInquiry>/errors/CustomerGroup2/text}"
                                    change=".onHeaderFieldChange" />

                                <Label text="{i18n>salesInquiryPortOfLoading}" required="{newInquiry>/capabilities/PortOfLoading}" />
                                <Input id="inPortOfLoading" value="{newInquiry>/header/PortOfLoading}" placeholder="{i18n>salesInquiryPlaceholderPortLoading}" maxLength="50"
                                    enabled="{newInquiry>/capabilities/PortOfLoading}"
                                    tooltip="{i18n>salesInquiryTooltipPortLoading}"
                                    valueState="{newInquiry>/errors/PortOfLoading/state}" valueStateText="{newInquiry>/errors/PortOfLoading/text}"
                                    change=".onHeaderFieldChange" />

                                <Label text="{i18n>salesInquiryPortOfDischarge}" required="{newInquiry>/capabilities/PortOfDischarge}" />
                                <Input id="inPortOfDischarge" value="{newInquiry>/header/PortOfDischarge}" placeholder="{i18n>salesInquiryPlaceholderPortDischarge}" maxLength="50"
                                    enabled="{newInquiry>/capabilities/PortOfDischarge}"
                                    tooltip="{i18n>salesInquiryTooltipPortDischarge}"
                                    valueState="{newInquiry>/errors/PortOfDischarge/state}" valueStateText="{newInquiry>/errors/PortOfDischarge/text}"
                                    change=".onHeaderFieldChange" />

                                <Label text="{i18n>salesInquiryContactPerson}" required="{newInquiry>/capabilities/ContactPerson}" />
                                <Input id="inContactPerson" value="{newInquiry>/header/ContactPerson}" placeholder="{i18n>salesInquiryPlaceholderContactPerson}" maxLength="10"
                                    enabled="{newInquiry>/capabilities/ContactPerson}"
                                    tooltip="{i18n>salesInquiryTooltipContactPerson}"
                                    valueState="{newInquiry>/errors/ContactPerson/state}" valueStateText="{newInquiry>/errors/ContactPerson/text}"
                                    change=".onHeaderFieldChange" />

                                <Label text="{i18n>salesInquiryDescRef}" />
                                <Input id="inCustRef" value="{newInquiry>/header/PurchaseOrderByCustomer}" placeholder="{i18n>salesInquiryPlaceholderDesc}" maxLength="35" change=".onHeaderFieldChange" />

                                <Label text="{i18n>salesInquiryLabelCustPODate}" />
                                <DatePicker id="inCustRefDate" value="{newInquiry>/header/CustomerPurchaseOrderDate}" valueFormat="yyyy-MM-dd" displayFormat="dd-MM-yyyy" change=".onHeaderFieldChange" />

                                <Label text="{i18n>salesInquiryRequestedValidity}" required="true" />
                                <HBox alignItems="Center">
                                    <DatePicker id="inValStartDate" value="{newInquiry>/header/BindingPeriodValidityStartDate}" valueFormat="yyyy-MM-dd" displayFormat="dd-MM-yyyy" change=".onValidityDateChange" class="sapUiTinyMarginEnd" />
                                    <Text text="{i18n>toWord}" class="sapUiTinyMarginEnd" />
                                    <DatePicker id="inValEndDate" value="{newInquiry>/header/BindingPeriodValidityEndDate}" valueFormat="yyyy-MM-dd" displayFormat="dd-MM-yyyy"
                                        valueState="{newInquiry>/errors/BindingPeriodValidityEndDate/state}"
                                        valueStateText="{newInquiry>/errors/BindingPeriodValidityEndDate/text}"
                                        change=".onValidityDateChange" />
                                </HBox>

                                <Label text="{i18n>labelCurrency}" required="true" />
                                <Input id="inCurrency" value="{newInquiry>/header/TransactionCurrency}" placeholder="{i18n>salesInquiryPlaceholderCurrency}" maxLength="3"
                                    valueState="{newInquiry>/errors/TransactionCurrency/state}"
                                    valueStateText="{newInquiry>/errors/TransactionCurrency/text}"
                                    change=".onCurrencyChange" liveChange=".onCurrencyChange" suggestionItemSelected=".onCurrencySelect"
                                    showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: 'salesInquiry>/CurrencyVH', templateShareable: false}">
                                    <suggestionItems>
                                        <core:ListItem key="{salesInquiry>Currency}" text="{salesInquiry>Currency}" additionalText="{salesInquiry>Currency_Text}" />
                                    </suggestionItems>
                                </Input>
                            </f:content>
                        </f:SimpleForm>
                    </Panel>
                </layout:Grid>

                <!-- Section 3: Inquiry Line Items -->
                <Panel id="panelInquiryItems" headerText="{i18n>salesInquiryPanelItems}">
                    <headerToolbar>
                        <Toolbar>
                            <Title text="{i18n>salesInquiryItemsCountTitle} ({= ${newInquiry>/items} ? ${newInquiry>/items}.length : 0 })" level="H2" />
                            <ToolbarSpacer />
                            <Button id="btnAddItem" icon="sap-icon://add" text="{i18n>salesInquiryBtnAddItem}" press=".onAddItem" type="Transparent" />
                        </Toolbar>
                    </headerToolbar>
                    <Table
                        id="inquiryItemsTable"
                        items="{newInquiry>/items}"
                        noDataText="{i18n>salesInquiryNoItemsAdded}"
                        mode="Delete"
                        delete=".onDeleteItem"
                        autoPopinMode="true"
                        popinLayout="GridSmall">
                        <columns>
                            <Column width="4rem" importance="High"><Text text="{i18n>salesInquiryColItem}" /></Column>
                            <Column importance="High"><Text text="{i18n>salesInquiryColMaterialProduct}" /></Column>
                            <Column minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" importance="Medium"><Text text="{i18n>salesInquiryColDescription}" /></Column>
                            <Column width="6rem" hAlign="End" importance="High"><Text text="{i18n>salesInquiryColQuantity}" /></Column>
                            <Column width="5rem" importance="High"><Text text="{i18n>salesInquiryColUnit}" /></Column>
                            <Column width="5.5rem" importance="High"><Label text="{i18n>salesInquiryColPlant}" required="{newInquiry>/capabilities/Plant}" /></Column>
                            <Column width="7rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" importance="Medium"><Text text="{i18n>salesInquiryColNetPrice}" /></Column>
                            <Column width="7rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" importance="Low"><Text text="{i18n>salesInquiryColNetAmount}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{newInquiry>SalesInquiryItem}" />
                                    <Input value="{newInquiry>Material}" placeholder="{i18n>salesInquiryPlaceholderMaterial}" required="true"
                                        valueState="{newInquiry>errors/Material/state}"
                                        valueStateText="{newInquiry>errors/Material/text}"
                                        change=".onItemMaterialChange" liveChange=".onItemMaterialLiveChange" suggestionItemSelected=".onItemMaterialSelect"
                                        showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest"
                                        maxSuggestionWidth="32rem"
                                        suggestionRows="{path: 'salesInquiry>/MaterialVH', templateShareable: false}">
                                        <suggestionColumns>
                                            <Column width="8rem"><Label text="{i18n>salesInquiryColMaterial}" /></Column>
                                            <Column minScreenWidth="Tablet" demandPopin="true"><Label text="{i18n>salesInquiryColDescription}" /></Column>
                                            <Column width="5rem"><Label text="{i18n>salesInquiryColType}" /></Column>
                                            <Column width="4rem"><Label text="{i18n>salesInquiryColUnit}" /></Column>
                                        </suggestionColumns>
                                        <suggestionRows>
                                            <ColumnListItem>
                                                <cells>
                                                    <Label text="{salesInquiry>Material}" design="Bold" />
                                                    <Text text="{salesInquiry>MaterialName}" />
                                                    <ObjectStatus text="{salesInquiry>MaterialType}" state="Success" />
                                                    <Text text="{salesInquiry>MaterialBaseUnit}" />
                                                </cells>
                                            </ColumnListItem>
                                        </suggestionRows>
                                    </Input>
                                    <Input value="{newInquiry>SalesInquiryItemText}" placeholder="{i18n>salesInquiryPlaceholderItemDesc}" change=".onItemFieldChange" />
                                    <Input value="{newInquiry>OrderQuantity}" type="Number" required="true" textAlign="End"
                                        valueState="{newInquiry>errors/OrderQuantity/state}"
                                        valueStateText="{newInquiry>errors/OrderQuantity/text}"
                                        change=".onItemCalculationChange" liveChange=".onItemCalculationChange" />
                                    <Input value="{newInquiry>OrderQuantityUnit}" placeholder="{i18n>salesInquiryPlaceholderUnit}" maxLength="3" required="true"
                                        valueState="{newInquiry>errors/OrderQuantityUnit/state}"
                                        valueStateText="{newInquiry>errors/OrderQuantityUnit/text}"
                                        change=".onItemFieldChange"
                                        showValueHelp="true" showSuggestion="true" filterSuggests="false"
                                        suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItemSelected=".onItemUnitSelect"
                                        suggestionItems="{path: 'salesInquiry>/UnitOfMeasureVH', templateShareable: false}">
                                        <suggestionItems>
                                            <core:ListItem key="{salesInquiry>UnitOfMeasure}" text="{salesInquiry>UnitOfMeasure}" additionalText="{salesInquiry>UnitOfMeasure_Text}" />
                                        </suggestionItems>
                                    </Input>
                                    <Input value="{newInquiry>Plant}" placeholder="{i18n>salesInquiryPlaceholderPlant}" maxLength="4"
                                        enabled="{newInquiry>/capabilities/Plant}"
                                        tooltip="{i18n>salesInquiryTooltipPlant}"
                                        valueState="{newInquiry>errors/Plant/state}"
                                        valueStateText="{newInquiry>errors/Plant/text}"
                                        change=".onItemFieldChange" />
                                    <Input value="{newInquiry>NetPriceAmount}" type="Number" placeholder="0.00" textAlign="End" change=".onItemCalculationChange" liveChange=".onItemCalculationChange" />
                                    <ObjectNumber number="{newInquiry>NetAmount}" unit="{newInquiry>/header/TransactionCurrency}" state="Success" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>
            </VBox>
        </content>

        <!-- Footer Action Bar -->
        <footer>
            <OverflowToolbar id="createInquiryFooter">
                <Button
                    id="btnInquiryMessages"
                    icon="sap-icon://alert"
                    text="{newInquiry>/errorCount}"
                    type="Negative"
                    visible="{newInquiry>/hasError}"
                    press=".onMessageButtonPress" />
                <ToolbarSpacer />
                <HBox alignItems="Center" class="sapUiMediumMarginEnd">
                    <Label text="{i18n>salesInquiryTotalNetAmountLabel}" class="sapUiTinyMarginEnd" />
                    <ObjectNumber number="{newInquiry>/header/TotalNetAmount}" unit="{newInquiry>/header/TransactionCurrency}" emphasized="true" state="Success" />
                </HBox>
                <Button id="btnCheckIncompletion" text="{i18n>salesInquiryBtnCheckIncompletion}" icon="sap-icon://survey" press=".onCheckIncompletion" type="Default" />
                <Button id="btnCancelInquiry" text="{i18n>btnCancel}" press=".onCancel" type="Transparent" />
                <Button id="btnSaveInquiry" text="{i18n>salesInquiryBtnSubmit}" icon="sap-icon://save" press=".onSave" type="Emphasized" />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
