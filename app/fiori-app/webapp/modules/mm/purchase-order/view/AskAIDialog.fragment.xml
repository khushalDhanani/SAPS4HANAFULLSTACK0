<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- Floating launcher (bottom-right) -->
    <Button
        id="aiFab"
        icon="sap-icon://ai"
        type="Emphasized"
        tooltip="{i18n>aiDialogTitle}"
        press=".onAskAI"
        visible="{= !${aiDialog>/open} }"
        class="aiFab" />

    <!-- Assistant panel (bottom-right, non-modal) -->
    <VBox id="aiWidget" class="aiWidget" visible="{aiDialog>/open}" renderType="Bare">
        <Toolbar class="aiWidgetHeader">
            <core:Icon src="sap-icon://ai" class="sapUiTinyMarginBegin" />
            <Title text="{i18n>aiDialogTitle}" level="H3" />
            <ToolbarSpacer />
            <Button icon="sap-icon://clear-all" tooltip="{i18n>aiClear}" press=".onAIClear" type="Transparent" />
            <Button icon="sap-icon://decline" tooltip="{i18n>btnClose}" press=".onAIClose" type="Transparent" />
        </Toolbar>
        <Text text="{i18n>aiDialogHint}" class="aiWidgetHint" />
        <ScrollContainer id="aiChatScroll" vertical="true" horizontal="false" class="aiChatScroll">
            <VBox class="sapUiSmallMargin aiChatBody">
                <VBox visible="{= ${aiDialog>/messages}.length === 0 }" class="aiChatEmpty">
                    <Text text="{i18n>aiWelcome}" class="sapUiSmallMarginBottom" />
                    <Button text="{i18n>aiPresetSummary}" press=".onAIPreset" type="Transparent" icon="sap-icon://ai" class="aiSuggestion" />
                    <Button text="{i18n>aiPresetRisks}" press=".onAIPreset" type="Transparent" icon="sap-icon://ai" class="aiSuggestion" />
                    <Button text="{i18n>aiPresetSuppliers}" press=".onAIPreset" type="Transparent" icon="sap-icon://ai" class="aiSuggestion" />
                </VBox>
                <VBox items="{aiDialog>/messages}" width="100%">
                    <VBox width="100%" class="aiMsg" alignItems="{= ${aiDialog>role} === 'user' ? 'End' : 'Start' }">
                        <customData>
                            <core:CustomData key="role" value="{= ${aiDialog>error} ? 'error' : ${aiDialog>role} }" writeToDom="true" />
                        </customData>
                        <VBox class="aiBubble">
                            <customData>
                                <core:CustomData key="role" value="{= ${aiDialog>error} ? 'error' : ${aiDialog>role} }" writeToDom="true" />
                            </customData>
                            <core:HTML content="{= '&lt;div class=&quot;aiMd&quot;&gt;' + (${aiDialog>html} || '') + '&lt;/div&gt;' }" sanitizeContent="false" />
                        </VBox>
                        <Text text="{aiDialog>meta}" tooltip="{aiDialog>metaTooltip}" visible="{= !!${aiDialog>meta} }" class="aiMsgMeta" />
                    </VBox>
                </VBox>
                <HBox visible="{aiDialog>/busy}" class="aiMsg">
                    <VBox class="aiBubble aiTyping"><HBox><core:Icon src="sap-icon://ai" class="aiTypingIcon" /><Text text="{i18n>aiThinking}" /></HBox></VBox>
                </HBox>
            </VBox>
        </ScrollContainer>
        <Toolbar class="aiChatFooter">
            <Input
                id="aiInput"
                value="{aiDialog>/question}"
                placeholder="{i18n>aiQuestionPlaceholder}"
                width="100%"
                valueLiveUpdate="true"
                submit=".onAIAsk"
                enabled="{= !${aiDialog>/busy} }" />
            <Button
                icon="sap-icon://paper-plane"
                tooltip="{i18n>aiAsk}"
                type="Emphasized"
                press=".onAIAsk"
                enabled="{= !!${aiDialog>/question} &amp;&amp; !${aiDialog>/busy} }" />
        </Toolbar>
    </VBox>
</core:FragmentDefinition>
