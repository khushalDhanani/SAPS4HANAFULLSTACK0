<mvc:View
    controllerName="saps4hana.fiori.modules.mm.purchase-order.controller.PurchaseOrders"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core">
    <Page
        id="purchaseOrdersPage"
        title="{i18n>pageTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack"
        backgroundDesign="Solid">
        <headerContent>
            <ObjectStatus
                id="connectionStatus"
                text="{i18n>tagLive}"
                state="Success"
                icon="sap-icon://connected"
                class="sapUiSmallMarginEnd" />
            <Button
                id="btnUserProfilePO"
                icon="sap-icon://customer"
                text="{auth>/user/username}"
                type="Transparent"
                tooltip="{i18n>userProfileTitle}"
                press=".onOpenUserProfile"
                class="sapUiTinyMarginEnd" />
        </headerContent>
        <content>
            <VBox class="sapUiResponsiveMargin">
                <!-- KPI Tiles Section -->
                <Panel headerText="{i18n>kpiSectionTitle}" class="sapUiSmallMarginBottom">
                    <HBox id="kpiContainer" wrap="Wrap">
                        <GenericTile
                            id="kpiTotalOrders"
                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                            header="{i18n>kpiTotalOrders}"
                            subheader="{i18n>kpiTotalOrdersDesc}">
                            <TileContent>
                                <NumericContent
                                    id="kpiTotalOrdersVal"
                                    value="{viewModel>/totalCount}"
                                    icon="sap-icon://sales-order"
                                    valueColor="Neutral" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile
                            id="kpiSuppliers"
                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                            header="{i18n>kpiSuppliers}"
                            subheader="{i18n>kpiSuppliersDesc}">
                            <TileContent>
                                <NumericContent
                                    id="kpiSuppliersVal"
                                    value="{viewModel>/supplierCount}"
                                    icon="sap-icon://supplier"
                                    valueColor="Good" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile
                            id="kpiComplete"
                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                            header="{i18n>kpiComplete}"
                            subheader="{i18n>kpiCompleteDesc}">
                            <TileContent>
                                <NumericContent
                                    id="kpiCompleteVal"
                                    value="{viewModel>/completeRate}"
                                    scale="%"
                                    icon="sap-icon://accept"
                                    valueColor="Good" />
                            </TileContent>
                        </GenericTile>
                    </HBox>
                </Panel>

                <!-- Advanced Filter Bar -->
                <Panel class="sapUiSmallMarginBottom" width="auto">
                    <fb:FilterBar 
                        id="poFilterBar" 
                        search=".onFilterBarSearch" 
                        showGoOnFB="true"
                        showClearOnFB="true"
                        clear=".onFilterBarClear"
                        useToolbar="false">
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem groupName="G1" name="PurchaseOrder" label="{i18n>colPurchaseOrder}" visibleInFilterBar="true">
                                <fb:control>
                                    <Input id="fbPO" placeholder="{i18n>filterPOPlaceholder}" />
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem groupName="G1" name="Supplier" label="{i18n>colSupplier}" visibleInFilterBar="true">
                                <fb:control>
                                    <Input
                                        id="fbSupplier"
                                        placeholder="{i18n>filterSupplierPlaceholder}"
                                        showValueHelp="true"
                                        valueHelpRequest=".onValueHelpRequest"
                                        showSuggestion="true"
                                        filterSuggests="false"
                                        suggest=".onSuggest"
                                        suggestionItems="{path: '/SupplierVH', templateShareable: false}">
                                        <suggestionItems>
                                            <core:ListItem key="{Supplier}" text="{Supplier}" additionalText="{SupplierName}" />
                                        </suggestionItems>
                                    </Input>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem groupName="G1" name="CompanyCode" label="{i18n>colCompany}" visibleInFilterBar="true">
                                <fb:control>
                                    <Input
                                        id="fbCompanyCode"
                                        placeholder="{i18n>filterCompanyPlaceholder}"
                                        showValueHelp="true"
                                        valueHelpRequest=".onValueHelpRequest"
                                        showSuggestion="true"
                                        filterSuggests="false"
                                        suggest=".onSuggest"
                                        suggestionItems="{path: '/CompanyCodeVH', templateShareable: false}">
                                        <suggestionItems>
                                            <core:ListItem key="{CompanyCode}" text="{CompanyCode}" additionalText="{CompanyCodeName}" />
                                        </suggestionItems>
                                    </Input>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem groupName="G1" name="PurchasingOrganization" label="{i18n>colPurchasingOrg}" visibleInFilterBar="true">
                                <fb:control>
                                    <Input
                                        id="fbPurchasingOrg"
                                        placeholder="{i18n>filterPurchasingOrgPlaceholder}"
                                        showValueHelp="true"
                                        valueHelpRequest=".onValueHelpRequest"
                                        showSuggestion="true"
                                        filterSuggests="false"
                                        suggest=".onSuggest"
                                        suggestionItems="{path: '/PurchasingOrgVH', templateShareable: false}">
                                        <suggestionItems>
                                            <core:ListItem key="{PurchasingOrganization}" text="{PurchasingOrganization}" additionalText="{PurchasingOrganizationName}" />
                                        </suggestionItems>
                                    </Input>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem groupName="G1" name="PurchasingGroup" label="{i18n>colPurchasingGroup}" visibleInFilterBar="true">
                                <fb:control>
                                    <Input
                                        id="fbPurchasingGroup"
                                        placeholder="{i18n>filterPurchasingGroupPlaceholder}"
                                        showValueHelp="true"
                                        valueHelpRequest=".onValueHelpRequest"
                                        showSuggestion="true"
                                        filterSuggests="false"
                                        suggest=".onSuggest"
                                        suggestionItems="{path: '/PurchasingGroupVH', templateShareable: false}">
                                        <suggestionItems>
                                            <core:ListItem key="{PurchasingGroup}" text="{PurchasingGroup}" additionalText="{PurchasingGroupName}" />
                                        </suggestionItems>
                                    </Input>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem groupName="G1" name="PurchaseOrderType" label="{i18n>colDocType}" visibleInFilterBar="true">
                                <fb:control>
                                    <Input
                                        id="fbDocType"
                                        placeholder="{i18n>filterDocTypePlaceholder}"
                                        showValueHelp="true"
                                        valueHelpRequest=".onValueHelpRequest"
                                        showSuggestion="true"
                                        filterSuggests="false"
                                        suggest=".onSuggest"
                                        suggestionItems="{path: '/DocumentTypeVH', templateShareable: false}">
                                        <suggestionItems>
                                            <core:ListItem key="{PurchasingDocumentType}" text="{PurchasingDocumentType}" additionalText="{PurchasingDocumentType_Text}" />
                                        </suggestionItems>
                                    </Input>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem groupName="G1" name="CreationDate" label="{i18n>colCreationDate}" visibleInFilterBar="true">
                                <fb:control>
                                    <DateRangeSelection
                                        id="fbDateRange"
                                        placeholder="{i18n>filterDateRangePlaceholder}"
                                        displayFormat="dd-MM-yyyy"
                                        valueFormat="yyyy-MM-dd" />
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem groupName="G1" name="PurchasingCompletenessStatus" label="{i18n>colStatus}" visibleInFilterBar="true">
                                <fb:control>
                                    <Select id="fbStatus" selectedKey="" width="100%">
                                        <items>
                                            <core:Item key="" text="{i18n>filterAll}" />
                                            <core:Item key="true" text="{i18n>statusComplete}" />
                                            <core:Item key="false" text="{i18n>statusIncomplete}" />
                                        </items>
                                    </Select>
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                    </fb:FilterBar>
                </Panel>

                <!-- Responsive Table -->
                <Table
                    id="purchaseOrdersTable"
                    items="{
                        path: '/PurchaseOrders',
                        parameters: {
                            $count: true
                        },
                        sorter: [
                            { path: 'CreationDate', descending: true },
                            { path: 'PurchaseOrder', descending: true }
                        ]
                    }"
                    growing="true"
                    growingThreshold="20"
                    mode="SingleSelectMaster"
                    itemPress=".onItemPress"
                    sticky="ColumnHeaders,HeaderToolbar"
                    class="sapUiResponsiveContentPadding">
                    <headerToolbar>
                        <OverflowToolbar id="tableToolbar">
                            <Title
                                id="tableTitle"
                                text="{i18n>tableTitle}"
                                level="H2" />
                            <ToolbarSpacer />
                            <SearchField
                                id="searchField"
                                placeholder="{i18n>searchPlaceholder}"
                                width="300px"
                                search=".onSearch"
                                liveChange=".onSearch" />
                            <Button
                                id="btnRefreshTable"
                                icon="sap-icon://refresh"
                                tooltip="{i18n>btnRefresh}"
                                press=".onRefresh" />
                            <Button
                                id="btnCreatePO"
                                text="{i18n>btnCreatePO}"
                                type="Emphasized"
                                press=".onCreatePO" />
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column id="colPO" width="11rem" sortIndicator="None">
                            <header>
                                <Link id="linkColPO" text="{i18n>colPurchaseOrder}" press=".onSortColumn">
                                    <customData>
                                        <core:CustomData key="sortProperty" value="PurchaseOrder" />
                                    </customData>
                                </Link>
                            </header>
                        </Column>
                        <Column id="colSup" width="15rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" sortIndicator="None">
                            <header>
                                <Link id="linkColSup" text="{i18n>colSupplier}" press=".onSortColumn">
                                    <customData>
                                        <core:CustomData key="sortProperty" value="SupplierName" />
                                    </customData>
                                </Link>
                            </header>
                        </Column>
                        <Column id="colCo" width="12rem" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline" sortIndicator="None">
                            <header>
                                <Link id="linkColCo" text="{i18n>colCompany}" press=".onSortColumn">
                                    <customData>
                                        <core:CustomData key="sortProperty" value="CompanyCode" />
                                    </customData>
                                </Link>
                            </header>
                        </Column>
                        <Column id="colOrg" width="12rem" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline" sortIndicator="None">
                            <header>
                                <Link id="linkColOrg" text="{i18n>colPurchasingOrg}" press=".onSortColumn">
                                    <customData>
                                        <core:CustomData key="sortProperty" value="PurchasingOrganization" />
                                    </customData>
                                </Link>
                            </header>
                        </Column>
                        <Column id="colDate" width="10rem" minScreenWidth="Tablet" demandPopin="true" popinDisplay="Inline" sortIndicator="Descending">
                            <header>
                                <Link id="linkColDate" text="{i18n>colCreationDate}" press=".onSortColumn">
                                    <customData>
                                        <core:CustomData key="sortProperty" value="CreationDate" />
                                    </customData>
                                </Link>
                            </header>
                        </Column>
                        <Column id="colStat" width="9rem" hAlign="Center" sortIndicator="None">
                            <header>
                                <Link id="linkColStat" text="{i18n>colStatus}" press=".onSortColumn">
                                    <customData>
                                        <core:CustomData key="sortProperty" value="PurchasingCompletenessStatus" />
                                    </customData>
                                </Link>
                            </header>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem
                            id="poRow"
                            type="Navigation">
                            <cells>
                                <ObjectIdentifier
                                    id="poId"
                                    title="{PurchaseOrder}"
                                    text="{PurchaseOrderType}" />
                                <ObjectIdentifier
                                    id="poSupplier"
                                    title="{SupplierName}"
                                    text="{Supplier}" />
                                <Text
                                    id="poCompany"
                                    text="{CompanyCode} ({CompanyCodeName})" />
                                <Text
                                    id="poOrg"
                                    text="{PurchasingOrganization} / {PurchasingGroup}" />
                                <Text
                                    id="poDate"
                                    text="{
                                        path: 'CreationDate',
                                        formatter: '.formatter.formatDate'
                                    }" />
                                <ObjectStatus
                                    id="poStatus"
                                    text="{
                                        path: 'PurchasingCompletenessStatus',
                                        formatter: '.formatter.completenessText'
                                    }"
                                    state="{
                                        path: 'PurchasingCompletenessStatus',
                                        formatter: '.formatter.completenessState'
                                    }"
                                    icon="{
                                        path: 'PurchasingCompletenessStatus',
                                        formatter: '.formatter.completenessIcon'
                                    }" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>
