<mvc:View
    controllerName="saps4hana.fiori.modules.mm.purchase-order.controller.CreatePurchaseOrder"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout">

    <Page
        id="createPOPage"
        showHeader="false"
        backgroundDesign="Solid"
        class="sapUiSizeCompact">
        <content>
            <VBox class="sapUiResponsiveMargin">
                <!-- Global In-Page Validation Message Banner -->
                <MessageStrip
                    id="createPOMessageStrip"
                    text="{newPO>/errorMessage}"
                    type="Error"
                    showIcon="true"
                    showCloseButton="true"
                    visible="{newPO>/hasError}"
                    close=".onDismissError"
                    class="sapUiSmallMarginBottom">
                    <link>
                        <Link text="{i18n>viewAllIssuesPrefix} {newPO>/errorCount} {i18n>issuesSuffix}" press=".onMessageButtonPress" />
                    </link>
                </MessageStrip>

                <!-- Header Sections Grid (6/6 Layout) -->
                <layout:Grid
                    id="gridHeaderSections"
                    defaultSpan="XL6 L6 M6 S12"
                    hSpacing="1"
                    vSpacing="0"
                    class="sapUiNoMarginTop sapUiSmallMarginBottom">
                    <!-- Section 1: General & Organizational Data -->
                    <Panel id="panelGeneralData">
                        <layoutData>
                            <layout:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                        <headerToolbar>
                            <Toolbar>
                                <Title text="{i18n>poPanelGeneralData}" level="H3" />
                                <ToolbarSpacer />
                                <ObjectStatus
                                    id="headerPOStatus"
                                    text="{newPO>/header/StatusText}"
                                    state="{newPO>/header/StatusState}"
                                    icon="{newPO>/header/StatusIcon}" />
                            </Toolbar>
                        </headerToolbar>
                        <f:SimpleForm
                            id="poHeaderForm"
                            editable="true"
                            layout="ResponsiveGridLayout"
                            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                            adjustLabelSpan="false"
                            emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0"
                            columnsXL="1" columnsL="1" columnsM="1"
                            singleContainerFullSize="false">
                            <f:content>
                                <Label text="{i18n>colDocType}" required="true" />
                                <Input id="inDocType" value="{newPO>/header/PurchaseOrderType}" placeholder="{i18n>poPlaceholderDocType}" maxLength="4"
                                    valueState="{newPO>/errors/PurchaseOrderType/state}"
                                    valueStateText="{newPO>/errors/PurchaseOrderType/text}"
                                    change=".onDocTypeChange" liveChange=".onDocTypeChange" suggestionItemSelected=".onDocTypeSelect"
                                    showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: '/DocumentTypeVH', templateShareable: false}">
                                    <suggestionItems>
                                        <core:ListItem key="{PurchasingDocumentType}" text="{PurchasingDocumentType}" additionalText="{PurchasingDocumentType_Text}" />
                                    </suggestionItems>
                                </Input>

                                <Label text="{i18n>colStatus}" />
                                <ObjectStatus
                                    id="formPOStatus"
                                    text="{newPO>/header/StatusText}"
                                    state="{newPO>/header/StatusState}"
                                    icon="{newPO>/header/StatusIcon}" />

                                <Label text="{i18n>salesInquiryLabelDocDate}" required="true" />
                                <DatePicker id="inDocDate" value="{newPO>/header/DocumentDate}" valueFormat="yyyy-MM-dd" displayFormat="dd-MM-yyyy" required="true"
                                    valueState="{newPO>/errors/DocumentDate/state}"
                                    valueStateText="{newPO>/errors/DocumentDate/text}"
                                    change=".onDocDateChange" />

                                <Label text="{i18n>colCompany}" required="true" />
                                <Input id="inCompanyCode" value="{newPO>/header/CompanyCode}" placeholder="{i18n>poPlaceholderCompanyCode}" maxLength="4"
                                    valueState="{newPO>/errors/CompanyCode/state}"
                                    valueStateText="{newPO>/errors/CompanyCode/text}"
                                    change=".onCompanyCodeChange" liveChange=".onCompanyCodeChange" suggestionItemSelected=".onCompanyCodeSelect"
                                    showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: '/CompanyCodeVH', templateShareable: false}">
                                    <suggestionItems>
                                        <core:ListItem key="{CompanyCode}" text="{CompanyCode}" additionalText="{CompanyCodeName}" />
                                    </suggestionItems>
                                </Input>

                                <Label text="{i18n>colPurchasingOrg}" required="true" />
                                <Input id="inPurchOrg" value="{newPO>/header/PurchasingOrganization}" placeholder="{i18n>poPlaceholderPurchasingOrg}" maxLength="4"
                                    valueState="{newPO>/errors/PurchasingOrganization/state}"
                                    valueStateText="{newPO>/errors/PurchasingOrganization/text}"
                                    change=".onPurchOrgChange" liveChange=".onPurchOrgChange" suggestionItemSelected=".onPurchOrgSelect"
                                    showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: '/PurchasingOrgVH', templateShareable: false}">
                                    <suggestionItems>
                                        <core:ListItem key="{PurchasingOrganization}" text="{PurchasingOrganization}" additionalText="{PurchasingOrganizationName}" />
                                    </suggestionItems>
                                </Input>

                                <Label text="{i18n>colPurchasingGroup}" required="true" />
                                <Input id="inPurchGrp" value="{newPO>/header/PurchasingGroup}" placeholder="{i18n>poPlaceholderPurchasingGroup}" maxLength="3"
                                    valueState="{newPO>/errors/PurchasingGroup/state}"
                                    valueStateText="{newPO>/errors/PurchasingGroup/text}"
                                    change=".onPurchGrpChange" liveChange=".onPurchGrpChange" suggestionItemSelected=".onPurchGrpSelect"
                                    showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: '/PurchasingGroupVH', templateShareable: false}">
                                    <suggestionItems>
                                        <core:ListItem key="{PurchasingGroup}" text="{PurchasingGroup}" additionalText="{PurchasingGroupName}" />
                                    </suggestionItems>
                                </Input>
                            </f:content>
                        </f:SimpleForm>
                    </Panel>

                    <!-- Section 2: Supplier & Commercial Terms -->
                    <Panel id="panelSupplierTerms">
                        <layoutData>
                            <layout:GridData span="XL6 L6 M6 S12" />
                        </layoutData>
                        <headerToolbar>
                            <Toolbar>
                                <Title text="{i18n>poPanelSupplierTerms}" level="H3" />
                            </Toolbar>
                        </headerToolbar>
                        <f:SimpleForm
                            id="poSupplierTermsForm"
                            editable="true"
                            layout="ResponsiveGridLayout"
                            labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                            adjustLabelSpan="false"
                            emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0"
                            columnsXL="1" columnsL="1" columnsM="1"
                            singleContainerFullSize="false">
                            <f:content>
                                <Label text="{i18n>colSupplier}" required="true" />
                                <Input id="inSupplier" value="{newPO>/header/Supplier}" placeholder="{i18n>poPlaceholderSupplier}" maxLength="10"
                                    valueState="{newPO>/errors/Supplier/state}"
                                    valueStateText="{newPO>/errors/Supplier/text}"
                                    change=".onSupplierChange" liveChange=".onSupplierLiveChange" suggestionItemSelected=".onSupplierSelect"
                                    showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: '/SupplierVH', templateShareable: false}">
                                    <suggestionItems>
                                        <core:ListItem key="{Supplier}" text="{Supplier}" additionalText="{= ${SupplierName} + (${CompanyCode} ? ' (' + ${CompanyCode} + ')' : '') }" />
                                    </suggestionItems>
                                </Input>

                                <Label text="{i18n>labelCurrency}" required="true" />
                                <Input id="inCurrency" value="{newPO>/header/Currency}" placeholder="{i18n>poPlaceholderCurrency}" maxLength="5"
                                    valueState="{newPO>/errors/Currency/state}"
                                    valueStateText="{newPO>/errors/Currency/text}"
                                    change=".onCurrencyChange" liveChange=".onCurrencyChange" suggestionItemSelected=".onCurrencySelect"
                                    showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: '/CurrencyVH', templateShareable: false}">
                                    <suggestionItems>
                                        <core:ListItem key="{Currency}" text="{Currency}" additionalText="{Currency_Text}" />
                                    </suggestionItems>
                                </Input>

                                <Label text="{i18n>labelPaymentTerms}" />
                                <Input id="inPaymentTerms" value="{newPO>/header/PaymentTerms}" placeholder="{i18n>poPlaceholderPaymentTerms}" maxLength="4"
                                    valueState="{newPO>/errors/PaymentTerms/state}"
                                    valueStateText="{newPO>/errors/PaymentTerms/text}"
                                    change=".onPaymentTermsChange" liveChange=".onPaymentTermsChange" suggestionItemSelected=".onPaymentTermsSelect"
                                    showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: '/PaymentTermsVH', templateShareable: false}">
                                    <suggestionItems>
                                        <core:ListItem key="{PaymentTerms}" text="{PaymentTerms}" additionalText="{PaymentTermsName}" />
                                    </suggestionItems>
                                </Input>

                                <Label text="{i18n>labelIncoterms}" />
                                <Input id="inIncoterms" value="{newPO>/header/IncotermsClassification}" placeholder="{i18n>poPlaceholderIncoterms}" maxLength="3"
                                    valueState="{newPO>/errors/IncotermsClassification/state}"
                                    valueStateText="{newPO>/errors/IncotermsClassification/text}"
                                    change=".onIncotermsChange" liveChange=".onIncotermsChange" suggestionItemSelected=".onIncotermsSelect"
                                    showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: '/IncotermsClassificationVH', templateShareable: false}">
                                    <suggestionItems>
                                        <core:ListItem key="{IncotermsClassification}" text="{IncotermsClassification}" additionalText="{IncotermsClassificationName}" />
                                    </suggestionItems>
                                </Input>

                                <Label text="{i18n>labelIncotermsLoc}" />
                                <Input id="inIncotermsLoc" value="{newPO>/header/IncotermsLocation1}" placeholder="{i18n>poPlaceholderIncotermsLoc}" maxLength="70"
                                    valueState="{newPO>/errors/IncotermsLocation1/state}"
                                    valueStateText="{newPO>/errors/IncotermsLocation1/text}"
                                    change=".onIncotermsLocChange" liveChange=".onIncotermsLocChange" />
                            </f:content>
                        </f:SimpleForm>
                    </Panel>

                </layout:Grid>

                <Panel headerText="{i18n>poHeaderItems}">
                    <headerToolbar>
                        <Toolbar>
                            <Title text="{i18n>poItemsTitle} ({= ${newPO>/items}.length })" level="H2"/>
                            <ToolbarSpacer />
                            <Button icon="sap-icon://add" text="{i18n>poBtnAddItem}" press=".onAddItem" type="Transparent" />
                        </Toolbar>
                    </headerToolbar>
                    <Table
                        id="poItemsTable"
                        items="{newPO>/items}"
                        noDataText="{i18n>poNoItemsAdded}"
                        mode="Delete"
                        delete=".onDeleteItem">
                        <columns>
                            <Column width="4rem"><Text text="{i18n>poColItem}" /></Column>
                            <Column width="9rem"><Text text="{i18n>poColPlant}" /></Column>
                            <Column width="9rem"><Text text="{i18n>poColStorageLocation}" /></Column>
                            <Column width="11rem"><Text text="{i18n>poColMaterial}" /></Column>
                            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>poColDescription}" /></Column>
                            <Column width="7rem" hAlign="End"><Text text="{i18n>poColQuantity}" /></Column>
                            <Column width="6rem"><Text text="{i18n>poColUnit}" /></Column>
                            <Column width="7.5rem" hAlign="End"><Text text="{i18n>poColNetPrice}" /></Column>
                            <Column width="6.5rem"><Text text="{i18n>poColTaxCode}" /></Column>
                            <Column width="8rem" hAlign="End"><Text text="{i18n>poColNetAmount}" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                     <Text text="{newPO>PurchaseOrderItem}" />
                                    <Input value="{newPO>Plant}" placeholder="{i18n>poPlaceholderPlant}" required="true"
                                        valueState="{newPO>errors/Plant/state}"
                                        valueStateText="{newPO>errors/Plant/text}"
                                        change=".onItemFieldChange" liveChange=".onItemFieldChange"
                                        showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: '/PlantVH', templateShareable: false}">
                                        <suggestionItems>
                                            <core:ListItem key="{Plant}" text="{Plant}" additionalText="{= ${PlantName} + (${PurchasingOrganization} ? ' (' + ${PurchasingOrganization} + ')' : '') }" />
                                        </suggestionItems>
                                    </Input>
                                    <Input value="{newPO>StorageLocation}" placeholder="{i18n>poPlaceholderStorageLocation}" required="true"
                                        valueState="{newPO>errors/StorageLocation/state}"
                                        valueStateText="{newPO>errors/StorageLocation/text}"
                                        change=".onItemFieldChange" liveChange=".onItemFieldChange"
                                        showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: '/StorageLocationVH', templateShareable: false}">
                                        <suggestionItems>
                                            <core:ListItem key="{StorageLocation}" text="{StorageLocation}" additionalText="{= ${StorageLocationName} + (${Plant} ? ' (' + ${Plant} + ')' : '') }" />
                                        </suggestionItems>
                                    </Input>
                                    <Input value="{newPO>Material}" placeholder="{i18n>poPlaceholderMaterial}" required="true"
                                        valueState="{newPO>errors/Material/state}"
                                        valueStateText="{newPO>errors/Material/text}"
                                        change=".onItemMaterialChange" liveChange=".onItemMaterialChange" suggestionItemSelected=".onItemMaterialSelect"
                                        showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: '/MaterialVH', templateShareable: false}">
                                        <suggestionItems>
                                            <core:ListItem key="{Material}" text="{Material}" additionalText="{= (${MaterialName} || ${Material_Text} || '') + (${MaterialBaseUnit} ? ' (' + ${MaterialBaseUnit} + ')' : '') }" />
                                        </suggestionItems>
                                    </Input>
                                    <Input value="{newPO>PurchaseOrderItemText}" placeholder="{i18n>poPlaceholderItemText}" change=".onItemFieldChange" />
                                    <Input value="{newPO>OrderQuantity}" type="Number" required="true" textAlign="End"
                                        valueState="{newPO>errors/OrderQuantity/state}"
                                        valueStateText="{newPO>errors/OrderQuantity/text}"
                                        change=".onCalculateNetAmount" liveChange=".onCalculateNetAmount" />
                                    <Input value="{newPO>UnitOfMeasure}" placeholder="{i18n>poPlaceholderUnit}" required="true"
                                        valueState="{newPO>errors/UnitOfMeasure/state}"
                                        valueStateText="{newPO>errors/UnitOfMeasure/text}"
                                        change=".onItemFieldChange" liveChange=".onItemFieldChange"
                                        showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: '/UnitOfMeasureVH', templateShareable: false}">
                                        <suggestionItems>
                                            <core:ListItem key="{UnitOfMeasure}" text="{UnitOfMeasure}" additionalText="{UnitOfMeasure_Text}" />
                                        </suggestionItems>
                                    </Input>
                                    <Input value="{newPO>NetPriceAmount}" type="Number" placeholder="0.00" textAlign="End"
                                        valueState="{newPO>errors/NetPriceAmount/state}"
                                        valueStateText="{newPO>errors/NetPriceAmount/text}"
                                        change=".onCalculateNetAmount" liveChange=".onCalculateNetAmount" />
                                    <Input value="{newPO>TaxCode}" placeholder="{i18n>poPlaceholderTaxCode}" maxLength="2"
                                        valueState="{newPO>errors/TaxCode/state}"
                                        valueStateText="{newPO>errors/TaxCode/text}"
                                        change=".onItemFieldChange" liveChange=".onItemFieldChange"
                                        showValueHelp="true" showSuggestion="true" filterSuggests="false" suggest=".onSuggest" valueHelpRequest=".onValueHelpRequest" suggestionItems="{path: '/TaxCodeVH', templateShareable: false}">
                                        <suggestionItems>
                                            <core:ListItem key="{TaxCode}" text="{TaxCode}" additionalText="{TaxCode_Text}" />
                                        </suggestionItems>
                                    </Input>
                                    <Input value="{newPO>NetAmount}" type="Number" placeholder="0.00" textAlign="End" editable="false" />
                                 </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>
            </VBox>
        </content>
        <footer>
            <OverflowToolbar>
                <Button
                    id="btnMessages"
                    icon="sap-icon://alert"
                    text="{newPO>/errorCount}"
                    type="Negative"
                    visible="{newPO>/hasError}"
                    press=".onMessageButtonPress" />
                <ToolbarSpacer />
                <Button id="btnSave" text="{i18n>btnCreate}" type="Emphasized" press=".onCreatePress" />
                <Button id="btnCancel" text="{i18n>btnCancel}" press=".onCancelPress" />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
