<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Dialog
        id="sapLogsDetailDialog"
        title="{i18n>sapLogsDetailTitle}"
        contentWidth="40rem"
        type="Standard">
        <content>
            <VBox class="sapUiSmallMargin">
                <form:Form id="formSapLogsDetail" editable="false">
                    <form:layout>
                        <form:ColumnLayout columnsM="2" columnsL="2" columnsXL="2" />
                    </form:layout>
                    <form:formContainers>
                        <form:FormContainer title="{i18n>sapLogsDetailGeneralSection}">
                            <form:formElements>
                                <form:FormElement label="{i18n>sapLogsColTime}">
                                    <form:fields>
                                        <Text text="{path: 'sapLogsView>/selectedEntry/timestamp', formatter: '.formatSapLogsUtc'}" />
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>sapLogsDetailServerTime}">
                                    <form:fields>
                                        <Text text="{= ${sapLogsView>/selectedEntry/serverTimestamp} || (${sapLogsView>/selectedEntry/serverDate} ? (${sapLogsView>/selectedEntry/serverDate} + ' ' + ${sapLogsView>/selectedEntry/serverTime}) : '-') }" />
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>sapLogsColType}">
                                    <form:fields>
                                        <ObjectStatus
                                            text="{= ${sapLogsView>/selectedEntry/entryType} || ${sapLogsView>/selectedEntry/eventId} || '-' }"
                                            state="{parts: ['sapLogsView>/selectedEntry/entryType', 'sapLogsView>/selectedEntry/severity'], formatter: '.formatSapLogsSeverityState'}"
                                            icon="{parts: ['sapLogsView>/selectedEntry/entryType', 'sapLogsView>/selectedEntry/severity'], formatter: '.formatSapLogsSeverityIcon'}" />
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>sapLogsColInstance}">
                                    <form:fields>
                                        <Text text="{= ${sapLogsView>/selectedEntry/instance} || '-' }" />
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>sapLogsColClient}">
                                    <form:fields>
                                        <Text text="{= ${sapLogsView>/selectedEntry/client} || '-' }" />
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>sapLogsColUser}">
                                    <form:fields>
                                        <Text text="{= ${sapLogsView>/selectedEntry/user} || ${i18n>sapLogsUserRedacted} }" />
                                    </form:fields>
                                </form:FormElement>
                            </form:formElements>
                        </form:FormContainer>

                        <form:FormContainer title="{i18n>sapLogsDetailTechSection}">
                            <form:formElements>
                                <form:FormElement label="{i18n>sapLogsColTcode}">
                                    <form:fields>
                                        <Text text="{= ${sapLogsView>/selectedEntry/tcode} || '-' }" />
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>sapLogsColProgram}">
                                    <form:fields>
                                        <Text text="{= ${sapLogsView>/selectedEntry/program} || ${sapLogsView>/selectedEntry/report} || '-' }" />
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>sapLogsDetailProcess}">
                                    <form:fields>
                                        <Text text="{= ${sapLogsView>/selectedEntry/processId} || ${sapLogsView>/selectedEntry/taskNo} || '-' }" />
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>sapLogsDetailTerminal}">
                                    <form:fields>
                                        <Text text="{= ${sapLogsView>/selectedEntry/terminal} || '-' }" />
                                    </form:fields>
                                </form:FormElement>
                            </form:formElements>
                        </form:FormContainer>

                        <form:FormContainer title="{i18n>sapLogsDetailMessageSection}">
                            <form:formElements>
                                <form:FormElement label="{i18n>sapLogsDetailMessageText}">
                                    <form:fields>
                                        <Text text="{= ${sapLogsView>/selectedEntry/messageText} || '-' }" />
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>sapLogsDetailMessageRaw}">
                                    <form:fields>
                                        <Text text="{= ${sapLogsView>/selectedEntry/message} || '-' }" />
                                    </form:fields>
                                </form:FormElement>
                            </form:formElements>
                        </form:FormContainer>
                    </form:formContainers>
                </form:Form>
            </VBox>
        </content>
        <endButton>
            <Button
                id="btnSapLogsDetailClose"
                text="{i18n>sapLogsDetailClose}"
                press=".onCloseSapLogsDetailDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
