<mvc:View
    controllerName="saps4hana.fiori.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <!--
        Every figure on this page is a count read live from SAP S/4HANA by getDashboardMetrics.
        A tile shows "Loading" until the count arrives and "Failed" when SAP did not return it;
        nothing is defaulted, sampled or simulated. Tiles either open a working app or show a count.
    -->
    <Page
        id="dashboardPage"
        showHeader="false"
        backgroundDesign="Solid"
        class="sapUiSizeCompact">
        <content>
            <VBox class="sapUiResponsiveMargin">
                <!-- Hero Header & Global Actions -->
                <HBox class="sapUiSmallMarginBottom dashboardHeroHeader" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
                    <VBox class="sapUiTinyMarginBottom dashboardHeroTitleContainer">
                        <HBox alignItems="Center" wrap="Wrap" class="dashboardUserGreetingRow">
                            <Title text="{i18n>dashboardSubtitle}" level="H2" titleStyle="H5" wrapping="true" class="sapUiTinyMarginEnd" />
                            <ObjectStatus
                                id="dashboardConnectionStatus"
                                text="{dashboardView>/connectionText}"
                                state="{dashboardView>/connectionState}"
                                inverted="false" />
                        </HBox>
                    </VBox>
                    <HBox alignItems="Center" wrap="Wrap" class="sapUiTinyMarginBottom dashboardHeroActions">
                        <Button
                            id="btnQuickCreatePO"
                            text="{i18n>dashboardModuleMMCreate}"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press=".onNavigateToCreatePO"
                            class="sapUiTinyMarginEnd" />
                        <Button
                            id="btnQuickManagePOs"
                            text="{i18n>dashboardModuleMMAction}"
                            icon="sap-icon://open-folder"
                            type="Default"
                            press=".onNavigateToPurchaseOrders"
                            class="sapUiTinyMarginEnd" />
                        <Button
                            id="btnRefreshDashboard"
                            icon="sap-icon://refresh"
                            text="{i18n>btnRefresh}"
                            type="Transparent"
                            tooltip="{i18n>btnRefresh}"
                            press=".onRefresh" />
                    </HBox>
                </HBox>

                <MessageStrip
                    id="dashboardMetricsError"
                    text="{dashboardView>/metricsError}"
                    type="Error"
                    showIcon="true"
                    visible="{= !!${dashboardView>/metricsError} }"
                    class="sapUiSmallMarginBottom" />

                <VBox id="dashboardSections">
                    <items>
                        <!-- OVERVIEW -->
                        <VBox id="sectionOverview" visible="{= ${dashboardView>/selectedTab} === 'overview' }">
                            <VBox class="sapUiSmallMarginTop">


                                <!-- Supply Chain & Sales -->
                                <Panel
                                    id="panelCategorySupplyChain"
                                    headerText="{i18n>overviewCategorySupplyChain}"
                                    class="sapUiSmallMarginBottom"
                                    expandable="true"
                                    expanded="true">
                                    <HBox wrap="Wrap" alignItems="Center" class="dashboardTileContainer">
                                        <GenericTile
                                            id="tileModuleMM"
                                            header="{i18n>dashboardModuleMM}"
                                            subheader="{i18n>dashboardModuleMMSub}"
                                            press=".onNavigateToPurchaseOrders"
                                            state="{path: 'dashboardView>/totalCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="{i18n>dashboardKpiActivePOs}">
                                                <NumericContent id="kpiTotalPOsVal" value="{path: 'dashboardView>/totalCount', formatter: '.formatMetricValue'}" icon="sap-icon://sales-order" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            id="tileModuleSuppliers"
                                            header="{i18n>dashboardKpiSuppliers}"
                                            subheader="{i18n>dashboardKpiSuppliersDesc}"
                                            press=".onNavigateToPurchaseOrders"
                                            state="{path: 'dashboardView>/supplierCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="{i18n>dashSuppliers}">
                                                <NumericContent id="kpiSuppliersVal" value="{path: 'dashboardView>/supplierCount', formatter: '.formatMetricValue'}" icon="sap-icon://supplier" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            id="tileOverviewSD"
                                            header="{i18n>tabSDTitle}"
                                            subheader="{i18n>dashOpenSalesOrders}"
                                            press=".onSelectTabSD"
                                            state="{path: 'dashboardView>/openSalesOrderCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="{i18n>dashOpenOrders}">
                                                <NumericContent value="{path: 'dashboardView>/openSalesOrderCount', formatter: '.formatMetricValue'}" icon="sap-icon://sales-order" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            id="tileOverviewCreateSalesOrder"
                                            header="{i18n>dashCreateSalesOrder}"
                                            subheader="{i18n>dashNewOrderVA01}"
                                            press=".onNavigateToCreateSalesOrder"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="{i18n>dashAction}">
                                                <NumericContent icon="sap-icon://add" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            id="tileOverviewEWM"
                                            header="{i18n>tabEWMTitle}"
                                            subheader="{i18n>dashWarehouses}"
                                            press=".onSelectTabEWM"
                                            state="{path: 'dashboardView>/warehouseCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="{i18n>dashWarehouses}">
                                                <NumericContent value="{path: 'dashboardView>/warehouseCount', formatter: '.formatMetricValue'}" icon="sap-icon://inventory" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            id="tileOverviewGoodsReceipt"
                                            header="{i18n>dashGoodsReceipt101}"
                                            subheader="{i18n>dashInboundDeliveries}"
                                            press=".onNavigateToGoodsReceipt"
                                            state="{path: 'dashboardView>/inboundDeliveryCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="{i18n>dashDeliveries}">
                                                <NumericContent value="{path: 'dashboardView>/inboundDeliveryCount', formatter: '.formatMetricValue'}" icon="sap-icon://inbox" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            id="tileOverviewOrdersDueForDelivery"
                                            header="{i18n>tileOrdersDueForDeliveryTitle}"
                                            subheader="{i18n>tileOrdersDueForDeliverySub}"
                                            press=".onNavigateToOrdersDueForDelivery"
                                            state="{path: 'dashboardView>/ordersDueCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="{i18n>tileOrdersDueForDeliveryUnit}">
                                                <NumericContent value="{path: 'dashboardView>/ordersDueCount', formatter: '.formatMetricValue'}" icon="sap-icon://shipping-status" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            id="tileOverviewCustomerInvoices"
                                            header="{i18n>tileCustomerInvoicesTitle}"
                                            subheader="{i18n>tileCustomerInvoicesSub}"
                                            press=".onNavigateToCustomerInvoices"
                                            state="{path: 'dashboardView>/customerInvoiceCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="{i18n>tileCustomerInvoicesUnit}">
                                                <NumericContent value="{path: 'dashboardView>/customerInvoiceCount', formatter: '.formatMetricValue'}" icon="sap-icon://customer-financial-fact-sheet" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            id="tileOverviewCustomerReturns"
                                            header="{i18n>tileCustomerReturnsTitle}"
                                            subheader="{i18n>tileCustomerReturnsSub}"
                                            press=".onNavigateToCustomerReturns"
                                            state="{path: 'dashboardView>/customerReturnCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="{i18n>tileCustomerReturnsUnit}">
                                                <NumericContent value="{path: 'dashboardView>/customerReturnCount', formatter: '.formatMetricValue'}" icon="sap-icon://undo" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                    </HBox>
                                </Panel>
                            </VBox>
                        </VBox>


                        <!-- PROCUREMENT (MM) -->
                        <VBox id="sectionMM" visible="{= ${dashboardView>/selectedTab} === 'mm' }">
                            <VBox class="sapUiSmallMarginTop">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom" wrap="Wrap">
                                    <VBox class="sapUiTinyMarginBottom">
                                        <Title text="{i18n>tabMMHeading}" level="H3" titleStyle="H4" />
                                        <Text text="{i18n>tabMMSubheading}" class="textMuted" />
                                    </VBox>
                                    <HBox wrap="Wrap" class="sapUiTinyMarginBottom dashboardTabActions">
                                        <Button id="btnMMCreatePO" text="{i18n>dashboardModuleMMCreate}" icon="sap-icon://add" type="Emphasized" press=".onNavigateToCreatePO" class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />
                                        <Button id="btnMMManagePOs" text="{i18n>dashboardModuleMMAction}" icon="sap-icon://open-folder" type="Default" press=".onNavigateToPurchaseOrders" class="sapUiTinyMarginBottom" />
                                    </HBox>
                                </HBox>

                                <HBox wrap="Wrap" class="dashboardTileContainer sapUiTinyMarginBottom">
                                    <GenericTile id="tileMMActivePOs" header="{i18n>dashboardModuleMM}" subheader="{i18n>dashboardModuleMMSub}" press=".onNavigateToPurchaseOrders" state="{path: 'dashboardView>/totalCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="{i18n>dashboardKpiActivePOs}">
                                            <NumericContent value="{path: 'dashboardView>/totalCount', formatter: '.formatMetricValue'}" icon="sap-icon://sales-order" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileMMSuppliers" header="{i18n>dashboardKpiSuppliers}" subheader="{i18n>dashboardKpiSuppliersDesc}" press=".onNavigateToPurchaseOrders" state="{path: 'dashboardView>/supplierCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="{i18n>dashSuppliers}">
                                            <NumericContent value="{path: 'dashboardView>/supplierCount', formatter: '.formatMetricValue'}" icon="sap-icon://supplier" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- SALES (SD) -->
                        <VBox id="sectionSD" visible="{= ${dashboardView>/selectedTab} === 'sd' }">
                            <VBox class="sapUiSmallMarginTop">
                                <VBox class="sapUiTinyMarginBottom">
                                    <Title text="{i18n>tabSDHeading}" level="H3" titleStyle="H4" />
                                    <Text text="{i18n>tabSDSubheading}" class="textMuted" />
                                </VBox>

                                <HBox wrap="Wrap" class="dashboardTileContainer sapUiTinyMarginBottom">
                                    <GenericTile id="tileSDOpenOrders" header="{i18n>dashOpenSalesOrders}" subheader="{i18n>dashNotFullyProcessed}" press=".onNavigateToSalesOrders" state="{path: 'dashboardView>/openSalesOrderCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="{i18n>dashOrders}">
                                            <NumericContent value="{path: 'dashboardView>/openSalesOrderCount', formatter: '.formatMetricValue'}" icon="sap-icon://sales-order" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileSDTotalOrders" header="{i18n>dashAllSalesOrders}" subheader="{i18n>dashSalesOrderWorklist}" press=".onNavigateToSalesOrders" state="{path: 'dashboardView>/totalSalesOrderCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="{i18n>dashOrders}">
                                            <NumericContent value="{path: 'dashboardView>/totalSalesOrderCount', formatter: '.formatMetricValue'}" icon="sap-icon://sales-document" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileSDCreateOrder" header="{i18n>dashCreateSalesOrder}" subheader="{i18n>dashNewSalesOrderVA01}" press=".onNavigateToCreateSalesOrder" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="{i18n>dashAction}">
                                            <NumericContent icon="sap-icon://add" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileSDInquiries" header="{i18n>dashSalesInquiries}" subheader="{i18n>dashManageSalesInquiries}" press=".onNavigateToSalesInquiries" state="{path: 'dashboardView>/salesInquiryCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="{i18n>dashInquiries}">
                                            <NumericContent value="{path: 'dashboardView>/salesInquiryCount', formatter: '.formatMetricValue'}" icon="sap-icon://customer-and-supplier" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileSDCreateInquiry" header="{i18n>dashCreateInquiry}" subheader="{i18n>dashNewSalesInquiry}" press=".onNavigateToCreateSalesInquiry" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="{i18n>dashAction}">
                                            <NumericContent icon="sap-icon://add" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileSDCustomers" header="{i18n>dashCustomers}" subheader="{i18n>dashSalesCustomers}" state="{path: 'dashboardView>/customerCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="{i18n>dashCustomers}">
                                            <NumericContent value="{path: 'dashboardView>/customerCount', formatter: '.formatMetricValue'}" icon="sap-icon://customer" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileSDOrdersDueForDelivery" header="{i18n>tileOrdersDueForDeliveryTitle}" subheader="{i18n>tileOrdersDueForDeliverySub}" press=".onNavigateToOrdersDueForDelivery" state="{path: 'dashboardView>/ordersDueCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="{i18n>tileOrdersDueForDeliveryUnit}">
                                            <NumericContent value="{path: 'dashboardView>/ordersDueCount', formatter: '.formatMetricValue'}" icon="sap-icon://shipping-status" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileSDCustomerInvoices" header="{i18n>tileCustomerInvoicesTitle}" subheader="{i18n>tileCustomerInvoicesSub}" press=".onNavigateToCustomerInvoices" state="{path: 'dashboardView>/customerInvoiceCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="{i18n>tileCustomerInvoicesUnit}">
                                            <NumericContent value="{path: 'dashboardView>/customerInvoiceCount', formatter: '.formatMetricValue'}" icon="sap-icon://money-bills" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileSDCustomerReturns" header="{i18n>tileCustomerReturnsTitle}" subheader="{i18n>tileCustomerReturnsSub}" press=".onNavigateToCustomerReturns" state="{path: 'dashboardView>/customerReturnCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="{i18n>tileCustomerReturnsUnit}">
                                            <NumericContent value="{path: 'dashboardView>/customerReturnCount', formatter: '.formatMetricValue'}" icon="sap-icon://undo" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- WAREHOUSE (EWM / WM) -->
                        <VBox id="sectionEWM" visible="{= ${dashboardView>/selectedTab} === 'ewm' }">
                            <VBox class="sapUiSmallMarginTop">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom">
                                    <VBox>
                                        <Title text="{i18n>tabEWMHeading}" level="H3" titleStyle="H4" />
                                        <Text text="{i18n>tabEWMSubheading}" class="textMuted" />
                                    </VBox>
                                </HBox>



                                <HBox wrap="Wrap" class="dashboardTileContainer sapUiTinyMarginBottom">
                                    <GenericTile id="tileGoodsReceipt" header="{i18n>dashGoodsReceipt101}" subheader="{i18n>dashInboundDeliveries}" press=".onNavigateToGoodsReceipt" state="{path: 'dashboardView>/inboundDeliveryCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="{i18n>dashDeliveries}">
                                            <NumericContent value="{path: 'dashboardView>/inboundDeliveryCount', formatter: '.formatMetricValue'}" icon="sap-icon://inbox" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileHandlingUnits" header="{i18n>huTitle}" subheader="{i18n>huTileSub}" press=".onNavigateToHandlingUnits" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="{i18n>huTileUnit}">
                                            <NumericContent icon="sap-icon://pallet" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tilePackingInstructions" header="{i18n>piTitle}" subheader="{i18n>piTileSub}" press=".onNavigateToPackingInstructions" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="{i18n>huTileUnit}">
                                            <NumericContent icon="sap-icon://product" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileQuarantineLabels" header="{i18n>qlTitle}" subheader="{i18n>qlTileSub}" press=".onNavigateToQuarantineLabels" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="{i18n>qlTileUnit}">
                                            <NumericContent icon="sap-icon://print" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileHuStockTransfer" header="{i18n>huTransferTileTitle}" subheader="{i18n>huTransferTileSub}" press=".onNavigateToHuStockTransfer" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="{i18n>huTransferTileUnit}">
                                            <NumericContent icon="sap-icon://transfer" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- ADMINISTRATOR -->
                        <VBox id="sectionAdmin" visible="{= ${dashboardView>/selectedTab} === 'admin' }">
                            <VBox class="sapUiSmallMarginTop">
                                <VBox class="sapUiSmallMarginBottom">
                                    <Title text="{i18n>adminUserManagementTitle}" level="H3" titleStyle="H4" />
                                    <Text text="{i18n>adminUserManagementDesc}" class="textMuted" />
                                </VBox>

                                <Table
                                    id="adminUsersTable"
                                    noDataText="{adminView>/noDataText}"
                                    busy="{adminView>/busy}"
                                    items="{
                                        path: 'adminView>/users'
                                    }"
                                    growing="true"
                                    growingThreshold="20"
                                    updateFinished=".onAdminUsersUpdated">
                                    <headerToolbar>
                                        <OverflowToolbar>
                                            <Title text="{i18n>adminUsersTableTitle} ({adminView>/userCount})" level="H4" />
                                            <ToolbarSpacer />
                                            <Label text="{i18n>adminColLockStatus}" labelFor="adminLockStatusFilter" />
                                            <Select
                                                id="adminLockStatusFilter"
                                                change=".onFilterUsersByLockStatus">
                                                <items>
                                                    <core:Item key="" text="{i18n>adminFilterAll}" />
                                                    <core:Item key="active" text="{i18n>adminStatusUnlocked}" />
                                                    <core:Item key="locked" text="{i18n>adminStatusLocked}" />
                                                    <core:Item key="unavailable" text="{i18n>adminDetailsUnavailable}" />
                                                </items>
                                            </Select>
                                            <SearchField
                                                id="adminUserSearchField"
                                                width="18rem"
                                                placeholder="{i18n>adminSearchPlaceholder}"
                                                search=".onSearchUsers" />
                                            <Button
                                                id="btnRefreshUsers"
                                                icon="sap-icon://refresh"
                                                text="{i18n>commonRefresh}"
                                                type="Transparent"
                                                press=".onRefreshUsers" />
                                        </OverflowToolbar>
                                    </headerToolbar>
                                    <columns>
                                        <Column width="10rem">
                                            <header>
                                                <Link text="{i18n>adminColUsername}" press=".onSortUsers">
                                                    <customData>
                                                        <core:CustomData key="sortProperty" value="username" />
                                                    </customData>
                                                </Link>
                                            </header>
                                        </Column>
                                        <Column minScreenWidth="Tablet" demandPopin="true">
                                            <header>
                                                <Link text="{i18n>adminColFullName}" press=".onSortUsers">
                                                    <customData>
                                                        <core:CustomData key="sortProperty" value="fullName" />
                                                    </customData>
                                                </Link>
                                            </header>
                                        </Column>
                                        <Column minScreenWidth="Tablet" demandPopin="true" width="8rem">
                                            <header>
                                                <Link text="{i18n>adminColLockStatus}" press=".onSortUsers">
                                                    <customData>
                                                        <core:CustomData key="sortProperty" value="isLocked" />
                                                    </customData>
                                                </Link>
                                            </header>
                                        </Column>
                                        <Column minScreenWidth="Desktop" demandPopin="true" width="7rem">
                                            <header>
                                                <Link text="{i18n>adminColUserType}" press=".onSortUsers">
                                                    <customData>
                                                        <core:CustomData key="sortProperty" value="userType" />
                                                    </customData>
                                                </Link>
                                            </header>
                                        </Column>
                                        <Column minScreenWidth="Desktop" demandPopin="true" width="9rem">
                                            <header>
                                                <Link text="{i18n>adminColLastChanged}" press=".onSortUsers">
                                                    <customData>
                                                        <core:CustomData key="sortProperty" value="lastChanged" />
                                                    </customData>
                                                </Link>
                                            </header>
                                        </Column>
                                        <Column minScreenWidth="Desktop" demandPopin="true" width="9rem">
                                            <header>
                                                <Link text="{i18n>adminDetailLastChangedBy}" press=".onSortUsers">
                                                    <customData>
                                                        <core:CustomData key="sortProperty" value="lastChangedBy" />
                                                    </customData>
                                                </Link>
                                            </header>
                                        </Column>
                                        <Column hAlign="End" width="22rem">
                                            <Text text="{i18n>adminColActions}" />
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem type="Navigation" press=".onSelectUser">
                                            <cells>
                                                <ObjectIdentifier
                                                    title="{adminView>username}"
                                                    titleActive="true"
                                                    titlePress=".onSelectUser" />
                                                <Text text="{adminView>fullName}" />
                                                <ObjectStatus
                                                    text="{= ${adminView>detailsAvailable} ? (${adminView>isLocked} ? ${i18n>adminStatusLocked} : ${i18n>adminStatusUnlocked}) : ${i18n>adminDetailsUnavailable} }"
                                                    state="{= ${adminView>detailsAvailable} ? (${adminView>isLocked} ? 'Error' : 'Success') : 'Warning' }"
                                                    icon="{= ${adminView>detailsAvailable} ? (${adminView>isLocked} ? 'sap-icon://locked' : 'sap-icon://unlocked') : 'sap-icon://alert' }" />
                                                <Text text="{= ${adminView>userType} || '-' }" />
                                                <Text text="{path: 'adminView>lastChanged', formatter: '.formatAdminDate'}" />
                                                <Text text="{= ${adminView>lastChangedBy} || '-' }" />
                                                <HBox wrap="Wrap" justifyContent="End">
                                                    <Button
                                                        text="{i18n>adminBtnViewDetail}"
                                                        type="Transparent"
                                                        press=".onSelectUser" />
                                                    <Button
                                                        text="{i18n>adminBtnLockUser}"
                                                        type="Negative"
                                                        icon="sap-icon://locked"
                                                        visible="{= ${adminView>detailsAvailable} &amp;&amp; !${adminView>isLocked} }"
                                                        press=".onLockUser" />
                                                    <Button
                                                        text="{i18n>adminBtnUnlockUser}"
                                                        type="Emphasized"
                                                        icon="sap-icon://unlocked"
                                                        visible="{= ${adminView>detailsAvailable} &amp;&amp; ${adminView>isLocked} === true }"
                                                        press=".onUnlockUser" />
                                                </HBox>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </VBox>
                        </VBox>
                    </items>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
