<mvc:View
    controllerName="saps4hana.fiori.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <!--
        Every figure on this page is a count read live from SAP S/4HANA by getDashboardMetrics.
        A tile shows "Loading" until the count arrives and "Failed" when SAP did not return it;
        nothing is defaulted, sampled or simulated. Tiles either open a working app or show a count.
    -->
    <Page
        id="dashboardPage"
        showHeader="false"
        backgroundDesign="Solid"
        class="sapUiSizeCompact">
        <content>
            <VBox class="sapUiResponsiveMargin">
                <!-- Hero Header & Global Actions -->
                <HBox class="sapUiSmallMarginBottom dashboardHeroHeader" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
                    <VBox class="sapUiTinyMarginBottom dashboardHeroTitleContainer">
                        <HBox alignItems="Center" wrap="Wrap" class="dashboardUserGreetingRow">
                            <Title text="{i18n>dashboardWelcomePrefix}{auth>/user/username}!" level="H2" titleStyle="H3" class="sapUiTinyMarginEnd" />
                            <ObjectStatus
                                id="dashboardConnectionStatus"
                                text="{dashboardView>/connectionText}"
                                state="{dashboardView>/connectionState}"
                                inverted="false" />
                        </HBox>
                        <Text text="{i18n>dashboardSubtitle}" class="sapUiTinyMarginTop textMuted" />
                    </VBox>
                    <HBox alignItems="Center" wrap="Wrap" class="sapUiTinyMarginBottom dashboardHeroActions">
                        <Button
                            id="btnQuickCreatePO"
                            text="{i18n>dashboardModuleMMCreate}"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press=".onNavigateToCreatePO"
                            class="sapUiTinyMarginEnd" />
                        <Button
                            id="btnQuickManagePOs"
                            text="{i18n>dashboardModuleMMAction}"
                            icon="sap-icon://open-folder"
                            type="Default"
                            press=".onNavigateToPurchaseOrders"
                            class="sapUiTinyMarginEnd" />
                        <Button
                            id="btnRefreshDashboard"
                            icon="sap-icon://refresh"
                            text="{i18n>btnRefresh}"
                            type="Transparent"
                            tooltip="{i18n>btnRefresh}"
                            press=".onRefresh" />
                    </HBox>
                </HBox>

                <MessageStrip
                    id="dashboardMetricsError"
                    text="{dashboardView>/metricsError}"
                    type="Error"
                    showIcon="true"
                    visible="{= !!${dashboardView>/metricsError} }"
                    class="sapUiSmallMarginBottom" />

                <IconTabBar
                    id="dashboardTabBar"
                    selectedKey="{dashboardView>/selectedTab}"
                    select=".onTabSelect"
                    headerMode="Inline"
                    tabDensityMode="Compact"
                    expandable="false"
                    applyContentPadding="false"
                    headerBackgroundDesign="Transparent"
                    class="sapUiNoContentPadding">
                    <items>
                        <!-- OVERVIEW -->
                        <IconTabFilter
                            id="tabOverview"
                            key="overview"
                            icon="sap-icon://home"
                            text="{i18n>tabOverviewTitle}"
                            tooltip="{i18n>tabOverviewTooltip}">
                            <VBox class="sapUiSmallMarginTop">
                                <!-- Finance -->
                                <Panel
                                    id="panelCategoryFinance"
                                    headerText="{i18n>overviewCategoryFinance}"
                                    class="sapUiSmallMarginBottom"
                                    expandable="true"
                                    expanded="true">
                                    <HBox wrap="Wrap" alignItems="Center" class="dashboardTileContainer">
                                        <GenericTile
                                            id="tileModuleFI"
                                            header="{i18n>dashboardModuleFI}"
                                            subheader="{i18n>dashboardModuleFISub}"
                                            press=".onNavigateToJournalEntries"
                                            state="{path: 'dashboardView>/fiDocCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="{i18n>dashboardKpiFIDocs}">
                                                <NumericContent id="kpiFIDocsVal" value="{path: 'dashboardView>/fiDocCount', formatter: '.formatMetricValue'}" icon="sap-icon://accounting-document-verification" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            id="tileOverviewCostCenters"
                                            header="Cost Centers"
                                            subheader="Controlling Master Data"
                                            press=".onSelectTabMasterData"
                                            state="{path: 'dashboardView>/costCenterCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Cost Centers">
                                                <NumericContent value="{path: 'dashboardView>/costCenterCount', formatter: '.formatMetricValue'}" icon="sap-icon://money-bills" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            id="tileOverviewGLAccounts"
                                            header="G/L Accounts"
                                            subheader="Financial Master Data"
                                            press=".onSelectTabMasterData"
                                            state="{path: 'dashboardView>/glAccountCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Accounts">
                                                <NumericContent value="{path: 'dashboardView>/glAccountCount', formatter: '.formatMetricValue'}" icon="sap-icon://ledger" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                    </HBox>
                                </Panel>

                                <!-- Supply Chain & Sales -->
                                <Panel
                                    id="panelCategorySupplyChain"
                                    headerText="{i18n>overviewCategorySupplyChain}"
                                    class="sapUiSmallMarginBottom"
                                    expandable="true"
                                    expanded="true">
                                    <HBox wrap="Wrap" alignItems="Center" class="dashboardTileContainer">
                                        <GenericTile
                                            id="tileModuleMM"
                                            header="{i18n>dashboardModuleMM}"
                                            subheader="{i18n>dashboardModuleMMSub}"
                                            press=".onNavigateToPurchaseOrders"
                                            state="{path: 'dashboardView>/totalCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="{i18n>dashboardKpiActivePOs}">
                                                <NumericContent id="kpiTotalPOsVal" value="{path: 'dashboardView>/totalCount', formatter: '.formatMetricValue'}" icon="sap-icon://sales-order" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            id="tileModuleSuppliers"
                                            header="{i18n>dashboardKpiSuppliers}"
                                            subheader="{i18n>dashboardKpiSuppliersDesc}"
                                            press=".onNavigateToPurchaseOrders"
                                            state="{path: 'dashboardView>/supplierCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Suppliers">
                                                <NumericContent id="kpiSuppliersVal" value="{path: 'dashboardView>/supplierCount', formatter: '.formatMetricValue'}" icon="sap-icon://supplier" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            id="tileOverviewSD"
                                            header="{i18n>tabSDTitle}"
                                            subheader="Open Sales Orders"
                                            press=".onSelectTabSD"
                                            state="{path: 'dashboardView>/openSalesOrderCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Open Orders">
                                                <NumericContent value="{path: 'dashboardView>/openSalesOrderCount', formatter: '.formatMetricValue'}" icon="sap-icon://sales-order" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            id="tileOverviewEWM"
                                            header="{i18n>tabEWMTitle}"
                                            subheader="Warehouses"
                                            press=".onSelectTabEWM"
                                            state="{path: 'dashboardView>/warehouseCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Warehouses">
                                                <NumericContent value="{path: 'dashboardView>/warehouseCount', formatter: '.formatMetricValue'}" icon="sap-icon://inventory" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            id="tileOverviewGoodsIssue"
                                            header="Goods Issue (261)"
                                            subheader="Open Reservation Items"
                                            press=".onNavigateToGoodsIssue"
                                            state="{path: 'dashboardView>/openReservationCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Reservation Items">
                                                <NumericContent value="{path: 'dashboardView>/openReservationCount', formatter: '.formatMetricValue'}" icon="sap-icon://shipping-status" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            id="tileOverviewGoodsReceipt"
                                            header="Goods Receipt (101)"
                                            subheader="Inbound Deliveries"
                                            press=".onNavigateToGoodsReceipt"
                                            state="{path: 'dashboardView>/inboundDeliveryCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Deliveries">
                                                <NumericContent value="{path: 'dashboardView>/inboundDeliveryCount', formatter: '.formatMetricValue'}" icon="sap-icon://inbox" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                    </HBox>
                                </Panel>

                                <!-- Master Data -->
                                <Panel
                                    id="panelCategoryMasterData"
                                    headerText="{i18n>overviewCategoryMasterData}"
                                    class="sapUiSmallMarginBottom"
                                    expandable="true"
                                    expanded="true">
                                    <HBox wrap="Wrap" alignItems="Center" class="dashboardTileContainer">
                                        <GenericTile
                                            id="tileOverviewBupaMD"
                                            header="Business Partners"
                                            subheader="Central BP Records"
                                            press=".onSelectTabMasterData"
                                            state="{path: 'dashboardView>/bpCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Partners">
                                                <NumericContent value="{path: 'dashboardView>/bpCount', formatter: '.formatMetricValue'}" icon="sap-icon://customer-and-supplier" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            id="tileOverviewProdMD"
                                            header="Products"
                                            subheader="Material Master Records"
                                            press=".onSelectTabMasterData"
                                            state="{path: 'dashboardView>/productCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Products">
                                                <NumericContent value="{path: 'dashboardView>/productCount', formatter: '.formatMetricValue'}" icon="sap-icon://product" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>

                                        <GenericTile
                                            id="tileOverviewGateway"
                                            header="Gateway Services"
                                            subheader="SAP Gateway Catalog"
                                            state="{path: 'dashboardView>/gatewayCatalogCount', formatter: '.formatTileState'}"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Catalog Services">
                                                <NumericContent value="{path: 'dashboardView>/gatewayCatalogCount', formatter: '.formatMetricValue'}" icon="sap-icon://sys-monitor" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                    </HBox>
                                </Panel>
                            </VBox>
                        </IconTabFilter>
                        <IconTabSeparator />

                        <!-- MASTER DATA -->
                        <IconTabFilter
                            id="tabMasterData"
                            key="masterData"
                            icon="sap-icon://dimension"
                            text="{i18n>tabMasterDataTitle}"
                            tooltip="{i18n>tabMasterDataTooltip}">
                            <VBox class="sapUiSmallMarginTop">
                                <VBox class="sapUiTinyMarginBottom">
                                    <Title text="{i18n>tabMasterDataHeading}" level="H3" titleStyle="H4" />
                                    <Text text="{i18n>tabMasterDataSubheading}" class="textMuted" />
                                </VBox>

                                <Panel
                                    id="panelMdBusinessPartner"
                                    headerText="{i18n>mdAreaBusinessPartner}"
                                    class="sapUiSmallMarginBottom"
                                    expandable="true"
                                    expanded="true">
                                    <HBox wrap="Wrap" class="dashboardTileContainer sapUiTinyMarginBottom">
                                        <GenericTile header="Business Partners" subheader="Central BP Records" state="{path: 'dashboardView>/bpCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Records">
                                                <NumericContent value="{path: 'dashboardView>/bpCount', formatter: '.formatMetricValue'}" icon="sap-icon://customer-and-supplier" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                        <GenericTile header="Suppliers" subheader="Purchasing Suppliers" state="{path: 'dashboardView>/supplierCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Suppliers">
                                                <NumericContent value="{path: 'dashboardView>/supplierCount', formatter: '.formatMetricValue'}" icon="sap-icon://supplier" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                        <GenericTile header="Customers" subheader="Sales Customers" state="{path: 'dashboardView>/customerCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Customers">
                                                <NumericContent value="{path: 'dashboardView>/customerCount', formatter: '.formatMetricValue'}" icon="sap-icon://customer" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                        <GenericTile header="Purchase Contracts" subheader="Outline Agreements" state="{path: 'dashboardView>/purchaseContractCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Contracts">
                                                <NumericContent value="{path: 'dashboardView>/purchaseContractCount', formatter: '.formatMetricValue'}" icon="sap-icon://table-view" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                    </HBox>
                                </Panel>

                                <Panel
                                    id="panelMdProduct"
                                    headerText="{i18n>mdAreaProduct}"
                                    class="sapUiSmallMarginBottom"
                                    expandable="true"
                                    expanded="true">
                                    <HBox wrap="Wrap" class="dashboardTileContainer sapUiTinyMarginBottom">
                                        <GenericTile header="Products" subheader="Material Master Records" state="{path: 'dashboardView>/productCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Products">
                                                <NumericContent value="{path: 'dashboardView>/productCount', formatter: '.formatMetricValue'}" icon="sap-icon://product" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                        <GenericTile header="Material Groups" subheader="Product Groups" state="{path: 'dashboardView>/materialGroupCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Groups">
                                                <NumericContent value="{path: 'dashboardView>/materialGroupCount', formatter: '.formatMetricValue'}" icon="sap-icon://add-coursebook" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                        <GenericTile header="Purchasing Organizations" subheader="Purchasing Org Units" state="{path: 'dashboardView>/purchasingOrgCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Orgs">
                                                <NumericContent value="{path: 'dashboardView>/purchasingOrgCount', formatter: '.formatMetricValue'}" icon="sap-icon://tree" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                        <GenericTile header="Purchasing Groups" subheader="Buyer Groups" state="{path: 'dashboardView>/purchasingGroupCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Groups">
                                                <NumericContent value="{path: 'dashboardView>/purchasingGroupCount', formatter: '.formatMetricValue'}" icon="sap-icon://switch-views" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                    </HBox>
                                </Panel>

                                <Panel
                                    id="panelMdFinancial"
                                    headerText="{i18n>mdAreaFinancial}"
                                    class="sapUiSmallMarginBottom"
                                    expandable="true"
                                    expanded="true">
                                    <HBox wrap="Wrap" class="dashboardTileContainer sapUiTinyMarginBottom">
                                        <GenericTile header="G/L Accounts" subheader="Chart of Accounts" state="{path: 'dashboardView>/glAccountCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="G/L Accounts">
                                                <NumericContent value="{path: 'dashboardView>/glAccountCount', formatter: '.formatMetricValue'}" icon="sap-icon://lead" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                        <GenericTile header="Profit Centers" subheader="Profitability Units" state="{path: 'dashboardView>/profitCenterCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Centers">
                                                <NumericContent value="{path: 'dashboardView>/profitCenterCount', formatter: '.formatMetricValue'}" icon="sap-icon://money-bills" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                        <GenericTile header="Cost Centers" subheader="Cost Responsibility Units" state="{path: 'dashboardView>/costCenterCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Centers">
                                                <NumericContent value="{path: 'dashboardView>/costCenterCount', formatter: '.formatMetricValue'}" icon="sap-icon://pie-chart" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                        <GenericTile header="Internal Orders" subheader="Controlling Orders" state="{path: 'dashboardView>/internalOrderCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Orders">
                                                <NumericContent value="{path: 'dashboardView>/internalOrderCount', formatter: '.formatMetricValue'}" icon="sap-icon://official-service" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                        <GenericTile header="WBS Elements" subheader="Project Structure" state="{path: 'dashboardView>/wbsElementCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="WBS Elements">
                                                <NumericContent value="{path: 'dashboardView>/wbsElementCount', formatter: '.formatMetricValue'}" icon="sap-icon://project-definition-triangle-2" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                    </HBox>
                                </Panel>

                                <Panel
                                    id="panelMdOrganization"
                                    headerText="{i18n>mdAreaOrganization}"
                                    class="sapUiSmallMarginBottom"
                                    expandable="true"
                                    expanded="true">
                                    <HBox wrap="Wrap" class="dashboardTileContainer sapUiTinyMarginBottom">
                                        <GenericTile header="Company Codes" subheader="Legal Entities" state="{path: 'dashboardView>/companyCodeCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Company Codes">
                                                <NumericContent value="{path: 'dashboardView>/companyCodeCount', formatter: '.formatMetricValue'}" icon="sap-icon://building" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                        <GenericTile header="Plants" subheader="Operating Facilities" state="{path: 'dashboardView>/plantCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Plants">
                                                <NumericContent value="{path: 'dashboardView>/plantCount', formatter: '.formatMetricValue'}" icon="sap-icon://functional-location" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                        <GenericTile header="Storage Locations" subheader="Plant Storage Locations" state="{path: 'dashboardView>/storageLocationCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Locations">
                                                <NumericContent value="{path: 'dashboardView>/storageLocationCount', formatter: '.formatMetricValue'}" icon="sap-icon://inventory" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                        <GenericTile header="Fixed Assets" subheader="Asset Master Records" state="{path: 'dashboardView>/fixedAssetCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <TileContent unit="Assets">
                                                <NumericContent value="{path: 'dashboardView>/fixedAssetCount', formatter: '.formatMetricValue'}" icon="sap-icon://machine" valueColor="Neutral" />
                                            </TileContent>
                                        </GenericTile>
                                    </HBox>
                                </Panel>
                            </VBox>
                        </IconTabFilter>
                        <IconTabSeparator />

                        <!-- FINANCE (FI) -->
                        <IconTabFilter
                            id="tabFI"
                            key="fi"
                            icon="sap-icon://lead"
                            text="{i18n>tabFITitle}"
                            tooltip="{i18n>tabFITooltip}">
                            <VBox class="sapUiSmallMarginTop">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom" wrap="Wrap">
                                    <VBox class="sapUiTinyMarginBottom">
                                        <Title text="{i18n>tabFIHeading}" level="H3" titleStyle="H4" />
                                        <Text text="{i18n>tabFISubheading}" class="textMuted" />
                                    </VBox>
                                    <Button id="btnQuickManageFI" text="{i18n>dashboardModuleFIAction}" icon="sap-icon://accounting-document-verification" type="Emphasized" press=".onNavigateToJournalEntries" class="sapUiTinyMarginBottom" />
                                </HBox>

                                <HBox wrap="Wrap" class="dashboardTileContainer sapUiTinyMarginBottom">
                                    <GenericTile header="{i18n>dashboardModuleFI}" subheader="G/L Line Items to Be Verified" press=".onNavigateToJournalEntries" state="{path: 'dashboardView>/fiDocCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="{i18n>dashboardKpiFIDocs}">
                                            <NumericContent value="{path: 'dashboardView>/fiDocCount', formatter: '.formatMetricValue'}" icon="sap-icon://accounting-document-verification" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                </HBox>
                            </VBox>
                        </IconTabFilter>

                        <!-- PROCUREMENT (MM) -->
                        <IconTabFilter
                            id="tabMM"
                            key="mm"
                            icon="sap-icon://supplier"
                            text="{i18n>tabMMTitle}"
                            tooltip="{i18n>tabMMTooltip}">
                            <VBox class="sapUiSmallMarginTop">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom" wrap="Wrap">
                                    <VBox class="sapUiTinyMarginBottom">
                                        <Title text="{i18n>tabMMHeading}" level="H3" titleStyle="H4" />
                                        <Text text="{i18n>tabMMSubheading}" class="textMuted" />
                                    </VBox>
                                    <HBox wrap="Wrap" class="sapUiTinyMarginBottom dashboardTabActions">
                                        <Button id="btnMMCreatePO" text="{i18n>dashboardModuleMMCreate}" icon="sap-icon://add" type="Emphasized" press=".onNavigateToCreatePO" class="sapUiTinyMarginEnd sapUiTinyMarginBottom" />
                                        <Button id="btnMMManagePOs" text="{i18n>dashboardModuleMMAction}" icon="sap-icon://open-folder" type="Default" press=".onNavigateToPurchaseOrders" class="sapUiTinyMarginBottom" />
                                    </HBox>
                                </HBox>

                                <HBox wrap="Wrap" class="dashboardTileContainer sapUiTinyMarginBottom">
                                    <GenericTile id="tileMMActivePOs" header="{i18n>dashboardModuleMM}" subheader="{i18n>dashboardModuleMMSub}" press=".onNavigateToPurchaseOrders" state="{path: 'dashboardView>/totalCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="{i18n>dashboardKpiActivePOs}">
                                            <NumericContent value="{path: 'dashboardView>/totalCount', formatter: '.formatMetricValue'}" icon="sap-icon://sales-order" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileMMSuppliers" header="{i18n>dashboardKpiSuppliers}" subheader="{i18n>dashboardKpiSuppliersDesc}" press=".onNavigateToPurchaseOrders" state="{path: 'dashboardView>/supplierCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="Suppliers">
                                            <NumericContent value="{path: 'dashboardView>/supplierCount', formatter: '.formatMetricValue'}" icon="sap-icon://supplier" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                </HBox>
                            </VBox>
                        </IconTabFilter>

                        <!-- SALES (SD) -->
                        <IconTabFilter
                            id="tabSD"
                            key="sd"
                            icon="sap-icon://sales-order"
                            text="{i18n>tabSDTitle}"
                            tooltip="{i18n>tabSDTooltip}">
                            <VBox class="sapUiSmallMarginTop">
                                <VBox class="sapUiTinyMarginBottom">
                                    <Title text="{i18n>tabSDHeading}" level="H3" titleStyle="H4" />
                                    <Text text="{i18n>tabSDSubheading}" class="textMuted" />
                                </VBox>

                                <HBox wrap="Wrap" class="dashboardTileContainer sapUiTinyMarginBottom">
                                    <GenericTile id="tileSDOpenOrders" header="Open Sales Orders" subheader="Not Fully Processed" state="{path: 'dashboardView>/openSalesOrderCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="Orders">
                                            <NumericContent value="{path: 'dashboardView>/openSalesOrderCount', formatter: '.formatMetricValue'}" icon="sap-icon://sales-order" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileSDTotalOrders" header="All Sales Orders" subheader="Sales Order Worklist" state="{path: 'dashboardView>/totalSalesOrderCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="Orders">
                                            <NumericContent value="{path: 'dashboardView>/totalSalesOrderCount', formatter: '.formatMetricValue'}" icon="sap-icon://sales-document" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileSDInquiries" header="Sales Inquiries" subheader="Manage Sales Inquiries" press=".onNavigateToSalesInquiries" state="{path: 'dashboardView>/salesInquiryCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="Inquiries">
                                            <NumericContent value="{path: 'dashboardView>/salesInquiryCount', formatter: '.formatMetricValue'}" icon="sap-icon://customer-and-supplier" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileSDCreateInquiry" header="Create Inquiry" subheader="New Sales Inquiry" press=".onNavigateToCreateSalesInquiry" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="Action">
                                            <NumericContent icon="sap-icon://add" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileSDCustomers" header="Customers" subheader="Sales Customers" state="{path: 'dashboardView>/customerCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="Customers">
                                            <NumericContent value="{path: 'dashboardView>/customerCount', formatter: '.formatMetricValue'}" icon="sap-icon://customer" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                </HBox>
                            </VBox>
                        </IconTabFilter>

                        <!-- WAREHOUSE (EWM / WM) -->
                        <IconTabFilter
                            id="tabEWM"
                            key="ewm"
                            icon="sap-icon://inventory"
                            text="{i18n>tabEWMTitle}"
                            tooltip="{i18n>tabEWMTooltip}">
                            <VBox class="sapUiSmallMarginTop">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom" wrap="Wrap">
                                    <VBox class="sapUiTinyMarginBottom">
                                        <Title text="{i18n>tabEWMHeading}" level="H3" titleStyle="H4" />
                                        <Text text="{i18n>tabEWMSubheading}" class="textMuted" />
                                    </VBox>
                                    <Button
                                        id="btnOpenEwmCockpit"
                                        text="{i18n>ewmLaunchCockpitBtn}"
                                        icon="sap-icon://inventory"
                                        type="Emphasized"
                                        press=".onNavigateToEwmCockpit"
                                        class="sapUiTinyMarginBottom" />
                                </HBox>

                                <HBox wrap="Wrap" class="dashboardTileContainer sapUiTinyMarginBottom">
                                    <GenericTile id="tileEwmCockpit" header="Warehouse Cockpit" subheader="EWM Warehouses" press=".onNavigateToEwmCockpit" state="{path: 'dashboardView>/warehouseCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="Warehouses">
                                            <NumericContent value="{path: 'dashboardView>/warehouseCount', formatter: '.formatMetricValue'}" icon="sap-icon://inventory" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileGoodsIssue" header="Goods Issue (261)" subheader="Open Reservation Items" press=".onNavigateToGoodsIssue" state="{path: 'dashboardView>/openReservationCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="Reservation Items">
                                            <NumericContent value="{path: 'dashboardView>/openReservationCount', formatter: '.formatMetricValue'}" icon="sap-icon://shipping-status" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                    <GenericTile id="tileGoodsReceipt" header="Goods Receipt (101)" subheader="Inbound Deliveries" press=".onNavigateToGoodsReceipt" state="{path: 'dashboardView>/inboundDeliveryCount', formatter: '.formatTileState'}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                        <TileContent unit="Deliveries">
                                            <NumericContent value="{path: 'dashboardView>/inboundDeliveryCount', formatter: '.formatMetricValue'}" icon="sap-icon://inbox" valueColor="Neutral" />
                                        </TileContent>
                                    </GenericTile>
                                </HBox>
                            </VBox>
                        </IconTabFilter>
                    </items>
                </IconTabBar>
            </VBox>
        </content>
    </Page>
</mvc:View>
