<mvc:View
    controllerName="saps4hana.fiori.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <Page
        id="dashboardPage"
        title="{i18n>dashboardTitle}"
        showNavButton="false"
        backgroundDesign="Solid"
        class="sapUiSizeCompact">
        <headerContent>
            <ObjectStatus
                id="dashConnectionStatus"
                text="{i18n>tagLive}"
                state="Success"
                icon="sap-icon://connected" />
            <Button
                id="btnUserProfile"
                icon="sap-icon://customer"
                text="{auth>/user/username}"
                type="Transparent"
                tooltip="{i18n>userProfileTitle}"
                press=".onOpenUserProfile" />
            <Button
                id="btnRefreshDashboard"
                icon="sap-icon://refresh"
                tooltip="{i18n>btnRefresh}"
                press=".onRefresh" />
        </headerContent>
        <content>
            <VBox class="sapUiResponsiveMargin">
                <!-- Welcome Message -->
                <VBox class="sapUiSmallMarginBottom">
                    <Title text="Welcome back, {auth>/user/username}!" level="H2" titleStyle="H2" />
                </VBox>

                <!-- SECTION 1: Business Modules (Extensible Platform Catalog) -->
                <Panel
                    id="panelBusinessModules"
                    headerText="{i18n>dashboardSectionModules}"
                    class="sapUiSmallMarginBottom"
                    expandable="true"
                    expanded="true">
                    <HBox id="businessModulesContainer" wrap="Wrap" alignItems="Center">
                        <!-- Materials Management (MM) - Purchase Orders Module Tile -->
                        <GenericTile
                            id="tileModuleMM"
                            header="{i18n>dashboardModuleMM}"
                            subheader="{i18n>dashboardModuleMMSub}"
                            press=".onNavigateToPurchaseOrders"
                            class="sapUiTinyMargin">
                            <TileContent unit="{i18n>dashboardKpiActivePOs}">
                                <NumericContent
                                    id="kpiTotalPOsVal"
                                    value="{dashboardView>/totalCount}"
                                    icon="sap-icon://sales-order"
                                    valueColor="Neutral" />
                            </TileContent>
                        </GenericTile>

                        <!-- Active Suppliers Tile within MM -->
                        <GenericTile
                            id="tileModuleSuppliers"
                            header="{i18n>dashboardKpiSuppliers}"
                            subheader="{i18n>dashboardKpiSuppliersDesc}"
                            press=".onNavigateToPurchaseOrders"
                            class="sapUiTinyMargin">
                            <TileContent>
                                <NumericContent
                                    id="kpiSuppliersVal"
                                    value="{dashboardView>/supplierCount}"
                                    icon="sap-icon://supplier"
                                    valueColor="Good" />
                            </TileContent>
                        </GenericTile>

                        <!-- Module Quick Actions -->
                        <VBox class="sapUiTinyMargin sapUiContentPadding" justifyContent="Center">
                            <Button
                                id="btnQuickCreatePO"
                                text="{i18n>dashboardModuleMMCreate}"
                                icon="sap-icon://add"
                                type="Emphasized"
                                press=".onNavigateToCreatePO"
                                class="sapUiTinyMarginBottom" />
                            <Button
                                id="btnQuickManagePOs"
                                text="{i18n>dashboardModuleMMAction}"
                                icon="sap-icon://open-folder"
                                type="Transparent"
                                press=".onNavigateToPurchaseOrders" />
                        </VBox>

                        <!-- Financial Accounting (FI) - Journal Entries Module Tile -->
                        <GenericTile
                            id="tileModuleFI"
                            header="{i18n>dashboardModuleFI}"
                            subheader="{i18n>dashboardModuleFISub}"
                            press=".onNavigateToJournalEntries"
                            class="sapUiTinyMargin">
                            <TileContent unit="{i18n>dashboardKpiFIDocs}">
                                <NumericContent
                                    id="kpiFIDocsVal"
                                    value="{dashboardView>/fiDocCount}"
                                    icon="sap-icon://accounting-document-verification"
                                    valueColor="Neutral" />
                            </TileContent>
                        </GenericTile>
                    </HBox>
                </Panel>

                <!-- SECTION 2: Platform & Gateway Status -->
                <Panel
                    id="panelPlatformHealth"
                    headerText="{i18n>dashboardSectionHealth}"
                    class="sapUiSmallMarginBottom"
                    expandable="true"
                    expanded="true">
                    <HBox id="dashboardHealthContainer" wrap="Wrap">
                        <GenericTile
                            id="kpiSystemTile"
                            header="{i18n>dashboardKpiSystem}"
                            subheader="{i18n>dashboardKpiSystemDesc}"
                            class="sapUiTinyMargin">
                            <TileContent>
                                <NumericContent
                                    id="kpiSystemVal"
                                    value="100"
                                    scale="%"
                                    icon="sap-icon://database"
                                    valueColor="Good" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile
                            id="kpiSpendTile"
                            header="{i18n>dashboardKpiSpend}"
                            subheader="{i18n>dashboardKpiSpendDesc}"
                            press=".onNavigateToPurchaseOrders"
                            class="sapUiTinyMargin">
                            <TileContent>
                                <NumericContent
                                    id="kpiSpendVal"
                                    value="{dashboardView>/totalSpend}"
                                    scale="M $"
                                    icon="sap-icon://money-bills"
                                    valueColor="Critical" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile
                            id="kpiCompleteTile"
                            header="{i18n>dashboardKpiRate}"
                            subheader="{i18n>dashboardKpiRateDesc}"
                            press=".onNavigateToPurchaseOrders"
                            class="sapUiTinyMargin">
                            <TileContent>
                                <NumericContent
                                    id="kpiCompleteVal"
                                    value="{dashboardView>/completeRate}"
                                    scale="%"
                                    icon="sap-icon://accept"
                                    valueColor="Good" />
                            </TileContent>
                        </GenericTile>
                    </HBox>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
