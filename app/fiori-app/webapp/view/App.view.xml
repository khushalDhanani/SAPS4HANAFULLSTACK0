<mvc:View
    controllerName="saps4hana.fiori.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt"
    class="sapUiSizeCompact">
    <tnt:ToolPage id="appToolPage" sideExpanded="false" class="appRootContainer">
        <tnt:header>
            <core:Fragment fragmentName="saps4hana.fiori.fragment.CommonHeader" type="XML" />
        </tnt:header>
        <tnt:sideContent>
            <tnt:SideNavigation
                id="appSideNavigation"
                visible="{auth>/isAuthenticated}"
                selectedKey="{shellModel>/sideNavKey}"
                ariaLabel="{i18n>sideNavAriaLabel}"
                itemPress=".onSideNavItemPress">
                <tnt:item>
                    <tnt:NavigationList>
                        <tnt:NavigationListItem id="sideNavOverview" key="overview" icon="sap-icon://home" text="{i18n>tabOverviewTitle}" tooltip="{i18n>tabOverviewTooltip}" />
                        <tnt:NavigationListItem id="sideNavMM" key="mm" icon="sap-icon://supplier" text="{i18n>tabMMTitle}" tooltip="{i18n>tabMMTooltip}" />
                        <tnt:NavigationListItem id="sideNavSD" key="sd" icon="sap-icon://sales-order" text="{i18n>tabSDTitle}" tooltip="{i18n>tabSDTooltip}" />
                        <tnt:NavigationListItem id="sideNavEWM" key="ewm" icon="sap-icon://inventory" text="{i18n>tabEWMTitle}" tooltip="{i18n>tabEWMTooltip}" />
                        <tnt:NavigationListItem id="sideNavUserMaster" icon="sap-icon://group" text="{i18n>tabUserMasterTitle}" tooltip="{i18n>tabUserMasterTooltip}" selectable="false" visible="{path: 'auth>/user/scopes', formatter: '.isAdmin'}">
                            <tnt:items>
                                <tnt:NavigationListItem id="sideNavAdmin" key="admin" text="{i18n>tabAdminTitle}" tooltip="{i18n>tabAdminTooltip}" />
                            </tnt:items>
                        </tnt:NavigationListItem>
                    </tnt:NavigationList>
                </tnt:item>
            </tnt:SideNavigation>
        </tnt:sideContent>
        <tnt:mainContents>
            <App id="app" class="appPagesContainer" />
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
