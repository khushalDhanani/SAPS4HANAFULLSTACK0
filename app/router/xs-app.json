{
  "welcomeFile": "/saps4hanafiori/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/odata/v4/(.*)$",
      "target": "/odata/v4/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/auth/(.*)$",
      "target": "/auth/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": true
    },
    {
      "source": "^/sap/bc/lrep/(.*)$",
      "target": "/sap/bc/lrep/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}
