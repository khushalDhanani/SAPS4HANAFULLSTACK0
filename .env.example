# SAP S/4HANA Connection Configuration (Local Development only)
# Deployed environments take URL, client and credentials from BTP destinations:
#   S4_DESTINATION_NAME      HTTP destination (OData)      - required in production
#   S4_RFC_DESTINATION_NAME  RFC destination (node-rfc)    - required in production
# Locally the values below are used instead; never commit .env.local.
S4_DESTINATION_NAME=
S4_RFC_DESTINATION_NAME=
S4_SYSTEM_NAME=S4HANA_DEV
# Use the host name on SAP's certificate: an IP address fails the certificate check, even when SAP is reachable.
S4_DESTINATION_URL=https://sap-host.invalid:44300
S4_CLIENT=
S4_USERNAME=YOUR_S4_USERNAME
S4_PASSWORD=YOUR_S4_PASSWORD
# RFC (WM TR->TO screen): SAP instance number; host comes from S4_DESTINATION_URL.
# Needs the SAP NW RFC SDK installed, then: npm install node-rfc
S4_RFC_SYSNR=00
# Sandbox only: allow mismatched WM TR/reservation movements; stock stages into 921. Default false.
WM_ALLOW_MISMATCHED_TR=false

# Application Port (Default: 4004)
PORT=4004
NODE_ENV=development

# Local Development Token Issuer (Required for local dev login)
ENABLE_DEV_TOKEN_ISSUER=true
LOCAL_AUTH_SECRET=your-random-32-character-secret-key
# Password of the development users (khushal, S4_USERNAME) for the login screen and for Basic authentication.
# Without it the login screen takes S4_PASSWORD or checks SAP, and Basic authentication is refused.
# No colon in the value. The browser E2E suites read it to sign in.
LOCAL_DEV_PASSWORD=

# ---------------- AI provider selection ----------------
# sap    = SAP AI Core via SAP Cloud SDK for AI (needs AICORE_SERVICE_KEY + orchestration deployment)
# nvidia = NVIDIA NIM free API (needs NVIDIA_API_KEY)
# Required: blank or any other value turns the AI assistant off. Business data never leaves on a default.
# nvidia sends purchase order data to NVIDIA's hosted service.
AI_PROVIDER=
# SAP AI Core service key JSON on ONE line (from BTP cockpit > AI Core instance > service key).
AICORE_SERVICE_KEY={"clientid":"...","clientsecret":"...","url":"...","serviceurls":{"AI_API_URL":"..."}}
# Model served through the orchestration deployment (e.g. gpt-4o, gpt-4.1, anthropic--claude-4-sonnet, gemini-2.5-flash).
AI_SAP_MODEL=gpt-4o
# Resource group of the orchestration deployment (blank = default).
AI_SAP_RESOURCE_GROUP=
# true = pseudonymize person/email/phone/address via SAP Data Privacy Integration before the LLM sees them.
AI_SAP_MASK_PII=false

# ---------------- NVIDIA NIM free API (OpenAI-compatible) ----------------
# Key from https://build.nvidia.com (Get API Key). Required; service returns 503 without it.
NVIDIA_API_KEY=
# Endpoint. Leave as is for NVIDIA hosted NIM.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Default model options (set NVIDIA_API_KEY only in private local/BTP configuration):
#   meta/llama-3.2-11b-vision-instruct   ~2-3 s response, active and verified (recommended default)
#   nvidia/nemotron-3-ultra-550b-a55b    strong reasoning, thinking-heavy
# Avoid: nvidia/nemotron-3-super-120b-a12b (function not found/unmapped 404);
#        nvidia/nemotron-3.5-lightning-30b-a3b and z-ai/glm-5.3-flash (requests hang / time out);
#        meta/llama-3.1-* and meta/llama-3.3-70b-instruct (end of life).
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
# Request timeout in ms and retries on transient errors.
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=1
# Sampling: 0 = deterministic, 1 = creative. Keep low for business summaries.
AI_TEMPERATURE=0.2
# Max tokens for the answer (reasoning models spend part of this on thinking; keep >= 4096).
AI_MAX_TOKENS=4096
# Max characters accepted in askAI question (400 above this).
AI_MAX_QUESTION_LENGTH=8000
# Max chat turns (user+assistant messages) sent per request.
AI_MAX_HISTORY=20

# Lock monitor email. Nothing is sent unless SMTP_HOST, MAIL_FROM and LOCK_NOTIFY_TO are set.
# The monitor itself still runs without them and stores the locks it finds; LOCK_POLL_INTERVAL_SEC=0 turns it off.
# SMTP settings use env variables in every environment; in deployed systems set them with cf set-env, never in Git.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# One address, or several separated by commas.
LOCK_NOTIFY_TO=khushal@aether.co.in
# Base URL for the link to a user, up to but not including the #. The link is left out if empty.
LOCK_NOTIFY_APP_URL=
# Seconds between checks of all users' lock state. 0 turns the monitor off.
LOCK_POLL_INTERVAL_SEC=60
# Set to 1 to run the monitor under NODE_ENV=test (the local Docker cap-dev profile). Off by default.
LOCK_MONITOR_IN_TEST=
# Same opt-in for the scheduled password expiry monitor. Off by default.
PASSWORD_EXPIRY_MONITOR_IN_TEST=
# Users listed in one email; any others are counted as "and N more".
LOCK_MAX_PER_EMAIL=50

# ---------------- Docker Compose ----------------
# Select linux/amd64 or linux/arm64. The mounted SAP NW RFC SDK must match.
PLATFORM=linux/amd64
ROUTER_PORT=5000
# Protected host directory containing xsuaa.json, destination.json, hana.json.
BINDINGS_HOST_PATH=./secrets
# Optional file for the loopback-only local dev profile; never add S/4 secrets here.
LOCAL_AUTH_ENV_FILE=./.env.docker.local
# Absolute host path to the licensed SDK directory containing lib/libsapnwrfc.so.
RFC_SDK_HOST_PATH=./nwrfcsdk
# Optional CA bundle: place certs/ca-bundle.pem in the host certs directory.

# ------------------------------------------------------------------------------
# Sign-in list and failed sign-in limit (login screen, non-production)
# ------------------------------------------------------------------------------
# Users may sign in through any combination of the three sources below (priority order):
#
#  1. APP_USER_ROLES — JSON on ONE line (backward-compatible, good for <20 users):
#     APP_USER_ROLES={"JDOE":["Viewer","SalesManager"],"ASMITH":["PurchasingManager"]}
#     Roles: Admin, Viewer, PurchasingManager, SalesRepresentative, SalesManager,
#            WarehouseClerk, WarehouseManager, SapLogsReader
APP_USER_ROLES=
#
#  2. APP_USERS_FILE — path to a JSON or CSV file (hot-reloaded; mount as a Docker volume for 400+ users):
#     JSON: {"JDOE":["Viewer","SalesManager"], ...}
#     CSV:  username,roles header; then JDOE,"Viewer,SalesManager"  (see config/users.csv.example)
#     Import a CSV:  node tools/import-users.js --input users.csv --output config/app-users.json
APP_USERS_FILE=
#
#  3. cds.requires.auth.users — development-profile users in package.json (entries set to false are off)
#
# The SAP connection user (S4_USERNAME) is not an application user unless listed here.
# S4_PASSWORD is never accepted as a login password.
#
# Open to any SAP user (opt-in; unlisted users who pass SAP logon get only APP_DEFAULT_ROLES):
# APP_ALLOW_ANY_SAP_USER=false
APP_ALLOW_ANY_SAP_USER=false
# Roles granted to users not in any explicit source (only used when APP_ALLOW_ANY_SAP_USER=true).
# Comma-separated. Admin is never allowed here. Default when unset: Viewer.
# APP_DEFAULT_ROLES=Viewer
APP_DEFAULT_ROLES=
#
# Prefix for SAP PFCG activity-groups mapped to application roles (default: ZAPP_).
# SAP role ZAPP_<ROLE> (case-insensitive) grants app role <ROLE> (e.g. ZAPP_SalesManager -> SalesManager).
# APP_SAP_ROLE_PREFIX=ZAPP_
APP_SAP_ROLE_PREFIX=
#
# Allow-list of SAP logon names permitted to receive the Admin role via role mapping.
# Comma-separated. Admin is NEVER granted through SAP role mapping unless listed here.
# APP_ADMIN_USERS=MADMIN,KHUSHAL
APP_ADMIN_USERS=
# Wrong passwords allowed per user / per client address inside the window, then sign-in is refused until it passes.
# Keep the per-user value below SAP's own lock threshold (login/fails_to_user_lock, default 5).
LOGIN_MAX_FAILURES_PER_USER=3
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_SEC=900
# Number of reverse proxies in front of the app (0 = none). Set to 1 behind one TLS proxy so the limit counts the
# real client address; leave 0 when clients connect directly, or the address could be forged.
TRUST_PROXY_HOPS=0
