# SAP S/4HANA Connection Configuration (Local Development)
S4_SYSTEM_NAME=S4HANA_DEV
S4_DESTINATION_URL=https://s4hana.your-company.com:44300
S4_CLIENT=220
S4_CONNECTION_TYPE=abap_catalog
S4_USERNAME=YOUR_S4_USERNAME
S4_PASSWORD=YOUR_S4_PASSWORD

# SAP S/4HANA Environment & Org Defaults (Defaults are defined in package.json "cds.s4")
# Override any value here or via CDS_S4_<KEY> if needed:
# S4_PLANT=1120
# S4_STORAGE_LOCATION=CS01
# S4_SALES_ORGANIZATION=1000
# S4_DISTRIBUTION_CHANNEL=10
# S4_DIVISION=52
# S4_CURRENCY=INR
# S4_INQUIRY_TYPE=ZIN
# S4_ORDER_TYPE=ZDOM
# S4_CONDITION_TYPE=ZPR1
# S4_SHIPPING_POINTS=1120,1112,1108,1109
# Material types offered in the sales material value help (finished goods)
# S4_SALES_MATERIAL_TYPES=ZFRT,FERT
# WM interim storage type that Goods Issue differences are cleared to (warehouse customizing, e.g. 999).
# Required only when a difference quantity is posted; confirm the value with the WM owner.
# S4_DIFFERENCE_STORAGE_TYPE=

# Application Port (Default: 4004)
PORT=4004
NODE_ENV=development

# Local Development Token Issuer (Required for local dev login)
ENABLE_DEV_TOKEN_ISSUER=true
LOCAL_AUTH_SECRET=your-random-32-character-secret-key

# EWM Stock Unit / Handling Unit resolution (optional)
# EWM warehouse number used to scope every /SCWM/ Handling Unit query; when unset,
# the warehouse is discovered from the service value help (must be exactly one).
# EWM_WAREHOUSE_NUMBER=
# Comma-separated candidate HU services (default: scwm/SIMPLE_INB_DLV_SRV,scwm/PACK_OUTBDLV_SRV,scwm/PICKLIST_PAPER_SRV)
# SU_HU_SERVICE_PATH=

# ---------------- AI provider selection ----------------
# sap    = SAP AI Core via SAP Cloud SDK for AI (needs AICORE_SERVICE_KEY + orchestration deployment)
# nvidia = NVIDIA NIM free API (needs NVIDIA_API_KEY)
# Blank = sap when AICORE_SERVICE_KEY is set, else nvidia.
AI_PROVIDER=
# SAP AI Core service key JSON on ONE line (from BTP cockpit > AI Core instance > service key).
AICORE_SERVICE_KEY={"clientid":"...","clientsecret":"...","url":"...","serviceurls":{"AI_API_URL":"..."}}
# Model served through the orchestration deployment (e.g. gpt-4o, gpt-4.1, anthropic--claude-4-sonnet, gemini-2.5-flash).
AI_SAP_MODEL=gpt-4o
# Resource group of the orchestration deployment (blank = default).
AI_SAP_RESOURCE_GROUP=
# true = pseudonymize person/email/phone/address via SAP Data Privacy Integration before the LLM sees them.
AI_SAP_MASK_PII=false

# ---------------- NVIDIA NIM free API (OpenAI-compatible) ----------------
# Key from https://build.nvidia.com (Get API Key). Required; service returns 503 without it.
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE
# Endpoint. Leave as is for NVIDIA hosted NIM.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Default model. Verified 2026-09-22 with this key (free tier):
#   nvidia/nemotron-3-super-120b-a12b     ~2 s response (recommended default)
#   deepseek-ai/deepseek-v4.1-flash       ~8 s, strong on coding/agentic
#   nvidia/nemotron-3-ultra-550b-a55b     strongest reasoning, slower
# Avoid: nvidia/nemotron-3.5-lightning-30b-a3b and z-ai/glm-5.3-flash (requests hang / time out);
#        meta/llama-3.1-* (end of life 2026-08-26).
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Request timeout in ms and retries on transient errors.
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=1
# Sampling: 0 = deterministic, 1 = creative. Keep low for business summaries.
AI_TEMPERATURE=0.2
# Max tokens for the answer (reasoning models spend part of this on thinking; keep >= 4096).
AI_MAX_TOKENS=4096
# Max characters accepted in askAI question (400 above this).
AI_MAX_QUESTION_LENGTH=8000
# Max chat turns (user+assistant messages) sent per request.
AI_MAX_HISTORY=20
