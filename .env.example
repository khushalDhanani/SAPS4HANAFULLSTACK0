# SAP S/4HANA Connection Configuration (Local Development)
S4_SYSTEM_NAME=S4HANA_DEV
S4_DESTINATION_URL=https://s4hana.your-company.com:44300
S4_CLIENT=220
S4_CONNECTION_TYPE=abap_catalog
S4_USERNAME=YOUR_S4_USERNAME
S4_PASSWORD=YOUR_S4_PASSWORD

# Application Port (Default: 4004)
PORT=4004
NODE_ENV=development

# EWM Stock Unit / Handling Unit resolution (optional)
# EWM warehouse number used to scope every /SCWM/ Handling Unit query; when unset,
# the warehouse is discovered from the service value help (must be exactly one).
# EWM_WAREHOUSE_NUMBER=
# Comma-separated candidate HU services (default: scwm/SIMPLE_INB_DLV_SRV,scwm/PACK_OUTBDLV_SRV,scwm/PICKLIST_PAPER_SRV)
# SU_HU_SERVICE_PATH=

# Sales Quotation creation from a Sales Inquiry
# Uses the OData V4 service group UI_SALESQUOTATIONMANAGE (action CreateWithRefFromSlsInquiry,
# sticky session, SaveChanges) through the S4HANA_PO_API destination. No service pin is needed.
# Default quotation document type when the user does not choose one
S4_QUOTATION_TYPE=ZQT
# Dedicated technical SAP user for quotation creation (stateful SAP session). Must not be used at the
# same time by SAP GUI, browsers, other applications or integrations. Provisioned by Basis/Security.
# Use either a destination name, or credentials on S4_DESTINATION_URL / S4_CLIENT:
# S4_QUOTATION_DESTINATION_NAME=
# S4_QUOTATION_USERNAME=
# S4_QUOTATION_PASSWORD=
