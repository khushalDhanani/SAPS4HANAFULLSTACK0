{
  "name": "saps4hanafullstack",
  "version": "1.0.0",
  "description": "SAP S/4HANA Enterprise Full-Stack Platform",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch --exclude data",
    "test": "jest --runInBand",
    "test:unit": "jest test/unit",
    "test:integration": "jest test/integration --runInBand",
    "test:e2e": "jest test/e2e --runInBand",
    "lint": "eslint .",
    "validate:mta": "mbt validate",
    "build:mta": "mbt build"
  },
  "license": "ISC",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap-ai-sdk/orchestration": "^2.16.0",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^10.0.6",
    "@ui5/cli": "^4.0.69",
    "dotenv": "^17.4.2",
    "openai": "^7.21.0",
    "to": "^0.2.9",
    "update": "^0.7.4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3.0.2",
    "@sap/cds-dk": "^10.0.7",
    "cds-plugin-ui5": "^0.17.4",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "mbt": "^1.2.49"
  },
  "overrides": {
    "@sigstore/core": "^4.0.1"
  },
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "alice": {
              "roles": [
                "Admin",
                "Viewer",
                "PurchasingManager",
                "FinanceViewer",
                "SalesRepresentative",
                "SalesManager",
                "WarehouseClerk",
                "WarehouseManager"
              ]
            },
            "bob": {
              "roles": [
                "Viewer"
              ]
            },
            "khushal": {
              "roles": [
                "Admin",
                "Viewer",
                "PurchasingManager",
                "FinanceViewer",
                "SalesRepresentative",
                "SalesManager",
                "WarehouseClerk",
                "WarehouseManager"
              ]
            }
          }
        },
        "[test]": {
          "kind": "mocked",
          "users": {
            "alice": {
              "roles": [
                "Admin",
                "Viewer",
                "PurchasingManager",
                "FinanceViewer",
                "SalesRepresentative",
                "SalesManager",
                "WarehouseClerk",
                "WarehouseManager"
              ]
            },
            "bob": {
              "roles": [
                "Viewer"
              ]
            },
            "khushal": {
              "roles": [
                "Admin",
                "Viewer",
                "PurchasingManager",
                "FinanceViewer",
                "SalesRepresentative",
                "SalesManager",
                "WarehouseClerk",
                "WarehouseManager"
              ]
            }
          }
        },
        "[production]": {
          "kind": "jwt",
          "vcap": {
            "label": "xsuaa"
          }
        }
      },
      "C_PURCHASEORDER_FS_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/C_PURCHASEORDER_FS_SRV",
        "[production]": {
          "credentials": {
            "destination": "S4HANA_PO_API",
            "path": "/sap/opu/odata/sap/C_PURCHASEORDER_FS_SRV"
          }
        }
      },
      "MM_PUR_PO_MAINT_V2_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/MM_PUR_PO_MAINT_V2_SRV",
        "[production]": {
          "credentials": {
            "destination": "S4HANA_PO_API",
            "path": "/sap/opu/odata/sap/MM_PUR_PO_MAINT_V2_SRV"
          }
        }
      },
      "FAC_GL_JOURNALENTRY_VER_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/FAC_GL_JOURNALENTRY_VER_SRV",
        "[production]": {
          "credentials": {
            "destination": "S4HANA_PO_API",
            "path": "/sap/opu/odata/sap/FAC_GL_JOURNALENTRY_VER_SRV"
          }
        }
      },
      "SD_F2370_INQY_WL_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/SD_F2370_INQY_WL_SRV",
        "[production]": {
          "credentials": {
            "destination": "S4HANA_PO_API",
            "path": "/sap/opu/odata/sap/SD_F2370_INQY_WL_SRV"
          }
        }
      },
      "SD_F2369_INQY_FS_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/SD_F2369_INQY_FS_SRV",
        "[production]": {
          "credentials": {
            "destination": "S4HANA_PO_API",
            "path": "/sap/opu/odata/sap/SD_F2369_INQY_FS_SRV"
          }
        }
      },
      "SD_F1873_SO_WL_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/SD_F1873_SO_WL_SRV",
        "[production]": {
          "credentials": {
            "destination": "S4HANA_PO_API",
            "path": "/sap/opu/odata/sap/SD_F1873_SO_WL_SRV"
          }
        }
      }
    },
    "log": {
      "format": "plain",
      "levels": {
        "auth": "info",
        "s4-client": "info",
        "purchase-order": "info",
        "purchase-order-adapter": "info",
        "sales-inquiry": "info",
        "sales-inquiry-adapter": "info",
        "goods-receipt": "info",
        "goods-receipt-adapter": "info",
        "goods-issue-adapter": "info"
      }
    },
    "s4": {
      "client": "220",
      "plant": "1120",
      "storageLocation": "CS01",
      "salesOrganization": "1000",
      "distributionChannel": "10",
      "division": "52",
      "currency": "INR",
      "inquiryType": "ZIN",
      "orderType": "ZDOM",
      "conditionType": "ZPR1",
      "shippingPoints": [
        "1120",
        "1112",
        "1108",
        "1109"
      ],
      "salesMaterialTypes": [
        "ZFRT",
        "FERT"
      ]
    }
  }
}
