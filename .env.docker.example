# ==============================================================================
# Docker Environment Configuration Template
# Copy to .env when running via Docker or Docker Compose
# ==============================================================================

# Node Environment ('development' for standalone container with mocked auth & direct S4 connection, 'production' for BTP with XSUAA)
NODE_ENV=development

# Application HTTP Port
PORT=4004

# TLS reverse proxy (docker compose --profile tls up -d). The app itself is published on 127.0.0.1 only.
# A host name on the TLS certificate (used when a client connects by IP address); the certificate and key go in
# certs/server.crt and certs/server.key.
SERVER_NAME=
HTTPS_PORT=443

# Standalone App Router Port (when running with --profile approuter)
ROUTER_PORT=5000

# SAP S/4HANA Connection Configuration
S4_SYSTEM_NAME=S4HANA_DEV
S4_DESTINATION_URL=https://s4hana.your-company.com:44300
S4_CLIENT=220
S4_CONNECTION_TYPE=abap_catalog
S4_USERNAME=YOUR_SAP_USERNAME
S4_PASSWORD=YOUR_SAP_PASSWORD
S4_DESTINATION_NAME=S4HANA_PO_API

# EWM Stock Unit / Handling Unit resolution (optional)
# EWM_WAREHOUSE_NUMBER=
# SU_HU_SERVICE_PATH=

# ------------------------------------------------------------------------------
# Sign-in for the standalone container (NODE_ENV=development)
# ------------------------------------------------------------------------------
# The login screen needs the local token issuer. Use your own random secret of 32 characters or more.
ENABLE_DEV_TOKEN_ISSUER=true
LOCAL_AUTH_SECRET=your-random-32-character-secret-key
# Password of the development users (khushal, S4_USERNAME) for the login screen and for Basic authentication.
# Without it the login screen takes S4_PASSWORD or checks SAP, and Basic authentication is refused. No colon.
LOCAL_DEV_PASSWORD=

# ------------------------------------------------------------------------------
# Sign-in list and failed sign-in limit (login screen, non-production)
# ------------------------------------------------------------------------------
# Only these SAP users (and the development user khushal) may sign in; anyone else is refused without asking SAP.
# JSON on ONE line: SAP user name -> roles. Roles: Admin, Viewer, PurchasingManager, SalesRepresentative,
# SalesManager, WarehouseClerk, WarehouseManager, SapLogsReader. The SAP connection user (S4_USERNAME) is not
# an application user unless it is listed here. S4_PASSWORD is never accepted as a login password.
# Example: APP_USER_ROLES={"JSMITH":["Viewer","SalesManager"]}
APP_USER_ROLES=
# Wrong passwords allowed per user / per client address inside the window, then sign-in is refused until it passes.
# Keep the per-user value below SAP's own lock threshold (login/fails_to_user_lock, default 5).
LOGIN_MAX_FAILURES_PER_USER=3
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_SEC=900
# Number of reverse proxies in front of the app (0 = none). Set to 1 behind one TLS proxy so the limit counts the
# real client address; leave 0 when clients connect directly, or the address could be forged.
# docker-compose.yml defaults this to 1 (its tls proxy).
TRUST_PROXY_HOPS=1
