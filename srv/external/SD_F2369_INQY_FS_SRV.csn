 },
 "$version": "2.0",
 "definitions": {
  "SD_F2369_INQY_FS_SRV": {
   "kind": "service",
   "@cds.external": true,
   "@m.IsDefaultEntityContainer": "true",
   "@sap.message.scope.supported": "true",
   "@sap.supported.formats": "atom json xlsx pdf"
  },
  "SD_F2369_INQY_FS_SRV.C_Inquiryfs": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "@sap.creatable": "false",
   "@sap.updatable": "false",
   "@sap.deletable": "false",
   "@sap.searchable": "true",
   "@sap.content.version": "1",
   "@sap.label": "Inquiry Fact Sheet",
   "elements": {
    "SalesInquiry": {
     "key": true,
     "type": "cds.String",
     "length": 10,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Sales Inquiry",
     "notNull": true
    },
    "SalesDocumentTypeName": {
     "type": "cds.String",
     "length": 31
    },
    "SalesInquiryType": {
     "type": "cds.String",
     "length": 4,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Sales Document Type"
    },
    "SoldToParty": {
     "type": "cds.String",
     "length": 10,
     "@sap.display.format": "UpperCase",
     "@sap.text": "to_SoldToParty/CustomerName",
     "@sap.label": "Sold-to Party",
     "@sap.value.list": "standard"
    },
    "SDDocumentReason": {
     "type": "cds.String",
     "length": 3,
     "@sap.display.format": "UpperCase",
     "@sap.text": "to_SDDocumentReason/SDDocumentReason_Text",
     "@sap.label": "Order Reason",
     "@sap.quickinfo": "Order Reason (Reason for the Business Transaction)",
     "@sap.value.list": "standard"
    },
    "OverallSDProcessStatus": {
     "type": "cds.String",
     "length": 1,
     "@sap.display.format": "UpperCase",
     "@sap.text": "to_OverallSDProcessStatus/OverallSDProcessStatus_Text",
     "@sap.label": "Overall Status",
     "@sap.quickinfo": "Overall Processing Status (Header/All Items)",
     "@sap.value.list": "fixed-values"
    },
    "HdrOrderProbabilityInPercent": {
     "type": "cds.String",
     "length": 4
    },
    "OverallSDDocumentRejectionSts": {
     "type": "cds.String",
     "length": 1,
     "@sap.display.format": "UpperCase",
     "@sap.text": "to_OverallSDDocumentRejectionSts/OverallSDDocumentRejectionSts_Text",
     "@sap.label": "Rejection Status",
     "@sap.quickinfo": "Rejection Status (All Items)",
     "@sap.value.list": "fixed-values"
    },
    "TransactionCurrency": {
     "type": "cds.String",
     "length": 5,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Document Currency",
     "@sap.quickinfo": "SD Document Currency",
     "@sap.semantics": "currency-code"
    },
    "TotalNetAmount": {
     "type": "cds.Decimal",
     "precision": 16,
     "scale": 3,
     "@sap.unit": "TransactionCurrency",
     "@sap.label": "Net Value",
     "@sap.quickinfo": "Net Value of the Sales Document in Document Currency"
    },
    "SalesAreaDesc": {
     "type": "cds.String",
     "length": 64,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Sales Area"
    },
    "SalesOrganization": {
     "type": "cds.String",
     "length": 4,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Sales Organization"
    },
    "DistributionChannel": {
     "type": "cds.String",
     "length": 2,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Distribution Channel"
    },
    "OrganizationDivision": {
     "type": "cds.String",
     "length": 2,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Division"
    },
    "ResponsibleEmployee": {
     "type": "cds.String",
     "length": 8,
     "@sap.display.format": "NonNegative",
     "@sap.text": "ResponsibleEmployeeName",
     "@sap.label": "Employee Responsible"
    },
    "ResponsibleEmployeeName": {
     "type": "cds.String",
     "length": 80,
     "@sap.label": "Full Name",
     "@sap.quickinfo": "Full Name of Person",
     "@sap.sortable": "false",
     "@sap.filterable": "false"
    },
    "PurchaseOrderByCustomer": {
     "type": "cds.String",
     "length": 35,
     "@sap.label": "Customer Reference"
    },
    "CustomerPurchaseOrderDate": {
     "type": "cds.Date",
     "@sap.display.format": "Date",
     "@sap.label": "Customer Ref. Date",
     "@sap.quickinfo": "Customer Reference Date"
    },
    "BindingPeriodValidityStartDate": {
     "type": "cds.Date",
     "@sap.display.format": "Date",
     "@sap.label": "Valid From",
     "@sap.quickinfo": "Inquiry valid from date"
    },
    "BindingPeriodValidityEndDate": {
     "type": "cds.Date",
     "@sap.display.format": "Date",
     "@sap.label": "Valid To",
     "@sap.quickinfo": "Inquiry valid to date"
    },
    "to_Item": {
     "type": "cds.Association",
     "target": "SD_F2369_INQY_FS_SRV.C_Inquiryitemfs",
     "cardinality": {
      "max": "*"
     },
     "keys": []
    },
    "to_OverallSDDocumentRejectionSts": {
     "type": "cds.Association",
     "target": "SD_F2369_INQY_FS_SRV.I_OverallSDDocumentRjcnStatus",
     "keys": []
    },
    "to_OverallSDProcessStatus": {
     "type": "cds.Association",
     "target": "SD_F2369_INQY_FS_SRV.I_OverallSDProcessStatus",
     "keys": []
    },
    "to_RelatedSalesDocument": {
     "type": "cds.Association",
     "target": "SD_F2369_INQY_FS_SRV.C_InquiryRelatedDocsFFS",
     "cardinality": {
      "max": "*"
     },
     "keys": []
    },
    "to_SDDocumentPartnerCard": {
     "type": "cds.Association",
     "target": "SD_F2369_INQY_FS_SRV.C_SDDocumentPartnerCard",
     "cardinality": {
      "max": "*"
     },
     "keys": []
    },
    "to_SDDocumentReason": {
     "type": "cds.Association",
     "target": "SD_F2369_INQY_FS_SRV.I_SDDocumentReason",
     "keys": []
    },
    "to_SoldToParty": {
     "type": "cds.Association",
     "target": "SD_F2369_INQY_FS_SRV.I_Customer",
     "keys": []
    }
   }
  },
  "SD_F2369_INQY_FS_SRV.C_Inquiryitemfs": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
