   "@sap.label": "Inquiry Item Fact Sheet",
   "elements": {
    "SalesInquiry": {
     "key": true,
     "type": "cds.String",
     "length": 10,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Sales Inquiry",
     "notNull": true
    },
    "SalesInquiryItem": {
     "key": true,
     "type": "cds.String",
     "length": 6,
     "@sap.display.format": "NonNegative",
     "@sap.text": "SalesInquiryItemText",
