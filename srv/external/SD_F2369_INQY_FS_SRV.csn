     "@sap.quickinfo": "Overall Processing Status (Item)",
     "@sap.value.list": "fixed-values"
    },
    "SalesDocumentRjcnReasonName": {
     "type": "cds.String",
     "length": 63,
     "@sap.label": "Rejection Status"
    },
    "OrderQuantity": {
     "type": "cds.Decimal",
     "precision": 15,
     "scale": 3,
     "@sap.unit": "OrderQuantityUnit",
     "@sap.label": "Order Quantity",
     "@sap.quickinfo": "Cumulative order quantity in sales units"
    },
    "OrderQuantityUnit": {
     "type": "cds.String",
     "length": 3,
     "@sap.label": "Sales Unit",
     "@sap.semantics": "unit-of-measure"
    },
    "NetAmount": {
     "type": "cds.Decimal",
     "precision": 16,
     "scale": 3,
     "@sap.unit": "TransactionCurrency",
     "@sap.label": "Net Value",
     "@sap.quickinfo": "Net Value of the Document Item in Document Currency"
    },
    "TransactionCurrency": {
     "type": "cds.String",
     "length": 5,
     "@sap.display.format": "UpperCase",
     "@sap.text": "to_TransactionCurrency/Currency_Text",
     "@sap.label": "Document Currency",
     "@sap.quickinfo": "SD Document Currency",
     "@sap.value.list": "standard",
     "@sap.semantics": "currency-code"
    },
    "Material": {
     "type": "cds.String",
     "length": 40,
     "@sap.display.format": "UpperCase",
     "@sap.text": "MaterialName",
     "@sap.label": "Product",
     "@sap.quickinfo": "Product Number",
     "@sap.value.list": "standard"
    },
    "MaterialGroup": {
     "type": "cds.String",
     "length": 9,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Product Group"
    },
    "RequestedDeliveryDate": {
     "type": "cds.Date",
     "@sap.display.format": "Date",
     "@sap.label": "Requested Delivery Date"
    },
    "MaterialByCustomer": {
     "type": "cds.String",
     "length": 35,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Customer Material",
     "@sap.quickinfo": "Material Number Used by Customer"
    },
    "to_Material": {
     "type": "cds.Association",
     "target": "SD_F2369_INQY_FS_SRV.I_Material",
     "keys": []
    },
    "to_MaterialGroup": {
     "type": "cds.Association",
     "target": "SD_F2369_INQY_FS_SRV.I_MaterialGroup",
     "keys": []
    },
    "to_RelatedSalesDoc": {
     "type": "cds.Association",
     "target": "SD_F2369_INQY_FS_SRV.C_InquiryItemRelatedDocsFFS",
     "cardinality": {
      "max": "*"
     },
     "keys": []
    },
    "to_SDDocumentPartnerCard": {
     "type": "cds.Association",
     "target": "SD_F2369_INQY_FS_SRV.C_SDDocumentPartnerCard",
     "cardinality": {
      "max": "*"
     },
     "keys": []
    },
    "to_SDProcessStatus": {
     "type": "cds.Association",
     "target": "SD_F2369_INQY_FS_SRV.I_SDProcessStatus",
     "keys": []
    },
    "to_SoldToParty": {
     "type": "cds.Association",
     "target": "SD_F2369_INQY_FS_SRV.I_Customer",
     "keys": []
    },
    "to_TransactionCurrency": {
     "type": "cds.Association",
     "target": "SD_F2369_INQY_FS_SRV.I_Currency",
     "keys": []
    }
   }
