{
 "meta": {
  "creator": "cds-dk 10.1.2"
 },
 "$version": "2.0",
 "definitions": {
  "ZWM_RF_TRTO_SRV": {
   "kind": "service",
   "@cds.external": true,
   "@m.IsDefaultEntityContainer": "true"
  },
  "ZWM_RF_TRTO_SRV.TRHeaderSet": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "elements": {
    "Lgnum": {
     "key": true,
     "type": "cds.String",
     "length": 3,
     "@sap.label": "Warehouse Number",
     "notNull": true
    },
    "Tbnum": {
     "key": true,
     "type": "cds.String",
     "length": 10,
     "@sap.label": "Transfer Requirement",
     "notNull": true
    },
    "Bwlvs": {
     "type": "cds.String",
     "length": 3,
     "@sap.label": "Movement Type"
    },
    "Betyp": {
     "type": "cds.String",
     "length": 1,
     "@sap.label": "Requirement Type"
    },
    "Benum": {
     "type": "cds.String",
     "length": 10,
     "@sap.label": "Requirement Number"
    },
    "Rsnum": {
     "type": "cds.String",
     "length": 10,
     "@sap.label": "Reservation"
    },
    "Bdatu": {
     "type": "cds.DateTime",
     "@odata.Type": "Edm.DateTime",
     "@sap.label": "Requirement Date"
    },
    "Statu": {
     "type": "cds.String",
     "length": 1,
     "@sap.label": "Status"
    },
    "Vltyp": {
     "type": "cds.String",
     "length": 3,
     "@sap.label": "Source Storage Type"
    },
    "Vlpla": {
     "type": "cds.String",
     "length": 10,
     "@sap.label": "Source Storage Bin"
    },
    "Nltyp": {
     "type": "cds.String",
     "length": 3,
     "@sap.label": "Destination Storage Type"
    },
    "Nlpla": {
     "type": "cds.String",
     "length": 10,
     "@sap.label": "Destination Storage Bin"
    },
    "ToItems": {
     "type": "cds.Association",
     "target": "ZWM_RF_TRTO_SRV.TRItemSet",
     "cardinality": {
      "max": "*"
     },
     "keys": []
    }
   }
  },
  "ZWM_RF_TRTO_SRV.TRItemSet": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "elements": {
    "Lgnum": {
     "key": true,
     "type": "cds.String",
     "length": 3,
     "@sap.label": "Warehouse Number",
     "notNull": true
    },
    "Tbnum": {
     "key": true,
     "type": "cds.String",
     "length": 10,
     "@sap.label": "Transfer Requirement",
     "notNull": true
    },
    "Tbpos": {
     "key": true,
     "type": "cds.String",
     "length": 4,
     "@sap.label": "Item Number",
     "notNull": true
    },
    "Matnr": {
     "type": "cds.String",
     "length": 40,
     "@sap.label": "Material"
    },
    "Maktx": {
     "type": "cds.String",
     "length": 40,
     "@sap.label": "Material Description"
    },
    "Werks": {
     "type": "cds.String",
     "length": 4,
     "@sap.label": "Plant"
    },
    "Lgort": {
     "type": "cds.String",
     "length": 4,
     "@sap.label": "Storage Location"
    },
    "Charg": {
     "type": "cds.String",
     "length": 10,
     "@sap.label": "Batch"
    },
    "Menge": {
     "type": "cds.Decimal",
     "precision": 13,
     "scale": 3,
     "@sap.label": "Required Quantity"
    },
    "Tamen": {
     "type": "cds.Decimal",
     "precision": 13,
     "scale": 3,
     "@sap.label": "Processed Quantity"
    },
    "OpenQty": {
     "type": "cds.Decimal",
     "precision": 13,
     "scale": 3,
     "@sap.label": "Open Quantity"
    },
    "Meins": {
     "type": "cds.String",
     "length": 3,
     "@sap.label": "Unit of Measure"
    },
    "Elikz": {
     "type": "cds.String",
     "length": 1,
     "@sap.label": "Delivery Completed"
    }
   }
  },
  "ZWM_RF_TRTO_SRV.StorageUnitSet": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "elements": {
    "Lgnum": {
     "key": true,
     "type": "cds.String",
     "length": 3,
     "@sap.label": "Warehouse Number",
     "notNull": true
    },
    "Lenum": {
     "key": true,
     "type": "cds.String",
     "length": 20,
     "@sap.label": "Storage Unit Number",
     "notNull": true
    },
    "Tbnum": {
     "type": "cds.String",
     "length": 10,
     "@sap.label": "TR Context"
    },
    "Lgtyp": {
     "type": "cds.String",
     "length": 3,
     "@sap.label": "Storage Type"
    },
    "Lgpla": {
     "type": "cds.String",
     "length": 10,
     "@sap.label": "Storage Bin"
    },
    "Letyp": {
     "type": "cds.String",
     "length": 3,
     "@sap.label": "SU Type"
    },
    "Statu": {
     "type": "cds.String",
     "length": 1,
     "@sap.label": "SU Status"
    },
    "IsValid": {
     "type": "cds.Boolean",
     "@sap.label": "Is Valid"
    },
    "ErrorCode": {
     "type": "cds.String",
     "length": 20,
     "@sap.label": "Error Code"
    },
    "ErrorMessage": {
     "type": "cds.String",
     "length": 220,
     "@sap.label": "Validation Message"
    },
    "ToQuants": {
     "type": "cds.Association",
     "target": "ZWM_RF_TRTO_SRV.SUQuantSet",
     "cardinality": {
      "max": "*"
     },
     "keys": []
    }
   }
  },
  "ZWM_RF_TRTO_SRV.SUQuantSet": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "elements": {
    "Lgnum": {
     "key": true,
     "type": "cds.String",
     "length": 3,
     "@sap.label": "Warehouse Number",
     "notNull": true
    },
    "Lqnum": {
     "key": true,
     "type": "cds.String",
     "length": 10,
     "@sap.label": "Quant",
     "notNull": true
    },
    "Lenum": {
     "type": "cds.String",
     "length": 20,
     "@sap.label": "Storage Unit Number"
    },
    "Matnr": {
     "type": "cds.String",
     "length": 40,
     "@sap.label": "Material"
    },
    "Maktx": {
     "type": "cds.String",
     "length": 40,
     "@sap.label": "Material Description"
    },
    "Werks": {
     "type": "cds.String",
     "length": 4,
     "@sap.label": "Plant"
    },
    "Lgort": {
     "type": "cds.String",
     "length": 4,
     "@sap.label": "Storage Location"
    },
    "Charg": {
     "type": "cds.String",
     "length": 10,
     "@sap.label": "Batch"
    },
    "Verme": {
     "type": "cds.Decimal",
     "precision": 13,
     "scale": 3,
     "@sap.label": "Available Quantity"
    },
    "Meins": {
     "type": "cds.String",
     "length": 3,
     "@sap.label": "Unit of Measure"
    },
    "Lgtyp": {
     "type": "cds.String",
     "length": 3,
     "@sap.label": "Storage Type"
    },
    "Lgpla": {
     "type": "cds.String",
     "length": 10,
     "@sap.label": "Storage Bin"
    }
   }
  },
  "ZWM_RF_TRTO_SRV.TOConfirmation": {
   "kind": "type",
   "@cds.external": true,
   "elements": {
    "Tanum": {
     "type": "cds.String",
     "length": 10,
     "@sap.label": "Transfer Order"
    },
    "Success": {
     "type": "cds.String",
     "length": 1,
     "@sap.label": "Status"
    },
    "Message": {
     "type": "cds.String",
     "length": 220,
     "@sap.label": "Message Text"
    },
    "Confirmed": {
     "type": "cds.Boolean",
     "@sap.label": "Confirmed in 1-Step"
    }
   }
  },
  "ZWM_RF_TRTO_SRV.CreateTO": {
   "kind": "action",
   "@cds.external": true,
   "params": {
    "Lgnum": {
     "type": "cds.String",
     "length": 3
    },
    "Tbnum": {
     "type": "cds.String",
     "length": 10
    },
    "Tbpos": {
     "type": "cds.String",
     "length": 4
    },
    "Lenum": {
     "type": "cds.String",
     "length": 20
    },
    "Qty": {
     "type": "cds.Decimal",
     "precision": 13,
     "scale": 3
    },
    "Unit": {
     "type": "cds.String",
     "length": 3
    },
    "ConfirmImmediate": {
     "type": "cds.String",
     "length": 1
    }
   },
   "returns": {
    "type": "ZWM_RF_TRTO_SRV.TOConfirmation"
   }
  }
 }
}